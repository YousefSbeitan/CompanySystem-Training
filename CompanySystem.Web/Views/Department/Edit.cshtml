@{
    ViewData["Title"] = "Edit Department";
}

<div class="container-fluid">
    <h1 class="h3 mb-3">Edit Department</h1>

    <!-- Loading Spinner -->
    <div id="loadingSpinner" class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2 text-muted">Loading department data...</p>
    </div>

    <!-- Error -->
    <div id="errorAlert" class="alert alert-danger" style="display:none;"></div>
    <div id="notFoundAlert" class="alert alert-warning" style="display:none;">Department not found.</div>

    <!-- Edit Form -->
    <div class="card" id="editCard" style="display:none;">
        <div class="card-body">
            <form id="editForm" novalidate>
                <input type="hidden" id="editDepartmentId" />

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="editDepartmentName" class="form-label">
                                Department Name <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control" id="editDepartmentName" name="DepartmentName"
                                   maxlength="100" required placeholder="Enter department name" />
                            <div class="invalid-feedback">
                                Department name is required and must not exceed 100 characters.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="editManagerId" class="form-label">
                                Manager <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control" id="editManagerId" name="ManagerId"
                                   maxlength="50" required placeholder="Enter manager ID" />
                            <div class="invalid-feedback">
                                Manager ID is required and must not exceed 50 characters.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" id="btnSave">
                        <i class="bi bi-check-lg"></i> Save Changes
                    </button>
                    <a href="/Department" class="btn btn-secondary">Cancel</a>
                </div>
            </form>

            <!-- Saving Spinner (hidden) -->
            <div id="savingSpinner" class="text-center my-3" style="display:none;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Saving...</span>
                </div>
                <p class="mt-2 text-muted">Saving changes...</p>
            </div>
        </div>
    </div>

    <!-- Alert Container -->
    <div id="alertContainer" class="mt-3"></div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var permissions = window.currentUserPermissions || [];
            var userRole = window.currentUserRole || '';

            function hasPermission(perm) {
                if (permissions.length > 0) return permissions.indexOf(perm) !== -1;
                return userRole === 'Admin';
            }

            if (!hasPermission('Departments.Edit')) {
                $('#loadingSpinner').hide();
                $('#alertContainer').html(
                    '<div class="alert alert-danger">You do not have permission to edit departments.</div>'
                );
                return;
            }

            // Extract department ID from URL: /Department/Edit/{id}
            var pathParts = window.location.pathname.split('/');
            var departmentId = parseInt(pathParts[pathParts.length - 1]);

            if (!departmentId) {
                $('#loadingSpinner').hide();
                $('#errorAlert').text('Invalid department ID.').show();
                return;
            }

            // Load department data
            $.ajax({
                url: '/Department/GetById/' + departmentId,
                type: 'GET',
                success: function (dept) {
                    $('#loadingSpinner').hide();

                    if (!dept) {
                        $('#notFoundAlert').show();
                        return;
                    }

                    $('#editDepartmentId').val(dept.departmentId || dept.departmentID || '');
                    $('#editDepartmentName').val(dept.departmentName || '');
                    $('#editManagerId').val(dept.managerId || '');
                    $('#editCard').show();
                },
                error: function (xhr) {
                    $('#loadingSpinner').hide();
                    if (xhr.status === 404) {
                        $('#notFoundAlert').show();
                    } else {
                        var msg = xhr.responseText || 'Failed to load department.';
                        $('#errorAlert').text(msg).show();
                    }
                }
            });

            // Submit form
            $('#editForm').on('submit', function (e) {
                e.preventDefault();

                var form = this;
                if (!form.checkValidity()) {
                    form.classList.add('was-validated');
                    return;
                }

                var dto = {
                    departmentId: parseInt($('#editDepartmentId').val()),
                    departmentName: $('#editDepartmentName').val().trim(),
                    managerId: $('#editManagerId').val().trim()
                };

                $('#btnSave').prop('disabled', true);
                $('#savingSpinner').show();
                $('#alertContainer').empty();

                $.ajax({
                    url: '/Department/Edit',
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify(dto),
                    success: function (response) {
                        $('#savingSpinner').hide();
                        $('#alertContainer').html(
                            '<div class="alert alert-success">Department updated successfully! Redirecting...</div>'
                        );
                        setTimeout(function () {
                            window.location.href = '/Department';
                        }, 1000);
                    },
                    error: function (xhr) {
                        $('#savingSpinner').hide();
                        $('#btnSave').prop('disabled', false);

                        var msg = 'Failed to update department.';
                        if (xhr.responseJSON) {
                            if (xhr.responseJSON.title) {
                                msg = xhr.responseJSON.title;
                            } else if (xhr.responseJSON.errors) {
                                var errors = xhr.responseJSON.errors;
                                var errorList = [];
                                $.each(errors, function (key, arr) {
                                    $.each(arr, function (i, err) {
                                        errorList.push(err);
                                    });
                                });
                                msg = errorList.join('<br/>');
                            }
                        } else if (xhr.responseText) {
                            msg = xhr.responseText;
                        }

                        $('#alertContainer').html(
                            '<div class="alert alert-danger">' + msg + '</div>'
                        );
                    }
                });
            });
        });
    </script>
}
