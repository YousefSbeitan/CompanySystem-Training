@{
    Layout = "_Layout";
    ViewData["Title"] = "Edit Department";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <a href="/Department" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to Departments
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Edit Department</h4>
                </div>
                <div class="card-body">
                    <div id="loadingContainer" class="text-center py-5">
                        <div class="spinner-border text-warning" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2 text-muted">Loading department data...</p>
                    </div>

                    <form id="departmentForm" class="d-none" novalidate>
                        <input type="hidden" id="departmentId" name="departmentId" value="0" />

                        <div class="mb-3">
                            <label for="departmentName" class="form-label">Department Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="departmentName" name="departmentName"
                                   required maxlength="100"
                                   placeholder="Enter department name" />
                            <div class="invalid-feedback" id="departmentNameError">Department name is required and must not exceed 100 characters.</div>
                        </div>

                        <div class="mb-3">
                            <label for="managerId" class="form-label">Manager <span class="text-danger">*</span></label>
                            <select class="form-select" id="managerId" name="managerId" required>
                                <option value="">Loading...</option>
                            </select>
                            <div class="invalid-feedback" id="managerIdError">Manager is required and must not exceed 50 characters.</div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a href="/Department" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-warning" id="submitBtn">
                                <i class="bi bi-check-circle me-1"></i>Save Changes
                            </button>
                        </div>
                    </form>

                    <div id="errorContainer" class="d-none text-center py-5 text-danger">
                        <i class="bi bi-exclamation-triangle-fill fs-1 d-block mb-3"></i>
                        <h5>Failed to load department</h5>
                        <p id="errorMessage" class="text-muted"></p>
                        <a href="/Department" class="btn btn-outline-secondary mt-2">Back to Departments</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            var permissions = window.currentUserPermissions || [];

            function hasPerm(perm) {
                return permissions.indexOf(perm) !== -1;
            }

            if (!hasPerm('Departments.Edit')) {
                document.body.innerHTML =
                    '<div class="container-fluid py-5 text-center text-danger">' +
                    '<i class="bi bi-shield-exclamation fs-1 d-block mb-3"></i>' +
                    '<h3>Access Denied</h3>' +
                    '<p>You do not have permission to edit departments.</p>' +
                    '<a href="/Department" class="btn btn-outline-secondary mt-3">Back to Departments</a>' +
                    '</div>';
                return;
            }

            // Get department ID from URL
            var pathParts = window.location.pathname.split('/');
            var departmentId = parseInt(pathParts[pathParts.length - 1]) || 0;

            var form = document.getElementById('departmentForm');
            var submitBtn = document.getElementById('submitBtn');
            var departmentNameInput = document.getElementById('departmentName');
            var managerSelect = document.getElementById('managerId');
            var loadingContainer = document.getElementById('loadingContainer');
            var errorContainer = document.getElementById('errorContainer');
            var errorMessage = document.getElementById('errorMessage');

            var currentManagerId = '';

            // ── Load Managers (FK dropdown: /User/GetAll) ────────────
            function loadManagers() {
                managerSelect.innerHTML = '<option value="">Loading...</option>';

                $.ajax({
                    url: '/User/GetAll',
                    type: 'GET',
                    data: {
                        pageNumber: 1,
                        pageSize: 1000,
                        search: ''
                    },
                    beforeSend: function () {
                        // select shows loading option
                    },
                    success: function (response) {
                        var users = [];
                        if (response && response.data && Array.isArray(response.data)) {
                            users = response.data;
                        } else if (Array.isArray(response)) {
                            users = response;
                        } else if (response && response.items && Array.isArray(response.items)) {
                            users = response.items;
                        } else if (response && response.results && Array.isArray(response.results)) {
                            users = response.results;
                        }

                        var html = '';
                        var hasCurrent = false;
                        users.forEach(function (user) {
                            var value = escapeHtml(user.userId || '');
                            var label = escapeHtml(user.username || user.userId || '');
                            html += '<option value="' + value + '">' + label + '</option>';
                            if (user.userId === currentManagerId) {
                                hasCurrent = true;
                            }
                        });

                        // Ensure the current manager is always available as an option
                        if (currentManagerId && !hasCurrent) {
                            html += '<option value="' + escapeHtml(currentManagerId) + '">' +
                                escapeHtml(currentManagerId) + ' (current)</option>';
                        }

                        managerSelect.innerHTML = html;
                        managerSelect.value = currentManagerId || '';
                        managerSelect.classList.add('is-valid');
                    },
                    error: function () {
                        // Fallback: expose the current manager as the only option
                        managerSelect.innerHTML = '';
                        if (currentManagerId) {
                            managerSelect.innerHTML = '<option value="' + escapeHtml(currentManagerId) + '">' +
                                escapeHtml(currentManagerId) + ' (current)</option>';
                            managerSelect.value = currentManagerId;
                        } else {
                            managerSelect.innerHTML = '<option value="">— No Manager —</option>';
                        }
                        managerSelect.classList.add('is-valid');
                    },
                    complete: function () {
                        // handled
                    }
                });
            }

            // ── Real-time validation ─────────────────────────────────
            departmentNameInput.addEventListener('input', function () {
                var val = this.value.trim();
                if (val.length > 0 && val.length <= 100) {
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                } else {
                    this.classList.remove('is-valid');
                    if (val.length > 0) {
                        this.classList.add('is-invalid');
                    } else {
                        this.classList.remove('is-invalid');
                    }
                }
            });

            managerSelect.addEventListener('change', function () {
                if (this.value && this.value.length <= 50) {
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                } else {
                    this.classList.remove('is-valid');
                    this.classList.add('is-invalid');
                }
            });

            // ── Load Department Data ─────────────────────────────────
            function loadDepartment() {
                if (!departmentId || departmentId === 0) {
                    showError('Invalid department ID.');
                    return;
                }

                $.ajax({
                    url: '/Department/GetById/' + departmentId,
                    type: 'GET',
                    beforeSend: function () {
                        loadingContainer.classList.remove('d-none');
                        form.classList.add('d-none');
                        errorContainer.classList.add('d-none');
                    },
                    success: function (response) {
                        loadingContainer.classList.add('d-none');
                        form.classList.remove('d-none');

                        var department = response;
                        // If response has $id or is wrapped
                        if (response && response.data) {
                            department = response.data;
                        }

                        if (!department) {
                            showError('Department not found.');
                            return;
                        }

                        document.getElementById('departmentId').value = department.departmentId || departmentId;
                        departmentNameInput.value = department.departmentName || '';
                        departmentNameInput.classList.add('is-valid');

                        currentManagerId = department.managerId || '';
                        loadManagers();
                    },
                    error: function (xhr) {
                        loadingContainer.classList.add('d-none');
                        errorContainer.classList.remove('d-none');
                        var msg = 'Failed to load department data.';
                        try {
                            msg = JSON.parse(xhr.responseText) || msg;
                        } catch (e) {
                            msg = xhr.responseText || msg;
                        }
                        errorMessage.textContent = msg;

                        if (typeof window.showToast === 'function') {
                            window.showToast(msg, 'error');
                        }
                    },
                    complete: function () {
                        // handled
                    }
                });
            }

            function showError(msg) {
                loadingContainer.classList.add('d-none');
                errorContainer.classList.remove('d-none');
                errorMessage.textContent = msg;
            }

            // ── Form Submit ──────────────────────────────────────────
            form.addEventListener('submit', function (e) {
                e.preventDefault();

                var departmentName = departmentNameInput.value.trim();
                var managerId = managerSelect.value || '';
                var isValid = true;

                if (!departmentName || departmentName.length === 0 || departmentName.length > 100) {
                    departmentNameInput.classList.add('is-invalid');
                    isValid = false;
                } else {
                    departmentNameInput.classList.remove('is-invalid');
                    departmentNameInput.classList.add('is-valid');
                }

                if (!managerId || managerId.length === 0 || managerId.length > 50) {
                    managerSelect.classList.add('is-invalid');
                    isValid = false;
                } else {
                    managerSelect.classList.remove('is-invalid');
                    managerSelect.classList.add('is-valid');
                }

                if (!isValid) return;

                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span>Saving...';

                var dto = {
                    departmentId: departmentId,
                    departmentName: departmentName,
                    managerId: managerId
                };

                $.ajax({
                    url: '/Department/Edit',
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify(dto),
                    beforeSend: function () {
                        // button disabled
                    },
                    success: function (response) {
                        if (typeof window.showToast === 'function') {
                            window.showToast('Department updated successfully.', 'success');
                        } else {
                            alert('Department updated successfully.');
                        }
                        window.location.href = '/Department';
                    },
                    error: function (xhr) {
                        var msg = 'Failed to update department.';
                        try {
                            var resp = JSON.parse(xhr.responseText);
                            if (typeof resp === 'string') {
                                msg = resp;
                            } else if (resp && resp.title) {
                                msg = resp.title;
                            } else if (resp && resp.message) {
                                msg = resp.message;
                            } else if (resp && resp.departmentName && resp.departmentName.length > 0) {
                                msg = resp.departmentName[0];
                            } else if (resp && resp.managerId && resp.managerId.length > 0) {
                                msg = resp.managerId[0];
                            }
                        } catch (e) {
                            if (xhr.responseText) {
                                msg = xhr.responseText;
                            }
                        }

                        if (typeof window.showToast === 'function') {
                            window.showToast(msg, 'error');
                        } else {
                            alert(msg);
                        }

                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Save Changes';
                    },
                    complete: function () {
                        // handled
                    }
                });
            });

            // ── Helpers ──────────────────────────────────────────────
            function escapeHtml(str) {
                if (!str) return '';
                var div = document.createElement('div');
                div.appendChild(document.createTextNode(str));
                return div.innerHTML;
            }

            // ── Initialize ──────────────────────────────────────────
            $(document).ready(function () {
                loadDepartment();
            });

        })();
    </script>
}