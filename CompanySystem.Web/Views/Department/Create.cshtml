@{
    Layout = "_Layout";
    ViewData["Title"] = "Create Department";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <a href="/Department" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to Departments
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-building-add me-2"></i>Create New Department</h4>
                </div>
                <div class="card-body">
                    <form id="departmentForm" novalidate>
                        <div class="mb-3">
                            <label for="departmentName" class="form-label">Department Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="departmentName" name="departmentName"
                                   required maxlength="100"
                                   placeholder="Enter department name" />
                            <div class="invalid-feedback" id="departmentNameError">Department name is required and must not exceed 100 characters.</div>
                        </div>

                        <div class="mb-3">
                            <label for="managerId" class="form-label">Manager</label>
                            <select class="form-select" id="managerId" name="managerId">
                                <option value="">— No Manager —</option>
                            </select>
                            <div class="form-text">Assign a user as the department manager (optional).</div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a href="/Department" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary" id="submitBtn">
                                <i class="bi bi-check-circle me-1"></i>Create Department
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            var permissions = window.currentUserPermissions || [];

            function hasPerm(perm) {
                return permissions.indexOf(perm) !== -1;
            }

            if (!hasPerm('Departments.Create')) {
                document.body.innerHTML =
                    '<div class="container-fluid py-5 text-center text-danger">' +
                    '<i class="bi bi-shield-exclamation fs-1 d-block mb-3"></i>' +
                    '<h3>Access Denied</h3>' +
                    '<p>You do not have permission to create departments.</p>' +
                    '<a href="/Department" class="btn btn-outline-secondary mt-3">Back to Departments</a>' +
                    '</div>';
                return;
            }

            var form = document.getElementById('departmentForm');
            var submitBtn = document.getElementById('submitBtn');
            var departmentNameInput = document.getElementById('departmentName');
            var managerSelect = document.getElementById('managerId');

            // ── Load Managers (FK dropdown: /User/GetAll) ────────────
            function loadManagers() {
                managerSelect.innerHTML = '<option value="">Loading...</option>';

                $.ajax({
                    url: '/User/GetAll',
                    type: 'GET',
                    data: {
                        pageNumber: 1,
                        pageSize: 1000,
                        search: ''
                    },
                    beforeSend: function () {
                        // select shows loading option
                    },
                    success: function (response) {
                        var users = [];
                        if (response && response.data && Array.isArray(response.data)) {
                            users = response.data;
                        } else if (Array.isArray(response)) {
                            users = response;
                        } else if (response && response.items && Array.isArray(response.items)) {
                            users = response.items;
                        } else if (response && response.results && Array.isArray(response.results)) {
                            users = response.results;
                        }

                        var html = '<option value="">— No Manager —</option>';
                        users.forEach(function (user) {
                            var value = escapeHtml(user.userId || '');
                            var label = escapeHtml(user.username || user.userId || '');
                            html += '<option value="' + value + '">' + label + '</option>';
                        });

                        managerSelect.innerHTML = html;
                    },
                    error: function () {
                        // Managers are optional on create – keep empty select
                        managerSelect.innerHTML = '<option value="">— No Manager —</option>';
                    },
                    complete: function () {
                        // handled
                    }
                });
            }

            // ── Real-time validation ─────────────────────────────────
            departmentNameInput.addEventListener('input', function () {
                var val = this.value.trim();
                if (val.length > 0 && val.length <= 100) {
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                } else {
                    this.classList.remove('is-valid');
                    if (val.length > 0) {
                        this.classList.add('is-invalid');
                    } else {
                        this.classList.remove('is-invalid');
                    }
                }
            });

            // ── Form Submit ──────────────────────────────────────────
            form.addEventListener('submit', function (e) {
                e.preventDefault();

                // Validate
                var departmentName = departmentNameInput.value.trim();
                var isValid = true;

                if (!departmentName || departmentName.length === 0 || departmentName.length > 100) {
                    departmentNameInput.classList.add('is-invalid');
                    isValid = false;
                } else {
                    departmentNameInput.classList.remove('is-invalid');
                    departmentNameInput.classList.add('is-valid');
                }

                if (!isValid) return;

                // Disable button
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span>Creating...';

                var dto = {
                    departmentName: departmentName,
                    managerId: managerSelect.value || null
                };

                $.ajax({
                    url: '/Department/Create',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(dto),
                    beforeSend: function () {
                        // button already disabled
                    },
                    success: function (response) {
                        if (typeof window.showToast === 'function') {
                            window.showToast('Department created successfully.', 'success');
                        } else {
                            alert('Department created successfully.');
                        }
                        window.location.href = '/Department';
                    },
                    error: function (xhr) {
                        var msg = 'Failed to create department.';
                        try {
                            var resp = JSON.parse(xhr.responseText);
                            if (typeof resp === 'string') {
                                msg = resp;
                            } else if (resp && resp.title) {
                                msg = resp.title;
                            } else if (resp && resp.message) {
                                msg = resp.message;
                            } else if (resp && resp.departmentName && resp.departmentName.length > 0) {
                                msg = resp.departmentName[0];
                            } else if (resp && resp.managerId && resp.managerId.length > 0) {
                                msg = resp.managerId[0];
                            }
                        } catch (e) {
                            if (xhr.responseText) {
                                msg = xhr.responseText;
                            }
                        }

                        if (typeof window.showToast === 'function') {
                            window.showToast(msg, 'error');
                        } else {
                            alert(msg);
                        }

                        // Re-enable
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Create Department';
                    },
                    complete: function () {
                        // handled in error/success
                    }
                });
            });

            // ── Helpers ──────────────────────────────────────────────
            function escapeHtml(str) {
                if (!str) return '';
                var div = document.createElement('div');
                div.appendChild(document.createTextNode(str));
                return div.innerHTML;
            }

            // ── Initialize ──────────────────────────────────────────
            $(document).ready(function () {
                loadManagers();
            });

        })();
    </script>
}