@{
    ViewData["Title"] = "Create Department";
}

<div class="container">
    <h1>Create Department</h1>

    <div id="error-alert" class="alert alert-danger d-none" role="alert"></div>

    <form id="create-department-form">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label for="departmentName" class="form-label">Department Name</label>
                <input type="text" id="departmentName" name="departmentName" class="form-control" required maxlength="100" />
                <div class="invalid-feedback">Department name is required.</div>
            </div>

            <div class="col-md-6 mb-3">
                <label for="managerId" class="form-label">Manager</label>
                <select id="managerId" name="managerId" class="form-select">
                    <option value="">-- No Manager --</option>
                </select>
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Create</button>
            <a href="/Department" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            loadManagers();
        });

        function loadManagers() {
            $.getJSON('/User/GetAll')
                .done(function (users) {
                    var select = $('#managerId');
                    select.find('option:not(:first)').remove();
                    $.each(users, function (i, user) {
                        select.append('<option value="' + escapeHtml(user.userId) + '">' + escapeHtml(user.username) + '</option>');
                    });
                })
                .fail(function () {
                    showError('Failed to load managers.');
                });
        }

        function escapeHtml(str) {
            if (!str) return '';
            return $('<span>').text(str).html();
        }

        function showError(msg) {
            var alert = $('#error-alert');
            alert.removeClass('d-none').html(msg);
        }

        $('#create-department-form').submit(function (e) {
            e.preventDefault();

            var form = $(this);
            form.find('.is-invalid').removeClass('is-invalid');

            var data = {
                departmentName: $('#departmentName').val().trim(),
                managerId: $('#managerId').val() || null
            };

            if (!data.departmentName) { $('#departmentName').addClass('is-invalid'); return; }

            $('#error-alert').addClass('d-none');

            $.ajax({
                type: 'POST',
                url: '/Department/Create',
                contentType: 'application/json',
                data: JSON.stringify(data)
            })
                .done(function () {
                    window.location.href = '/Department';
                })
                .fail(function (xhr) {
                    var msg = 'An error occurred while creating the department.';
                    try {
                        var resp = JSON.parse(xhr.responseText);
                        if (resp.title) msg = resp.title;
                        else if (resp.message) msg = resp.message;
                        else if (typeof resp === 'string') msg = resp;
                        else if (resp.errors) {
                            var errs = [];
                            $.each(resp.errors, function (key, arr) { errs.push(arr.join(', ')); });
                            msg = errs.join('<br/>');
                        }
                    } catch (e) {
                        msg = xhr.responseText || msg;
                    }
                    showError(msg);
                });
        });
    </script>
}
