@{
    ViewData["Title"] = "Create Department";
}

<div class="container-fluid">
    <h1 class="h3 mb-3">Create Department</h1>

    <div class="card">
        <div class="card-body">
            <form id="createForm" novalidate>
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="createDepartmentName" class="form-label">
                                Department Name <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control" id="createDepartmentName" name="DepartmentName"
                                   maxlength="100" required placeholder="Enter department name" />
                            <div class="invalid-feedback">
                                Department name is required and must not exceed 100 characters.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="createManagerId" class="form-label">Manager</label>
                            <input type="text" class="form-control" id="createManagerId" name="ManagerId"
                                   maxlength="50" placeholder="Enter manager ID (optional)" />
                            <div class="invalid-feedback">
                                Manager ID must not exceed 50 characters.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" id="btnSave">
                        <i class="bi bi-check-lg"></i> Save
                    </button>
                    <a href="/Department" class="btn btn-secondary">Cancel</a>
                </div>
            </form>

            <!-- Loading Spinner (hidden) -->
            <div id="loadingSpinner" class="text-center my-3" style="display:none;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Saving...</span>
                </div>
                <p class="mt-2 text-muted">Saving department...</p>
            </div>
        </div>
    </div>

    <!-- Alert Container -->
    <div id="alertContainer" class="mt-3"></div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var permissions = window.currentUserPermissions || [];
            var userRole = window.currentUserRole || '';

            function hasPermission(perm) {
                if (permissions.length > 0) return permissions.indexOf(perm) !== -1;
                return userRole === 'Admin';
            }

            if (!hasPermission('Departments.Create')) {
                $('#alertContainer').html(
                    '<div class="alert alert-danger">You do not have permission to create departments.</div>'
                );
                $('#btnSave').prop('disabled', true);
                return;
            }

            $('#createForm').on('submit', function (e) {
                e.preventDefault();

                var form = this;
                if (!form.checkValidity()) {
                    form.classList.add('was-validated');
                    return;
                }

                var dto = {
                    departmentName: $('#createDepartmentName').val().trim(),
                    managerId: $('#createManagerId').val().trim() || null
                };

                $('#btnSave').prop('disabled', true);
                $('#loadingSpinner').show();
                $('#alertContainer').empty();

                $.ajax({
                    url: '/Department/Create',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(dto),
                    success: function (response) {
                        $('#loadingSpinner').hide();
                        $('#alertContainer').html(
                            '<div class="alert alert-success">Department created successfully! Redirecting...</div>'
                        );
                        setTimeout(function () {
                            window.location.href = '/Department';
                        }, 1000);
                    },
                    error: function (xhr) {
                        $('#loadingSpinner').hide();
                        $('#btnSave').prop('disabled', false);

                        var msg = 'Failed to create department.';
                        if (xhr.responseJSON) {
                            if (xhr.responseJSON.title) {
                                msg = xhr.responseJSON.title;
                            } else if (xhr.responseJSON.errors) {
                                var errors = xhr.responseJSON.errors;
                                var errorList = [];
                                $.each(errors, function (key, arr) {
                                    $.each(arr, function (i, err) {
                                        errorList.push(err);
                                    });
                                });
                                msg = errorList.join('<br/>');
                            }
                        } else if (xhr.responseText) {
                            msg = xhr.responseText;
                        }

                        $('#alertContainer').html(
                            '<div class="alert alert-danger">' + msg + '</div>'
                        );
                    }
                });
            });
        });
    </script>
}
