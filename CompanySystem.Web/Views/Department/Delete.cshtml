@{
    ViewData["Title"] = "Delete Department";
}

<div class="container-fluid">
    <h1 class="h3 mb-3">Delete Department</h1>

    <!-- Loading Spinner -->
    <div id="loadingSpinner" class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2 text-muted">Loading department data...</p>
    </div>

    <!-- Error -->
    <div id="errorAlert" class="alert alert-danger" style="display:none;"></div>
    <div id="notFoundAlert" class="alert alert-warning" style="display:none;">Department not found.</div>

    <!-- Delete Confirmation Card -->
    <div class="card border-danger" id="deleteCard" style="display:none;">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Confirm Deletion</h5>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <strong>Warning:</strong> This action cannot be undone. Are you sure you want to delete this department?
            </div>

            <dl class="row">
                <dt class="col-sm-3">Department ID</dt>
                <dd class="col-sm-9" id="deleteDepartmentId"></dd>

                <dt class="col-sm-3">Department Name</dt>
                <dd class="col-sm-9" id="deleteDepartmentName"></dd>

                <dt class="col-sm-3">Manager</dt>
                <dd class="col-sm-9" id="deleteManagerId"></dd>

                <dt class="col-sm-3">Created By</dt>
                <dd class="col-sm-9" id="deleteCreatedBy"></dd>

                <dt class="col-sm-3">Created Date</dt>
                <dd class="col-sm-9" id="deleteCreatedDate"></dd>
            </dl>

            <div class="d-flex gap-2">
                <button class="btn btn-danger" id="btnConfirmDelete">
                    <i class="bi bi-trash"></i> Delete
                </button>
                <a href="/Department" class="btn btn-secondary">Cancel</a>
            </div>
        </div>
    </div>

    <!-- Deleting Spinner -->
    <div id="deletingSpinner" class="text-center my-3" style="display:none;">
        <div class="spinner-border text-danger" role="status">
            <span class="visually-hidden">Deleting...</span>
        </div>
        <p class="mt-2 text-muted">Deleting department...</p>
    </div>

    <!-- Alert Container -->
    <div id="alertContainer" class="mt-3"></div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var isAdmin = (window.currentUserRole === 'Admin');
            if (!isAdmin) {
                $('#loadingSpinner').hide();
                $('#alertContainer').html(
                    '<div class="alert alert-danger">You do not have permission to delete departments.</div>'
                );
                return;
            }

            // Extract department ID from URL: /Department/Delete/{id}
            var pathParts = window.location.pathname.split('/');
            var departmentId = parseInt(pathParts[pathParts.length - 1]);

            if (!departmentId) {
                $('#loadingSpinner').hide();
                $('#errorAlert').text('Invalid department ID.').show();
                return;
            }

            // Load department data
            $.ajax({
                url: '/Department/GetById/' + departmentId,
                type: 'GET',
                success: function (dept) {
                    $('#loadingSpinner').hide();

                    if (!dept) {
                        $('#notFoundAlert').show();
                        return;
                    }

                    $('#deleteDepartmentId').text(dept.departmentId || dept.departmentID || '');
                    $('#deleteDepartmentName').text(dept.departmentName || '');
                    $('#deleteManagerId').text(dept.managerId || '-');
                    $('#deleteCreatedBy').text(dept.createdBy || '-');
                    $('#deleteCreatedDate').text(dept.createdDate ? new Date(dept.createdDate).toLocaleString() : '-');

                    $('#deleteCard').show();
                },
                error: function (xhr) {
                    $('#loadingSpinner').hide();
                    if (xhr.status === 404) {
                        $('#notFoundAlert').show();
                    } else {
                        var msg = xhr.responseText || 'Failed to load department.';
                        $('#errorAlert').text(msg).show();
                    }
                }
            });

            // Confirm delete
            $('#btnConfirmDelete').on('click', function () {
                var id = parseInt($('#deleteDepartmentId').text());

                if (!id) {
                    $('#alertContainer').html(
                        '<div class="alert alert-danger">Invalid department ID. Cannot delete.</div>'
                    );
                    return;
                }

                $('#btnConfirmDelete').prop('disabled', true);
                $('#deletingSpinner').show();
                $('#alertContainer').empty();

                $.ajax({
                    url: '/Department/Delete/' + id,
                    type: 'DELETE',
                    success: function (response) {
                        $('#deletingSpinner').hide();
                        var message = (response && response.message) ? response.message : 'Department deleted successfully!';
                        $('#alertContainer').html(
                            '<div class="alert alert-success">' + message + ' Redirecting...</div>'
                        );
                        setTimeout(function () {
                            window.location.href = '/Department';
                        }, 1000);
                    },
                    error: function (xhr) {
                        $('#deletingSpinner').hide();
                        $('#btnConfirmDelete').prop('disabled', false);

                        var msg = 'Failed to delete department.';
                        if (xhr.responseJSON) {
                            if (xhr.responseJSON.title) {
                                msg = xhr.responseJSON.title;
                            } else if (xhr.responseJSON.message) {
                                msg = xhr.responseJSON.message;
                            }
                        } else if (xhr.responseText) {
                            msg = xhr.responseText;
                        }

                        $('#alertContainer').html(
                            '<div class="alert alert-danger">' + msg + '</div>'
                        );
                    }
                });
            });
        });
    </script>
}
