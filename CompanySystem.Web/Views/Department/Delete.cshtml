@{
    Layout = "_Layout";
    ViewData["Title"] = "Delete Department";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <a href="/Department" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to Departments
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="bi bi-trash-fill me-2"></i>Delete Department</h4>
                </div>
                <div class="card-body">
                    <div id="loadingContainer" class="text-center py-5">
                        <div class="spinner-border text-danger" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2 text-muted">Loading department data...</p>
                    </div>

                    <div id="deleteContainer" class="d-none">
                        <div class="alert alert-warning d-flex align-items-center" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                            <div>
                                <strong>Warning:</strong> Are you sure you want to delete this department? This action cannot be undone.
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-bordered">
                                <tbody>
                                    <tr>
                                        <th class="bg-light" style="width:180px;">Department ID</th>
                                        <td id="deleteDepartmentId">—</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Department Name</th>
                                        <td id="deleteDepartmentName"><strong>—</strong></td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Manager</th>
                                        <td id="deleteManagerId">—</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Created By</th>
                                        <td id="deleteCreatedBy">—</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Created Date</th>
                                        <td id="deleteCreatedDate">—</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Updated By</th>
                                        <td id="deleteUpdatedBy">—</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Updated Date</th>
                                        <td id="deleteUpdatedDate">—</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a href="/Department" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-1"></i>Cancel
                            </a>
                            <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                                <i class="bi bi-trash-fill me-1"></i>Confirm Delete
                            </button>
                        </div>
                    </div>

                    <div id="errorContainer" class="d-none text-center py-5 text-danger">
                        <i class="bi bi-exclamation-triangle-fill fs-1 d-block mb-3"></i>
                        <h5>Failed to load department data</h5>
                        <p id="errorMessage" class="text-muted"></p>
                        <a href="/Department" class="btn btn-outline-secondary mt-2">Back to Departments</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            var permissions = window.currentUserPermissions || [];

            function hasPerm(perm) {
                return permissions.indexOf(perm) !== -1;
            }

            if (!hasPerm('Departments.Delete')) {
                document.body.innerHTML =
                    '<div class="container-fluid py-5 text-center text-danger">' +
                    '<i class="bi bi-shield-exclamation fs-1 d-block mb-3"></i>' +
                    '<h3>Access Denied</h3>' +
                    '<p>You do not have permission to delete departments.</p>' +
                    '<a href="/Department" class="btn btn-outline-secondary mt-3">Back to Departments</a>' +
                    '</div>';
                return;
            }

            // Get department ID from URL
            var pathParts = window.location.pathname.split('/');
            var departmentId = parseInt(pathParts[pathParts.length - 1]) || 0;

            var loadingContainer = document.getElementById('loadingContainer');
            var deleteContainer = document.getElementById('deleteContainer');
            var errorContainer = document.getElementById('errorContainer');
            var errorMessage = document.getElementById('errorMessage');
            var confirmBtn = document.getElementById('confirmDeleteBtn');

            // ── Load Department Data ─────────────────────────────────
            function loadDepartment() {
                if (!departmentId || departmentId === 0) {
                    showError('Invalid department ID.');
                    return;
                }

                $.ajax({
                    url: '/Department/GetById/' + departmentId,
                    type: 'GET',
                    beforeSend: function () {
                        loadingContainer.classList.remove('d-none');
                        deleteContainer.classList.add('d-none');
                        errorContainer.classList.add('d-none');
                        confirmBtn.disabled = false;
                        confirmBtn.innerHTML = '<i class="bi bi-trash-fill me-1"></i>Confirm Delete';
                    },
                    success: function (response) {
                        loadingContainer.classList.add('d-none');

                        var department = response;
                        if (response && response.data) {
                            department = response.data;
                        }

                        if (!department) {
                            showError('Department not found.');
                            return;
                        }

                        document.getElementById('deleteDepartmentId').textContent = department.departmentId || '—';
                        document.getElementById('deleteDepartmentName').textContent = department.departmentName || '—';
                        document.getElementById('deleteManagerId').textContent = department.managerId || '—';
                        document.getElementById('deleteCreatedBy').textContent = department.createdBy || '—';
                        document.getElementById('deleteCreatedDate').textContent = department.createdDate ? formatDate(department.createdDate) : '—';
                        document.getElementById('deleteUpdatedBy').textContent = department.updatedBy || '—';
                        document.getElementById('deleteUpdatedDate').textContent = department.updatedDate ? formatDate(department.updatedDate) : '—';

                        deleteContainer.classList.remove('d-none');
                    },
                    error: function (xhr) {
                        loadingContainer.classList.add('d-none');
                        errorContainer.classList.remove('d-none');
                        var msg = 'Failed to load department data.';
                        try {
                            msg = JSON.parse(xhr.responseText) || msg;
                        } catch (e) {
                            msg = xhr.responseText || msg;
                        }
                        errorMessage.textContent = msg;

                        if (typeof window.showToast === 'function') {
                            window.showToast(msg, 'error');
                        }
                    },
                    complete: function () {
                        // handled
                    }
                });
            }

            function showError(msg) {
                loadingContainer.classList.add('d-none');
                errorContainer.classList.remove('d-none');
                errorMessage.textContent = msg;
            }

            function formatDate(dateStr) {
                if (!dateStr) return '—';
                try {
                    var d = new Date(dateStr);
                    if (isNaN(d.getTime())) return dateStr;
                    return d.toLocaleDateString() + ' ' + d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                } catch (e) {
                    return dateStr;
                }
            }

            // ── Confirm Delete ───────────────────────────────────────
            confirmBtn.addEventListener('click', function () {
                if (!confirm('Are you sure you want to delete this department? This action cannot be undone.')) {
                    return;
                }

                confirmBtn.disabled = true;
                confirmBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span>Deleting...';

                $.ajax({
                    url: '/Department/Delete/' + departmentId,
                    type: 'DELETE',
                    beforeSend: function () {
                        // button disabled
                    },
                    success: function (response) {
                        var msg = 'Department deleted successfully.';
                        if (response && response.message) {
                            msg = response.message;
                        }

                        if (typeof window.showToast === 'function') {
                            window.showToast(msg, 'success');
                        } else {
                            alert(msg);
                        }
                        window.location.href = '/Department';
                    },
                    error: function (xhr) {
                        var msg = 'Failed to delete department.';
                        try {
                            var resp = JSON.parse(xhr.responseText);
                            if (typeof resp === 'string') {
                                msg = resp;
                            } else if (resp && resp.title) {
                                msg = resp.title;
                            } else if (resp && resp.message) {
                                msg = resp.message;
                            }
                        } catch (e) {
                            if (xhr.responseText) {
                                msg = xhr.responseText;
                            }
                        }

                        if (typeof window.showToast === 'function') {
                            window.showToast(msg, 'error');
                        } else {
                            alert(msg);
                        }

                        confirmBtn.disabled = false;
                        confirmBtn.innerHTML = '<i class="bi bi-trash-fill me-1"></i>Confirm Delete';
                    },
                    complete: function () {
                        // handled
                    }
                });
            });

            // ── Initialize ──────────────────────────────────────────
            $(document).ready(function () {
                loadDepartment();
            });

        })();
    </script>
}