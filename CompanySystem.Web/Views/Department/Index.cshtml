@{
    ViewData["Title"] = "Departments";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">Departments</h1>
        <a href="/Department/Create" class="btn btn-primary">+ Create Department</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Department ID</th>
                    <th>Department Name</th>
                    <th>Manager</th>
                    <th>Created By</th>
                    <th>Created Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="department-table-body">
                <tr>
                    <td colspan="6" class="text-center text-muted">Loading...</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            loadDepartments();
        });

        function loadDepartments() {
            $.getJSON('/Department/GetAll')
                .done(function (departments) {
                    var tbody = $('#department-table-body');
                    tbody.empty();

                    if (!departments || departments.length === 0) {
                        tbody.append('<tr><td colspan="6" class="text-center text-muted">No departments found.</td></tr>');
                        return;
                    }

                    $.each(departments, function (i, dept) {
                        var row = '<tr>' +
                            '<td>' + dept.departmentId + '</td>' +
                            '<td>' + escapeHtml(dept.departmentName) + '</td>' +
                            '<td>' + (dept.managerId ? escapeHtml(dept.managerId) : '<span class="text-muted">-</span>') + '</td>' +
                            '<td>' + escapeHtml(dept.createdBy) + '</td>' +
                            '<td>' + formatDate(dept.createdDate) + '</td>' +
                            '<td>' +
                            '<a href="/Department/Details/' + dept.departmentId + '" class="btn btn-sm btn-info me-1" title="Details">&#128065;</a>' +
                            '<a href="/Department/Edit/' + dept.departmentId + '" class="btn btn-sm btn-warning me-1" title="Edit">&#9999;&#65039;</a>' +
                            '<a href="/Department/Delete/' + dept.departmentId + '" class="btn btn-sm btn-danger" title="Delete">&#128465;</a>' +
                            '</td>' +
                            '</tr>';
                        tbody.append(row);
                    });
                })
                .fail(function (xhr) {
                    $('#department-table-body').html('<tr><td colspan="6" class="text-center text-danger">Error loading departments: ' + (xhr.responseJSON || xhr.responseText || 'Unknown error') + '</td></tr>');
                });
        }

        function escapeHtml(str) {
            if (!str) return '';
            return $('<span>').text(str).html();
        }

        function formatDate(dateStr) {
            if (!dateStr) return '-';
            var d = new Date(dateStr);
            if (isNaN(d.getTime())) return dateStr;
            return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
        }
    </script>
}
