@{
    ViewData["Title"] = "Note Details";
}

<div class="container-fluid">
    <h1 class="h3 mb-3">Note Details</h1>

    <!-- Loading Spinner -->
    <div id="loadingSpinner" class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2 text-muted">Loading note details...</p>
    </div>

    <!-- Error -->
    <div id="errorAlert" class="alert alert-danger" style="display:none;"></div>

    <!-- Detail Card -->
    <div id="detailCard" class="card" style="display:none;">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-bold">Note Information</span>
            <span class="badge bg-secondary" id="detailNoteIdBadge"></span>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Note ID</dt>
                <dd class="col-sm-9" id="detailNoteId"></dd>

                <dt class="col-sm-3">User</dt>
                <dd class="col-sm-9" id="detailUserId"></dd>

                <dt class="col-sm-3">Note Type</dt>
                <dd class="col-sm-9" id="detailNoteType"></dd>

                <dt class="col-sm-3">Title</dt>
                <dd class="col-sm-9" id="detailTitle"></dd>

                <dt class="col-sm-3">Content</dt>
                <dd class="col-sm-9" id="detailContent" style="white-space: pre-wrap;"></dd>

                <dt class="col-sm-3">Created By</dt>
                <dd class="col-sm-9" id="detailCreatedBy"></dd>

                <dt class="col-sm-3">Created Date</dt>
                <dd class="col-sm-9" id="detailCreatedDate"></dd>

                <dt class="col-sm-3">Updated By</dt>
                <dd class="col-sm-9" id="detailUpdatedBy"></dd>

                <dt class="col-sm-3">Updated Date</dt>
                <dd class="col-sm-9" id="detailUpdatedDate"></dd>
            </dl>
        </div>
        <div class="card-footer">
            <a href="/Note" class="btn btn-secondary">Back to List</a>
            <button class="btn btn-warning manager-admin-only" id="btnEditFromDetails" style="display:none;">
                <i class="bi bi-pencil"></i> Edit
            </button>
        </div>
    </div>

    <!-- Not Found -->
    <div id="notFoundAlert" class="alert alert-warning" style="display:none;">
        Note not found.
    </div>

    <!-- Permission Denied -->
    <div id="permissionDeniedAlert" class="alert alert-danger" style="display:none;">
        You do not have permission to view note details.
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var currentUserRole = window.currentUserRole || '';
            var isAdmin = (currentUserRole === 'Admin');
            var isManager = (currentUserRole === 'Manager');

            if (isAdmin || isManager) {
                $('.manager-admin-only').show();
            }

            // Extract note ID from URL: /Note/Details/{id}
            var pathParts = window.location.pathname.split('/');
            var noteId = parseInt(pathParts[pathParts.length - 1]);

            if (!noteId) {
                $('#loadingSpinner').hide();
                $('#errorAlert').text('Invalid note ID.').show();
                return;
            }

            $.ajax({
                url: '/Note/GetById/' + noteId,
                type: 'GET',
                success: function (note) {
                    $('#loadingSpinner').hide();

                    if (!note) {
                        $('#notFoundAlert').show();
                        return;
                    }

                    var noteType = note.noteType === 1 ? 'Technical' : (note.noteType === 2 ? 'Behavioral' : note.noteType || '-');

                    $('#detailNoteIdBadge').text('#' + (note.noteId || ''));
                    $('#detailNoteId').text(note.noteId || '');
                    $('#detailUserId').text(note.userId || '-');
                    $('#detailNoteType').text(noteType);
                    $('#detailTitle').text(note.title || '');
                    $('#detailContent').text(note.content || '');
                    $('#detailCreatedBy').text(note.createdBy || '-');
                    $('#detailCreatedDate').text(note.createdDate ? new Date(note.createdDate).toLocaleString() : '-');
                    $('#detailUpdatedBy').text(note.updatedBy || '-');
                    $('#detailUpdatedDate').text(note.updatedDate ? new Date(note.updatedDate).toLocaleString() : '-');

                    if (isAdmin || isManager) {
                        $('#btnEditFromDetails').data('id', note.noteId).show();
                    }

                    $('#detailCard').show();
                },
                error: function (xhr) {
                    $('#loadingSpinner').hide();
                    if (xhr.status === 404) {
                        $('#notFoundAlert').show();
                    } else if (xhr.status === 403) {
                        $('#permissionDeniedAlert').show();
                    } else {
                        var msg = xhr.responseText || 'An error occurred while loading note details.';
                        $('#errorAlert').text(msg).show();
                    }
                }
            });

            // Edit button on details page
            $(document).on('click', '#btnEditFromDetails', function () {
                var id = $(this).data('id');
                window.location.href = '/Note/Edit/' + id;
            });
        });
    </script>
}
