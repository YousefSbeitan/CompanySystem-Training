@{
    ViewData["Title"] = "Delete Note";
}

<div class="container-fluid">
    <h1 class="h3 mb-3">Delete Note</h1>

    <!-- Loading Spinner -->
    <div id="loadingSpinner" class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2 text-muted">Loading note data...</p>
    </div>

    <!-- Error -->
    <div id="errorAlert" class="alert alert-danger" style="display:none;"></div>
    <div id="notFoundAlert" class="alert alert-warning" style="display:none;">Note not found.</div>
    <div id="permissionDenied" class="alert alert-danger" style="display:none;">
        You do not have permission to delete notes.
    </div>

    <!-- Delete Confirmation Card -->
    <div class="card border-danger" id="deleteCard" style="display:none;">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Confirm Deletion</h5>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <strong>Warning:</strong> This action cannot be undone. Are you sure you want to delete this note?
            </div>

            <dl class="row">
                <dt class="col-sm-3">Note ID</dt>
                <dd class="col-sm-9" id="deleteNoteId"></dd>

                <dt class="col-sm-3">User</dt>
                <dd class="col-sm-9" id="deleteUserId"></dd>

                <dt class="col-sm-3">Note Type</dt>
                <dd class="col-sm-9" id="deleteNoteType"></dd>

                <dt class="col-sm-3">Title</dt>
                <dd class="col-sm-9" id="deleteTitle"></dd>

                <dt class="col-sm-3">Created By</dt>
                <dd class="col-sm-9" id="deleteCreatedBy"></dd>

                <dt class="col-sm-3">Created Date</dt>
                <dd class="col-sm-9" id="deleteCreatedDate"></dd>
            </dl>

            <div class="d-flex gap-2">
                <button class="btn btn-danger" id="btnConfirmDelete">
                    <i class="bi bi-trash"></i> Delete
                </button>
                <a href="/Note" class="btn btn-secondary">Cancel</a>
            </div>
        </div>
    </div>

    <!-- Deleting Spinner -->
    <div id="deletingSpinner" class="text-center my-3" style="display:none;">
        <div class="spinner-border text-danger" role="status">
            <span class="visually-hidden">Deleting...</span>
        </div>
        <p class="mt-2 text-muted">Deleting note...</p>
    </div>

    <!-- Alert Container -->
    <div id="alertContainer" class="mt-3"></div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var currentUserRole = window.currentUserRole || '';
            var isAdmin = (currentUserRole === 'Admin');

            // Check permission - only Admin can delete
            if (!isAdmin) {
                $('#loadingSpinner').hide();
                $('#alertContainer').html(
                    '<div class="alert alert-danger">You do not have permission to delete notes.</div>'
                );
                return;
            }

            // Extract note ID from URL: /Note/Delete/{id}
            var pathParts = window.location.pathname.split('/');
            var noteId = parseInt(pathParts[pathParts.length - 1]);

            if (!noteId) {
                $('#loadingSpinner').hide();
                $('#errorAlert').text('Invalid note ID.').show();
                return;
            }

            // Load note data
            $.ajax({
                url: '/Note/GetById/' + noteId,
                type: 'GET',
                success: function (note) {
                    $('#loadingSpinner').hide();

                    if (!note) {
                        $('#notFoundAlert').show();
                        return;
                    }

                    var noteType = note.noteType === 1 ? 'Technical' : (note.noteType === 2 ? 'Behavioral' : note.noteType || '-');

                    $('#deleteNoteId').text(note.noteId || '');
                    $('#deleteUserId').text(note.userId || '-');
                    $('#deleteNoteType').text(noteType);
                    $('#deleteTitle').text(note.title || '');
                    $('#deleteCreatedBy').text(note.createdBy || '-');
                    $('#deleteCreatedDate').text(note.createdDate ? new Date(note.createdDate).toLocaleString() : '-');

                    $('#deleteCard').show();
                },
                error: function (xhr) {
                    $('#loadingSpinner').hide();
                    if (xhr.status === 404) {
                        $('#notFoundAlert').show();
                    } else if (xhr.status === 403) {
                        $('#permissionDenied').show();
                    } else {
                        var msg = xhr.responseText || 'Failed to load note.';
                        $('#errorAlert').text(msg).show();
                    }
                }
            });

            // Confirm delete
            $('#btnConfirmDelete').on('click', function () {
                var id = parseInt($('#deleteNoteId').text());

                if (!id) {
                    $('#alertContainer').html(
                        '<div class="alert alert-danger">Invalid note ID. Cannot delete.</div>'
                    );
                    return;
                }

                $('#btnConfirmDelete').prop('disabled', true);
                $('#deletingSpinner').show();
                $('#alertContainer').empty();

                $.ajax({
                    url: '/Note/Delete/' + id,
                    type: 'DELETE',
                    success: function (response) {
                        $('#deletingSpinner').hide();
                        var message = (response && response.message) ? response.message : 'Note deleted successfully!';
                        $('#alertContainer').html(
                            '<div class="alert alert-success">' + message + ' Redirecting...</div>'
                        );
                        setTimeout(function () {
                            window.location.href = '/Note';
                        }, 1000);
                    },
                    error: function (xhr) {
                        $('#deletingSpinner').hide();
                        $('#btnConfirmDelete').prop('disabled', false);

                        var msg = 'Failed to delete note.';
                        if (xhr.responseJSON) {
                            if (xhr.responseJSON.title) {
                                msg = xhr.responseJSON.title;
                            } else if (xhr.responseJSON.message) {
                                msg = xhr.responseJSON.message;
                            }
                        } else if (xhr.responseText) {
                            msg = xhr.responseText;
                        }

                        $('#alertContainer').html(
                            '<div class="alert alert-danger">' + msg + '</div>'
                        );
                    }
                });
            });
        });
    </script>
}
