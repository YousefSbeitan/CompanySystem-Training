@{
    Layout = "_Layout";
    ViewData["Title"] = "Delete Note";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <a href="/Note" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to Notes
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="bi bi-trash-fill me-2"></i>Delete Note</h4>
                </div>
                <div class="card-body">
                    <div id="loadingContainer" class="text-center py-5">
                        <div class="spinner-border text-danger" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2 text-muted">Loading note data...</p>
                    </div>

                    <div id="deleteContainer" class="d-none">
                        <div class="alert alert-warning d-flex align-items-center" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                            <div>
                                <strong>Warning:</strong> Are you sure you want to delete this note? This action cannot be undone.
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-bordered">
                                <tbody>
                                    <tr>
                                        <th class="bg-light" style="width:180px;">Note ID</th>
                                        <td id="deleteNoteId">—</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">User</th>
                                        <td id="deleteUser">—</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Note Type</th>
                                        <td id="deleteNoteType">—</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Title</th>
                                        <td id="deleteTitle"><strong>—</strong></td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Content</th>
                                        <td id="deleteContent" class="text-break">—</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a href="/Note" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-1"></i>Cancel
                            </a>
                            <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                                <i class="bi bi-trash-fill me-1"></i>Confirm Delete
                            </button>
                        </div>
                    </div>

                    <div id="errorContainer" class="d-none text-center py-5 text-danger">
                        <i class="bi bi-exclamation-triangle-fill fs-1 d-block mb-3"></i>
                        <h5>Failed to load note data</h5>
                        <p id="errorMessage" class="text-muted"></p>
                        <a href="/Note" class="btn btn-outline-secondary mt-2">Back to Notes</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            var permissions = window.currentUserPermissions || [];

            function hasPerm(perm) {
                return permissions.indexOf(perm) !== -1;
            }

            if (!hasPerm('Notes.Delete')) {
                document.body.innerHTML =
                    '<div class="container-fluid py-5 text-center text-danger">' +
                    '<i class="bi bi-shield-exclamation fs-1 d-block mb-3"></i>' +
                    '<h3>Access Denied</h3>' +
                    '<p>You do not have permission to delete notes.</p>' +
                    '<a href="/Note" class="btn btn-outline-secondary mt-3">Back to Notes</a>' +
                    '</div>';
                return;
            }

            function getUrlId() {
                var pathParts = window.location.pathname.split('/');
                var raw = decodeURIComponent(pathParts[pathParts.length - 1] || '');
                var id = parseInt(raw, 10);
                return isNaN(id) ? '' : id;
            }

            var noteId = getUrlId();

            var loadingContainer = document.getElementById('loadingContainer');
            var deleteContainer = document.getElementById('deleteContainer');
            var errorContainer = document.getElementById('errorContainer');
            var errorMessage = document.getElementById('errorMessage');
            var confirmBtn = document.getElementById('confirmDeleteBtn');

            // ── FK Lookup Map (User) ─────────────────────────────────
            var userMap = {};

            function loadLookups(callback) {
                var pending = 1;

                function checkDone() {
                    pending--;
                    if (pending <= 0 && typeof callback === 'function') {
                        callback();
                    }
                }

                // Users: GET /User/GetAll
                $.ajax({
                    url: '/User/GetAll',
                    type: 'GET',
                    data: { pageNumber: 1, pageSize: 1000, search: '' },
                    beforeSend: function () { },
                    success: function (response) {
                        var users = [];
                        if (response && response.data && Array.isArray(response.data)) {
                            users = response.data;
                        } else if (Array.isArray(response)) {
                            users = response;
                        } else if (response && response.items && Array.isArray(response.items)) {
                            users = response.items;
                        } else if (response && response.results && Array.isArray(response.results)) {
                            users = response.results;
                        }
                        users.forEach(function (user) {
                            if (user && user.userId) {
                                userMap[user.userId] = user.username || user.userId;
                            }
                        });
                    },
                    error: function () {
                        // Lookup is best-effort; raw IDs shown as fallback
                    },
                    complete: function () {
                        checkDone();
                    }
                });
            }

            // ── Load Note Data ───────────────────────────────────────
            function loadNote() {
                if (!noteId) {
                    showError('Invalid note ID.');
                    return;
                }

                $.ajax({
                    url: '/Note/GetById/' + noteId,
                    type: 'GET',
                    beforeSend: function () {
                        loadingContainer.classList.remove('d-none');
                        deleteContainer.classList.add('d-none');
                        errorContainer.classList.add('d-none');
                        confirmBtn.disabled = false;
                        confirmBtn.innerHTML = '<i class="bi bi-trash-fill me-1"></i>Confirm Delete';
                    },
                    success: function (response) {
                        loadingContainer.classList.add('d-none');

                        var note = response;
                        if (response && response.data) {
                            note = response.data;
                        }

                        if (!note || !note.noteId) {
                            showError('Note not found.');
                            return;
                        }

                        document.getElementById('deleteNoteId').textContent = note.noteId || '—';

                        var userName = (note.userId && userMap[note.userId])
                            ? userMap[note.userId]
                            : (note.userId ? note.userId : '—');
                        document.getElementById('deleteUser').textContent = userName;

                        document.getElementById('deleteNoteType').innerHTML = noteTypeBadge(note.noteType);
                        document.getElementById('deleteTitle').textContent = note.title || '—';
                        document.getElementById('deleteContent').textContent = note.content || '—';

                        deleteContainer.classList.remove('d-none');
                    },
                    error: function (xhr) {
                        loadingContainer.classList.add('d-none');
                        errorContainer.classList.remove('d-none');
                        var msg = 'Failed to load note data.';
                        if (xhr.status === 403) {
                            msg = 'You do not have permission to access this note.';
                        } else {
                            try {
                                msg = JSON.parse(xhr.responseText) || msg;
                            } catch (e) {
                                msg = xhr.responseText || msg;
                            }
                        }
                        errorMessage.textContent = msg;

                        if (typeof window.showToast === 'function') {
                            window.showToast(msg, 'error');
                        }
                    },
                    complete: function () {
                        // handled
                    }
                });
            }

            function showError(msg) {
                loadingContainer.classList.add('d-none');
                errorContainer.classList.remove('d-none');
                errorMessage.textContent = msg;
            }

            function noteTypeBadge(typeVal) {
                if (typeVal === 1 || typeVal === 'Technical') {
                    return '<span class="badge bg-primary">Technical</span>';
                }
                if (typeVal === 2 || typeVal === 'Behavioral') {
                    return '<span class="badge bg-success">Behavioral</span>';
                }
                return '<span class="text-muted">—</span>';
            }

            // ── Confirm Delete ───────────────────────────────────────
            confirmBtn.addEventListener('click', function () {
                if (!confirm('Are you sure you want to delete this note? This action cannot be undone.')) {
                    return;
                }

                confirmBtn.disabled = true;
                confirmBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span>Deleting...';

                $.ajax({
                    url: '/Note/Delete/' + noteId,
                    type: 'DELETE',
                    beforeSend: function () {
                        // button disabled
                    },
                    success: function (response) {
                        var msg = 'Note deleted successfully.';
                        if (response && response.message) {
                            msg = response.message;
                        }

                        if (typeof window.showToast === 'function') {
                            window.showToast(msg, 'success');
                        } else {
                            alert(msg);
                        }
                        window.location.href = '/Note';
                    },
                    error: function (xhr) {
                        var msg = 'Failed to delete note.';
                        if (xhr.status === 403) {
                            msg = 'You do not have permission to delete this note.';
                        } else {
                            try {
                                var resp = JSON.parse(xhr.responseText);
                                if (typeof resp === 'string') {
                                    msg = resp;
                                } else if (resp && resp.title) {
                                    msg = resp.title;
                                } else if (resp && resp.message) {
                                    msg = resp.message;
                                }
                            } catch (e) {
                                if (xhr.responseText) {
                                    msg = xhr.responseText;
                                }
                            }
                        }

                        if (typeof window.showToast === 'function') {
                            window.showToast(msg, 'error');
                        } else {
                            alert(msg);
                        }

                        confirmBtn.disabled = false;
                        confirmBtn.innerHTML = '<i class="bi bi-trash-fill me-1"></i>Confirm Delete';
                    },
                    complete: function () {
                        // handled
                    }
                });
            });

            // ── Initialize ──────────────────────────────────────────
            $(document).ready(function () {
                loadLookups(loadNote);
            });

        })();
    </script>
}