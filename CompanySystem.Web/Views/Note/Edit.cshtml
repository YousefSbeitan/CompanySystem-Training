@{
    Layout = "_Layout";
    ViewData["Title"] = "Edit Note";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <a href="/Note" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to Notes
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Edit Note</h4>
                </div>
                <div class="card-body">
                    <div id="loadingContainer" class="text-center py-5">
                        <div class="spinner-border text-warning" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2 text-muted">Loading note data...</p>
                    </div>

                    <form id="noteForm" class="d-none" novalidate>
                        <input type="hidden" id="noteId" name="noteId" value="" />

                        <div class="row g-3">
                            <div class="col-12">
                                <div class="mb-3">
                                    <label for="noteType" class="form-label">Note Type <span class="text-danger">*</span></label>
                                    <select class="form-select" id="noteType" name="noteType" required>
                                        <option value="">— Select Note Type —</option>
                                        <option value="1">Technical</option>
                                        <option value="2">Behavioral</option>
                                    </select>
                                    <div class="invalid-feedback" id="noteTypeError">Note type is required.</div>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-3">
                                    <label for="title" class="form-label">Title <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="title" name="title"
                                           required maxlength="200"
                                           placeholder="Enter note title" />
                                    <div class="invalid-feedback" id="titleError">Title is required and must not exceed 200 characters.</div>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-3">
                                    <label for="content" class="form-label">Content <span class="text-danger">*</span></label>
                                    <textarea class="form-control" id="content" name="content" rows="6"
                                              required placeholder="Enter note content"></textarea>
                                    <div class="invalid-feedback" id="contentError">Content is required.</div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a href="/Note" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-warning" id="submitBtn">
                                <i class="bi bi-check-circle me-1"></i>Save Changes
                            </button>
                        </div>
                    </form>

                    <div id="errorContainer" class="d-none text-center py-5 text-danger">
                        <i class="bi bi-exclamation-triangle-fill fs-1 d-block mb-3"></i>
                        <h5>Failed to load note</h5>
                        <p id="errorMessage" class="text-muted"></p>
                        <a href="/Note" class="btn btn-outline-secondary mt-2">Back to Notes</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            var permissions = window.currentUserPermissions || [];

            function hasPerm(perm) {
                return permissions.indexOf(perm) !== -1;
            }

            if (!hasPerm('Notes.Edit')) {
                document.body.innerHTML =
                    '<div class="container-fluid py-5 text-center text-danger">' +
                    '<i class="bi bi-shield-exclamation fs-1 d-block mb-3"></i>' +
                    '<h3>Access Denied</h3>' +
                    '<p>You do not have permission to edit notes.</p>' +
                    '<a href="/Note" class="btn btn-outline-secondary mt-3">Back to Notes</a>' +
                    '</div>';
                return;
            }

            function getUrlId() {
                var pathParts = window.location.pathname.split('/');
                var raw = decodeURIComponent(pathParts[pathParts.length - 1] || '');
                var id = parseInt(raw, 10);
                return isNaN(id) ? '' : id;
            }

            var noteId = getUrlId();

            var form = document.getElementById('noteForm');
            var submitBtn = document.getElementById('submitBtn');
            var typeSelect = document.getElementById('noteType');
            var titleInput = document.getElementById('title');
            var contentInput = document.getElementById('content');
            var loadingContainer = document.getElementById('loadingContainer');
            var errorContainer = document.getElementById('errorContainer');
            var errorMessage = document.getElementById('errorMessage');

            // ── Real-time validation ─────────────────────────────────
            typeSelect.addEventListener('change', function () {
                if (this.value) {
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                } else {
                    this.classList.remove('is-valid');
                    this.classList.add('is-invalid');
                }
            });

            titleInput.addEventListener('input', function () {
                var val = this.value.trim();
                if (val.length > 0 && val.length <= 200) {
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                } else {
                    this.classList.remove('is-valid');
                    if (val.length > 0) {
                        this.classList.add('is-invalid');
                    } else {
                        this.classList.remove('is-invalid');
                    }
                }
            });

            contentInput.addEventListener('input', function () {
                var val = this.value.trim();
                if (val.length > 0) {
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                } else {
                    this.classList.remove('is-valid');
                    this.classList.add('is-invalid');
                }
            });

            // ── Load Note Data ───────────────────────────────────────
            function loadNote() {
                if (!noteId) {
                    showError('Invalid note ID.');
                    return;
                }

                $.ajax({
                    url: '/Note/GetById/' + noteId,
                    type: 'GET',
                    beforeSend: function () {
                        loadingContainer.classList.remove('d-none');
                        form.classList.add('d-none');
                        errorContainer.classList.add('d-none');
                    },
                    success: function (response) {
                        loadingContainer.classList.add('d-none');

                        var note = response;
                        // If response is wrapped
                        if (response && response.data) {
                            note = response.data;
                        }

                        if (!note || !note.noteId) {
                            showError('Note not found.');
                            return;
                        }

                        document.getElementById('noteId').value = note.noteId;

                        typeSelect.value = String(note.noteType);
                        if (typeSelect.value) {
                            typeSelect.classList.add('is-valid');
                        }

                        titleInput.value = note.title || '';
                        if (titleInput.value) {
                            titleInput.classList.add('is-valid');
                        }

                        contentInput.value = note.content || '';
                        if (contentInput.value.trim()) {
                            contentInput.classList.add('is-valid');
                        }

                        form.classList.remove('d-none');
                    },
                    error: function (xhr) {
                        loadingContainer.classList.add('d-none');
                        errorContainer.classList.remove('d-none');
                        var msg = 'Failed to load note data.';
                        if (xhr.status === 403) {
                            msg = 'You do not have permission to access this note.';
                        } else {
                            try {
                                msg = JSON.parse(xhr.responseText) || msg;
                            } catch (e) {
                                msg = xhr.responseText || msg;
                            }
                        }
                        errorMessage.textContent = msg;

                        if (typeof window.showToast === 'function') {
                            window.showToast(msg, 'error');
                        }
                    },
                    complete: function () {
                        // handled
                    }
                });
            }

            function showError(msg) {
                loadingContainer.classList.add('d-none');
                errorContainer.classList.remove('d-none');
                errorMessage.textContent = msg;
            }

            // ── Form Submit ──────────────────────────────────────────
            form.addEventListener('submit', function (e) {
                e.preventDefault();

                var noteType = typeSelect.value;
                var title = titleInput.value.trim();
                var content = contentInput.value.trim();

                var isValid = true;

                if (!noteType) {
                    typeSelect.classList.add('is-invalid');
                    isValid = false;
                } else {
                    typeSelect.classList.remove('is-invalid');
                    typeSelect.classList.add('is-valid');
                }

                if (!title || title.length === 0 || title.length > 200) {
                    titleInput.classList.add('is-invalid');
                    isValid = false;
                } else {
                    titleInput.classList.remove('is-invalid');
                    titleInput.classList.add('is-valid');
                }

                if (!content || content.length === 0) {
                    contentInput.classList.add('is-invalid');
                    isValid = false;
                } else {
                    contentInput.classList.remove('is-invalid');
                    contentInput.classList.add('is-valid');
                }

                if (!isValid) return;

                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span>Saving...';

                var dto = {
                    noteId: parseInt(document.getElementById('noteId').value, 10),
                    noteType: parseInt(noteType, 10),
                    title: title,
                    content: content
                };

                $.ajax({
                    url: '/Note/Edit',
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify(dto),
                    beforeSend: function () {
                        // button disabled
                    },
                    success: function (response) {
                        if (typeof window.showToast === 'function') {
                            window.showToast('Note updated successfully.', 'success');
                        } else {
                            alert('Note updated successfully.');
                        }
                        window.location.href = '/Note';
                    },
                    error: function (xhr) {
                        var msg = 'Failed to update note.';
                        if (xhr.status === 403) {
                            msg = 'You do not have permission to edit this note.';
                        } else {
                            try {
                                var resp = JSON.parse(xhr.responseText);
                                if (typeof resp === 'string') {
                                    msg = resp;
                                } else if (resp && resp.title) {
                                    msg = resp.title;
                                } else if (resp && resp.message) {
                                    msg = resp.message;
                                } else if (typeof resp === 'object') {
                                    for (var key in resp) {
                                        if (resp.hasOwnProperty(key) && Array.isArray(resp[key]) && resp[key].length > 0) {
                                            msg = resp[key][0];
                                            break;
                                        }
                                    }
                                }
                            } catch (e) {
                                if (xhr.responseText) {
                                    msg = xhr.responseText;
                                }
                            }
                        }

                        if (typeof window.showToast === 'function') {
                            window.showToast(msg, 'error');
                        } else {
                            alert(msg);
                        }

                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Save Changes';
                    },
                    complete: function () {
                        // handled
                    }
                });
            });

            // ── Initialize ──────────────────────────────────────────
            $(document).ready(function () {
                loadNote();
            });

        })();
    </script>
}