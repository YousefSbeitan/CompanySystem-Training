@{
    ViewData["Title"] = "Edit Note";
}

<div class="container-fluid">
    <h1 class="h3 mb-3">Edit Note</h1>

    <!-- Loading Spinner -->
    <div id="loadingSpinner" class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2 text-muted">Loading note data...</p>
    </div>

    <!-- Error -->
    <div id="errorAlert" class="alert alert-danger" style="display:none;"></div>
    <div id="notFoundAlert" class="alert alert-warning" style="display:none;">Note not found.</div>
    <div id="permissionDenied" class="alert alert-danger" style="display:none;">
        You do not have permission to edit this note.
    </div>

    <!-- Edit Form -->
    <div class="card" id="editCard" style="display:none;">
        <div class="card-body">
            <form id="editForm" novalidate>
                <input type="hidden" id="editNoteId" />

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="editUserId" class="form-label">User</label>
                            <input type="text" class="form-control" id="editUserId" readonly disabled />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="editNoteType" class="form-label">
                                Note Type <span class="text-danger">*</span>
                            </label>
                            <select class="form-select" id="editNoteType" name="NoteType" required>
                                <option value="">-- Select Note Type --</option>
                                <option value="1">Technical</option>
                                <option value="2">Behavioral</option>
                            </select>
                            <div class="invalid-feedback">
                                Note type is required.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="mb-3">
                            <label for="editTitle" class="form-label">
                                Title <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control" id="editTitle" name="Title"
                                   maxlength="200" required placeholder="Enter note title" />
                            <div class="invalid-feedback">
                                Title is required and must not exceed 200 characters.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="mb-3">
                            <label for="editContent" class="form-label">
                                Content <span class="text-danger">*</span>
                            </label>
                            <textarea class="form-control" id="editContent" name="Content"
                                      rows="6" required placeholder="Enter note content"></textarea>
                            <div class="invalid-feedback">
                                Content is required.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" id="btnSave">
                        <i class="bi bi-check-lg"></i> Save Changes
                    </button>
                    <a href="/Note" class="btn btn-secondary">Cancel</a>
                </div>
            </form>

            <!-- Saving Spinner (hidden) -->
            <div id="savingSpinner" class="text-center my-3" style="display:none;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Saving...</span>
                </div>
                <p class="mt-2 text-muted">Saving changes...</p>
            </div>
        </div>
    </div>

    <!-- Alert Container -->
    <div id="alertContainer" class="mt-3"></div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var currentUserRole = window.currentUserRole || '';
            var isAdmin = (currentUserRole === 'Admin');
            var isManager = (currentUserRole === 'Manager');

            // Check permission
            if (!isAdmin && !isManager) {
                $('#loadingSpinner').hide();
                $('#alertContainer').html(
                    '<div class="alert alert-danger">You do not have permission to edit notes.</div>'
                );
                return;
            }

            // Extract note ID from URL: /Note/Edit/{id}
            var pathParts = window.location.pathname.split('/');
            var noteId = parseInt(pathParts[pathParts.length - 1]);

            if (!noteId) {
                $('#loadingSpinner').hide();
                $('#errorAlert').text('Invalid note ID.').show();
                return;
            }

            // Load note data
            $.ajax({
                url: '/Note/GetById/' + noteId,
                type: 'GET',
                success: function (note) {
                    $('#loadingSpinner').hide();

                    if (!note) {
                        $('#notFoundAlert').show();
                        return;
                    }

                    $('#editNoteId').val(note.noteId || note.noteID || '');
                    $('#editUserId').val(note.userId || '');
                    $('#editTitle').val(note.title || '');
                    $('#editContent').val(note.content || '');
                    $('#editNoteType').val(note.noteType || '');

                    $('#editCard').show();
                },
                error: function (xhr) {
                    $('#loadingSpinner').hide();
                    if (xhr.status === 404) {
                        $('#notFoundAlert').show();
                    } else if (xhr.status === 403) {
                        $('#permissionDenied').show();
                    } else {
                        var msg = xhr.responseText || 'Failed to load note.';
                        $('#errorAlert').text(msg).show();
                    }
                }
            });

            // Submit form
            $('#editForm').on('submit', function (e) {
                e.preventDefault();

                var form = this;
                if (!form.checkValidity()) {
                    form.classList.add('was-validated');
                    return;
                }

                var dto = {
                    noteId: parseInt($('#editNoteId').val()),
                    noteType: parseInt($('#editNoteType').val()),
                    title: $('#editTitle').val().trim(),
                    content: $('#editContent').val().trim()
                };

                $('#btnSave').prop('disabled', true);
                $('#savingSpinner').show();
                $('#alertContainer').empty();

                $.ajax({
                    url: '/Note/Edit',
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify(dto),
                    success: function (response) {
                        $('#savingSpinner').hide();
                        $('#alertContainer').html(
                            '<div class="alert alert-success">Note updated successfully! Redirecting...</div>'
                        );
                        setTimeout(function () {
                            window.location.href = '/Note';
                        }, 1000);
                    },
                    error: function (xhr) {
                        $('#savingSpinner').hide();
                        $('#btnSave').prop('disabled', false);

                        var msg = 'Failed to update note.';
                        if (xhr.responseJSON) {
                            if (xhr.responseJSON.title) {
                                msg = xhr.responseJSON.title;
                            } else if (xhr.responseJSON.errors) {
                                var errors = xhr.responseJSON.errors;
                                var errorList = [];
                                $.each(errors, function (key, arr) {
                                    $.each(arr, function (i, err) {
                                        errorList.push(err);
                                    });
                                });
                                msg = errorList.join('<br/>');
                            }
                        } else if (xhr.responseText) {
                            msg = xhr.responseText;
                        }

                        $('#alertContainer').html(
                            '<div class="alert alert-danger">' + msg + '</div>'
                        );
                    }
                });
            });
        });
    </script>
}
