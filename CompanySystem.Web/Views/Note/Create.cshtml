@{
    ViewData["Title"] = "Create Note";
}

<div class="container-fluid">
    <h1 class="h3 mb-3">Create Note</h1>

    <!-- Permission Denied (hidden by default) -->
    <div id="permissionDenied" class="alert alert-danger" style="display:none;">
        You do not have permission to create notes.
    </div>

    <div class="card" id="createCard">
        <div class="card-body">
            <form id="createForm" novalidate>
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="createUserId" class="form-label">
                                User <span class="text-danger">*</span>
                            </label>
                            <select class="form-select" id="createUserId" name="UserId" required>
                                <option value="">-- Select User --</option>
                            </select>
                            <div class="invalid-feedback">
                                User is required.
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="createNoteType" class="form-label">
                                Note Type <span class="text-danger">*</span>
                            </label>
                            <select class="form-select" id="createNoteType" name="NoteType" required>
                                <option value="">-- Select Note Type --</option>
                                <option value="1">Technical</option>
                                <option value="2">Behavioral</option>
                            </select>
                            <div class="invalid-feedback">
                                Note type is required.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="mb-3">
                            <label for="createTitle" class="form-label">
                                Title <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control" id="createTitle" name="Title"
                                   maxlength="200" required placeholder="Enter note title" />
                            <div class="invalid-feedback">
                                Title is required and must not exceed 200 characters.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="mb-3">
                            <label for="createContent" class="form-label">
                                Content <span class="text-danger">*</span>
                            </label>
                            <textarea class="form-control" id="createContent" name="Content"
                                      rows="6" required placeholder="Enter note content"></textarea>
                            <div class="invalid-feedback">
                                Content is required.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" id="btnSave">
                        <i class="bi bi-check-lg"></i> Save
                    </button>
                    <a href="/Note" class="btn btn-secondary">Cancel</a>
                </div>
            </form>

            <!-- Loading Spinner (hidden) -->
            <div id="loadingSpinner" class="text-center my-3" style="display:none;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Saving...</span>
                </div>
                <p class="mt-2 text-muted">Saving note...</p>
            </div>
        </div>
    </div>

    <!-- Alert Container -->
    <div id="alertContainer" class="mt-3"></div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var currentUserRole = window.currentUserRole || '';
            var isAdmin = (currentUserRole === 'Admin');
            var isManager = (currentUserRole === 'Manager');

            // Check permission
            if (!isAdmin && !isManager) {
                $('#createCard').hide();
                $('#permissionDenied').show();
                return;
            }

            // ── Load Users Dropdown ───────────────────────────────
            function loadUsers() {
                $.ajax({
                    url: '/User/GetAll',
                    type: 'GET',
                    data: {
                        pageSize: 1000
                    },
                    success: function (response) {
                        var data = response.data || response.items || response.results || response || [];
                        var users = Array.isArray(data) ? data : [];
                        var select = $('#createUserId');
                        select.find('option:not(:first)').remove();

                        $.each(users, function (idx, user) {
                            select.append(
                                $('<option></option>')
                                    .val(user.userId || '')
                                    .text((user.username || '') + ' (' + (user.userId || '') + ')')
                            );
                        });
                    },
                    error: function () {
                        // If user list fails, allow typing UserId manually
                        var select = $('#createUserId');
                        select.replaceWith(
                            '<input type="text" class="form-control" id="createUserId" name="UserId" maxlength="50" required placeholder="Enter user ID" />'
                        );
                    }
                });
            }

            loadUsers();

            // ── Form Submit ────────────────────────────────────────
            $('#createForm').on('submit', function (e) {
                e.preventDefault();

                var form = this;
                if (!form.checkValidity()) {
                    form.classList.add('was-validated');
                    return;
                }

                var dto = {
                    userId: $('#createUserId').val().trim(),
                    noteType: parseInt($('#createNoteType').val()),
                    title: $('#createTitle').val().trim(),
                    content: $('#createContent').val().trim()
                };

                $('#btnSave').prop('disabled', true);
                $('#loadingSpinner').show();
                $('#alertContainer').empty();

                $.ajax({
                    url: '/Note/Create',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(dto),
                    success: function (response) {
                        $('#loadingSpinner').hide();
                        $('#alertContainer').html(
                            '<div class="alert alert-success">Note created successfully! Redirecting...</div>'
                        );
                        setTimeout(function () {
                            window.location.href = '/Note';
                        }, 1000);
                    },
                    error: function (xhr) {
                        $('#loadingSpinner').hide();
                        $('#btnSave').prop('disabled', false);

                        var msg = 'Failed to create note.';
                        if (xhr.responseJSON) {
                            if (xhr.responseJSON.title) {
                                msg = xhr.responseJSON.title;
                            } else if (xhr.responseJSON.errors) {
                                var errors = xhr.responseJSON.errors;
                                var errorList = [];
                                $.each(errors, function (key, arr) {
                                    $.each(arr, function (i, err) {
                                        errorList.push(err);
                                    });
                                });
                                msg = errorList.join('<br/>');
                            }
                        } else if (xhr.responseText) {
                            msg = xhr.responseText;
                        }

                        $('#alertContainer').html(
                            '<div class="alert alert-danger">' + msg + '</div>'
                        );
                    }
                });
            });
        });
    </script>
}
