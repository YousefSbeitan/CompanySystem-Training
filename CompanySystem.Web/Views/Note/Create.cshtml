@{
    Layout = "_Layout";
    ViewData["Title"] = "Create Note";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <a href="/Note" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to Notes
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-journal-plus me-2"></i>Create New Note</h4>
                </div>
                <div class="card-body">
                    <form id="noteForm" novalidate>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="userId" class="form-label">User <span class="text-danger">*</span></label>
                                    <select class="form-select" id="userId" name="userId" required>
                                        <option value="">Loading users...</option>
                                    </select>
                                    <div class="invalid-feedback" id="userIdError">User is required.</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="noteType" class="form-label">Note Type <span class="text-danger">*</span></label>
                                    <select class="form-select" id="noteType" name="noteType" required>
                                        <option value="">— Select Note Type —</option>
                                        <option value="1">Technical</option>
                                        <option value="2">Behavioral</option>
                                    </select>
                                    <div class="invalid-feedback" id="noteTypeError">Note type is required.</div>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-3">
                                    <label for="title" class="form-label">Title <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="title" name="title"
                                           required maxlength="200"
                                           placeholder="Enter note title" />
                                    <div class="invalid-feedback" id="titleError">Title is required and must not exceed 200 characters.</div>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-3">
                                    <label for="content" class="form-label">Content <span class="text-danger">*</span></label>
                                    <textarea class="form-control" id="content" name="content" rows="6"
                                              required placeholder="Enter note content"></textarea>
                                    <div class="invalid-feedback" id="contentError">Content is required.</div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a href="/Note" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary" id="submitBtn">
                                <i class="bi bi-check-circle me-1"></i>Create Note
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            var permissions = window.currentUserPermissions || [];

            function hasPerm(perm) {
                return permissions.indexOf(perm) !== -1;
            }

            if (!hasPerm('Notes.Create')) {
                document.body.innerHTML =
                    '<div class="container-fluid py-5 text-center text-danger">' +
                    '<i class="bi bi-shield-exclamation fs-1 d-block mb-3"></i>' +
                    '<h3>Access Denied</h3>' +
                    '<p>You do not have permission to create notes.</p>' +
                    '<a href="/Note" class="btn btn-outline-secondary mt-3">Back to Notes</a>' +
                    '</div>';
                return;
            }

            var form = document.getElementById('noteForm');
            var submitBtn = document.getElementById('submitBtn');
            var userSelect = document.getElementById('userId');
            var typeSelect = document.getElementById('noteType');
            var titleInput = document.getElementById('title');
            var contentInput = document.getElementById('content');

            // ── Load Users (FK dropdown: /User/GetAll) ───────────────
            function loadUsers() {
                userSelect.innerHTML = '<option value="">Loading users...</option>';

                $.ajax({
                    url: '/User/GetAll',
                    type: 'GET',
                    data: { pageNumber: 1, pageSize: 1000, search: '' },
                    beforeSend: function () {
                        // select shows loading option
                    },
                    success: function (response) {
                        var users = [];
                        if (response && response.data && Array.isArray(response.data)) {
                            users = response.data;
                        } else if (Array.isArray(response)) {
                            users = response;
                        } else if (response && response.items && Array.isArray(response.items)) {
                            users = response.items;
                        } else if (response && response.results && Array.isArray(response.results)) {
                            users = response.results;
                        }

                        var html = '<option value="">— Select User —</option>';
                        users.forEach(function (user) {
                            var value = escapeHtml(user.userId || '');
                            var label = escapeHtml(user.username || user.userId || '');
                            html += '<option value="' + value + '">' + label + '</option>';
                        });

                        userSelect.innerHTML = html;
                    },
                    error: function () {
                        userSelect.innerHTML = '<option value="">— Select User —</option>';
                    },
                    complete: function () {
                        // handled
                    }
                });
            }

            // ── Real-time validation ─────────────────────────────────
            userSelect.addEventListener('change', function () {
                if (this.value) {
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                } else {
                    this.classList.remove('is-valid');
                    this.classList.add('is-invalid');
                }
            });

            typeSelect.addEventListener('change', function () {
                if (this.value) {
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                } else {
                    this.classList.remove('is-valid');
                    this.classList.add('is-invalid');
                }
            });

            titleInput.addEventListener('input', function () {
                var val = this.value.trim();
                if (val.length > 0 && val.length <= 200) {
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                } else {
                    this.classList.remove('is-valid');
                    if (val.length > 0) {
                        this.classList.add('is-invalid');
                    } else {
                        this.classList.remove('is-invalid');
                    }
                }
            });

            contentInput.addEventListener('input', function () {
                var val = this.value.trim();
                if (val.length > 0) {
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                } else {
                    this.classList.remove('is-valid');
                    this.classList.add('is-invalid');
                }
            });

            // ── Form Submit ──────────────────────────────────────────
            form.addEventListener('submit', function (e) {
                e.preventDefault();

                var userId = userSelect.value;
                var noteType = typeSelect.value;
                var title = titleInput.value.trim();
                var content = contentInput.value.trim();

                var isValid = true;

                if (!userId) {
                    userSelect.classList.add('is-invalid');
                    isValid = false;
                } else {
                    userSelect.classList.remove('is-invalid');
                    userSelect.classList.add('is-valid');
                }

                if (!noteType) {
                    typeSelect.classList.add('is-invalid');
                    isValid = false;
                } else {
                    typeSelect.classList.remove('is-invalid');
                    typeSelect.classList.add('is-valid');
                }

                if (!title || title.length === 0 || title.length > 200) {
                    titleInput.classList.add('is-invalid');
                    isValid = false;
                } else {
                    titleInput.classList.remove('is-invalid');
                    titleInput.classList.add('is-valid');
                }

                if (!content || content.length === 0) {
                    contentInput.classList.add('is-invalid');
                    isValid = false;
                } else {
                    contentInput.classList.remove('is-invalid');
                    contentInput.classList.add('is-valid');
                }

                if (!isValid) return;

                // Disable button
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span>Creating...';

                var dto = {
                    userId: userId,
                    noteType: parseInt(noteType, 10),
                    title: title,
                    content: content
                };

                $.ajax({
                    url: '/Note/Create',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(dto),
                    beforeSend: function () {
                        // button already disabled
                    },
                    success: function (response) {
                        if (typeof window.showToast === 'function') {
                            window.showToast('Note created successfully.', 'success');
                        } else {
                            alert('Note created successfully.');
                        }
                        window.location.href = '/Note';
                    },
                    error: function (xhr) {
                        var msg = 'Failed to create note.';
                        if (xhr.status === 403) {
                            msg = 'You do not have permission to create a note for this user.';
                        } else {
                            try {
                                var resp = JSON.parse(xhr.responseText);
                                if (typeof resp === 'string') {
                                    msg = resp;
                                } else if (resp && resp.title) {
                                    msg = resp.title;
                                } else if (resp && resp.message) {
                                    msg = resp.message;
                                } else if (typeof resp === 'object') {
                                    for (var key in resp) {
                                        if (resp.hasOwnProperty(key) && Array.isArray(resp[key]) && resp[key].length > 0) {
                                            msg = resp[key][0];
                                            break;
                                        }
                                    }
                                }
                            } catch (e) {
                                if (xhr.responseText) {
                                    msg = xhr.responseText;
                                }
                            }
                        }

                        if (typeof window.showToast === 'function') {
                            window.showToast(msg, 'error');
                        } else {
                            alert(msg);
                        }

                        // Re-enable
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Create Note';
                    },
                    complete: function () {
                        // handled in error/success
                    }
                });
            });

            // ── Helpers ──────────────────────────────────────────────
            function escapeHtml(str) {
                if (!str) return '';
                var div = document.createElement('div');
                div.appendChild(document.createTextNode(str));
                return div.innerHTML;
            }

            // ── Initialize ──────────────────────────────────────────
            $(document).ready(function () {
                loadUsers();
            });

        })();
    </script>
}