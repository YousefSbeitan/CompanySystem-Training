@{
    ViewData["Title"] = "Main Page Section Management";
}

<div class="crud-container">
    <div class="crud-header">
        <h1><i class="bi bi-layout-text-window-reverse me-2"></i>Main Page Section Management</h1>
        <button class="btn btn-primary admin-only" id="btnCreate" style="display:none;">
            <i class="bi bi-plus-lg"></i> Create Section
        </button>
    </div>

    <!-- Search & Filter -->
    <div class="search-filter-row">
        <div class="search-group">
            <div class="input-group">
                <input type="text" class="form-control" id="inputSearch" placeholder="Search by title or content..." />
                <button class="btn btn-outline-secondary" type="button" id="btnSearch">
                    <i class="bi bi-search"></i> Search
                </button>
                <button class="btn btn-outline-secondary" type="button" id="btnClear">
                    <i class="bi bi-x-circle"></i> Clear
                </button>
            </div>
        </div>
        <div class="page-size-group">
            <select class="form-select" id="selectPageSize">
                <option value="5">5 per page</option>
                <option value="10" selected>10 per page</option>
                <option value="20">20 per page</option>
                <option value="50">50 per page</option>
            </select>
        </div>
    </div>

    <!-- Alerts -->
    <div id="errorAlert" class="alert alert-danger crud-alert" style="display:none;"></div>

    <!-- Loading Spinner -->
    <div class="page-loading" id="loadingSpinner" style="display:none;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p>Loading sections...</p>
    </div>

    <!-- Table -->
    <div class="crud-table">
        <div class="table-responsive-custom">
            <table class="table table-hover table-striped" id="sectionsTable" style="display:none;">
                <thead>
                    <tr>
                        <th data-sort="SectionId" class="sortable" style="cursor:pointer; width:80px;">
                            ID <span class="sort-icon"></span>
                        </th>
                        <th data-sort="SectionType" class="sortable" style="cursor:pointer;">
                            Section Type <span class="sort-icon"></span>
                        </th>
                        <th data-sort="Title" class="sortable" style="cursor:pointer;">
                            Title <span class="sort-icon"></span>
                        </th>
                        <th data-sort="Content" class="sortable" style="cursor:pointer;">
                            Content <span class="sort-icon"></span>
                        </th>
                        <th data-sort="CreatedBy" class="sortable" style="cursor:pointer;">
                            Created By <span class="sort-icon"></span>
                        </th>
                        <th data-sort="CreatedDate" class="sortable" style="cursor:pointer;">
                            Created Date <span class="sort-icon"></span>
                        </th>
                        <th style="width:200px;">Actions</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    <nav id="paginationNav" class="mt-3" style="display:none;">
        <ul class="pagination justify-content-center" id="paginationUl">
        </ul>
    </nav>

    <!-- No Data -->
    <div class="empty-state" id="noData" style="display:none;">
        <i class="bi bi-layout-text-window-reverse empty-icon"></i>
        <h4>No Sections Found</h4>
        <p>There are no content sections available yet.</p>
        <button class="btn btn-primary admin-only" id="btnCreateEmpty" style="display:none;">
            <i class="bi bi-plus-lg"></i> Create Section
        </button>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // ── State ────────────────────────────────────────────────
            var currentPage = 1;
            var currentPageSize = 10;
            var currentSearch = '';
            var currentSortBy = 'SectionId';
            var currentIsDescending = false;
            var currentUserRole = window.currentUserRole || '';
            var isAdmin = (currentUserRole === 'Admin');

            // ── Initial Role Visibility ─────────────────────────────
            if (isAdmin) {
                $('.admin-only').show();
            }

            function showToast(msg, type) {
                if (window.showToast) {
                    window.showToast(msg, type);
                } else if (window.auth && window.auth.showNotification) {
                    window.auth.showNotification(msg, type === 'success' ? 'success' : 'error');
                }
            }

            // ── Section Type Mapping ─────────────────────────────────
            function getSectionTypeText(type) {
                switch (type) {
                    case 1: return 'About Us';
                    case 2: return 'Services';
                    case 3: return 'Contact Us';
                    case 4: return 'Home';
                    default: return type || '-';
                }
            }

            // ── Load Data ───────────────────────────────────────────
            function loadSections() {
                $('#loadingSpinner').show();
                $('#sectionsTable').hide();
                $('#paginationNav').hide();
                $('#noData').hide();
                $('#errorAlert').hide();

                $.ajax({
                    url: '/MainPageSection/GetAll',
                    type: 'GET',
                    data: {
                        pageNumber: currentPage,
                        pageSize: currentPageSize,
                        search: currentSearch,
                        sortBy: currentSortBy,
                        isDescending: currentIsDescending
                    },
                    success: function (response) {
                        $('#loadingSpinner').hide();

                        var data = response.data || response.items || response.results || response || [];
                        var totalPages = response.totalPages || 0;
                        var pageNumber = response.pageNumber || currentPage;

                        if (Array.isArray(data) && data.length > 0) {
                            renderTable(data);
                            renderPagination(totalPages, pageNumber);
                            $('#sectionsTable').show();
                            $('#paginationNav').show();
                        } else {
                            $('#noData').show();
                        }
                    },
                    error: function (xhr) {
                        $('#loadingSpinner').hide();
                        var msg = xhr.responseText || 'An error occurred while loading sections.';
                        if (xhr.status === 403) {
                            msg = 'You do not have permission to view sections.';
                        }
                        $('#errorAlert').text(msg).show();
                    }
                });
            }

            // ── Render Table ────────────────────────────────────────
            function renderTable(sections) {
                var html = '';
                $.each(sections, function (idx, section) {
                    var createdDate = section.createdDate
                        ? new Date(section.createdDate).toLocaleDateString()
                        : '-';
                    var sectionType = getSectionTypeText(section.sectionType);
                    var contentPreview = section.content
                        ? (section.content.length > 60 ? section.content.substring(0, 60) + '...' : section.content)
                        : '-';

                    html += '<tr>';
                    html += '<td>' + escapeHtml(section.sectionId) + '</td>';
                    html += '<td><span class="badge bg-info">' + escapeHtml(sectionType) + '</span></td>';
                    html += '<td><strong>' + escapeHtml(section.title || '') + '</strong></td>';
                    html += '<td class="text-muted">' + escapeHtml(contentPreview) + '</td>';
                    html += '<td>' + escapeHtml(section.createdBy || '-') + '</td>';
                    html += '<td>' + createdDate + '</td>';
                    html += '<td><div class="action-btns">';
                    html += '<button class="btn btn-sm btn-info btn-details" data-id="' + escapeHtml(section.sectionId) + '" title="Details"><i class="bi bi-eye"></i></button>';
                    if (isAdmin) {
                        html += '<button class="btn btn-sm btn-warning btn-edit" data-id="' + escapeHtml(section.sectionId) + '" title="Edit"><i class="bi bi-pencil"></i></button>';
                        html += '<button class="btn btn-sm btn-danger btn-delete" data-id="' + escapeHtml(section.sectionId) + '" title="Delete"><i class="bi bi-trash"></i></button>';
                    }
                    html += '</div></td>';
                    html += '</tr>';
                });
                $('#tableBody').html(html);
            }

            // ── Render Pagination ───────────────────────────────────
            function renderPagination(totalPages, pageNumber) {
                var ul = $('#paginationUl');
                ul.empty();

                if (totalPages <= 1) {
                    $('#paginationNav').hide();
                    return;
                }
                $('#paginationNav').show();

                ul.append('<li class="page-item' + (pageNumber <= 1 ? ' disabled' : '') + '"><a class="page-link" href="#" data-page="' + (pageNumber - 1) + '"><i class="bi bi-chevron-left"></i></a></li>');

                for (var i = 1; i <= totalPages; i++) {
                    ul.append('<li class="page-item' + (i === pageNumber ? ' active' : '') + '"><a class="page-link" href="#" data-page="' + i + '">' + i + '</a></li>');
                }

                ul.append('<li class="page-item' + (pageNumber >= totalPages ? ' disabled' : '') + '"><a class="page-link" href="#" data-page="' + (pageNumber + 1) + '"><i class="bi bi-chevron-right"></i></a></li>');
            }

            // ── Helpers ─────────────────────────────────────────────
            function escapeHtml(str) {
                if (!str) return '';
                return $('<span>').text(str).html();
            }

            function updateSortIcon() {
                $('.sortable .sort-icon').text('');
                $('.sortable').each(function () {
                    var col = $(this).data('sort');
                    if (col === currentSortBy) {
                        $(this).find('.sort-icon').text(currentIsDescending ? ' ▲' : ' ▼');
                    }
                });
            }

            // ── Sort Click ──────────────────────────────────────────
            $(document).on('click', '.sortable', function () {
                var col = $(this).data('sort');
                if (col === currentSortBy) {
                    currentIsDescending = !currentIsDescending;
                } else {
                    currentSortBy = col;
                    currentIsDescending = false;
                }
                currentPage = 1;
                updateSortIcon();
                loadSections();
            });

            // ── Pagination Click ────────────────────────────────────
            $(document).on('click', '.page-link', function (e) {
                e.preventDefault();
                var page = parseInt($(this).data('page'));
                if (page && page > 0) {
                    currentPage = page;
                    loadSections();
                }
            });

            // ── Search ──────────────────────────────────────────────
            $('#btnSearch').on('click', function () {
                currentSearch = $('#inputSearch').val().trim();
                currentPage = 1;
                loadSections();
            });

            $('#inputSearch').on('keypress', function (e) {
                if (e.which === 13) {
                    $('#btnSearch').click();
                }
            });

            $('#btnClear').on('click', function () {
                $('#inputSearch').val('');
                currentSearch = '';
                currentPage = 1;
                loadSections();
            });

            // ── Page Size ───────────────────────────────────────────
            $('#selectPageSize').on('change', function () {
                currentPageSize = parseInt($(this).val());
                currentPage = 1;
                loadSections();
            });

            // ── Create ──────────────────────────────────────────────
            $('#btnCreate, #btnCreateEmpty').on('click', function () {
                window.location.href = '/MainPageSection/Create';
            });

            // ── Details ─────────────────────────────────────────────
            $(document).on('click', '.btn-details', function () {
                var id = $(this).data('id');
                window.location.href = '/MainPageSection/Details/' + encodeURIComponent(id);
            });

            // ── Edit ────────────────────────────────────────────────
            $(document).on('click', '.btn-edit', function () {
                var id = $(this).data('id');
                window.location.href = '/MainPageSection/Edit/' + encodeURIComponent(id);
            });

            // ── Delete ──────────────────────────────────────────────
            $(document).on('click', '.btn-delete', function () {
                var id = $(this).data('id');
                window.location.href = '/MainPageSection/Delete/' + encodeURIComponent(id);
            });

            // ── Initial Load ────────────────────────────────────────
            updateSortIcon();
            loadSections();
        });
    </script>
}

