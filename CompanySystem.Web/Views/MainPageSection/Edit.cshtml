@{
    ViewData["Title"] = "Edit Main Page Section";
}

<div class="container-fluid">
    <h1 class="h3 mb-3">Edit Main Page Section</h1>

    <!-- Loading Spinner -->
    <div id="loadingSpinner" class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2 text-muted">Loading section data...</p>
    </div>

    <!-- Error -->
    <div id="errorAlert" class="alert alert-danger" style="display:none;"></div>
    <div id="notFoundAlert" class="alert alert-warning" style="display:none;">Section not found.</div>
    <div id="permissionDenied" class="alert alert-danger" style="display:none;">
        You do not have permission to edit this section.
    </div>

    <!-- Edit Form -->
    <div class="card" id="editCard" style="display:none;">
        <div class="card-body">
            <form id="editForm" novalidate>
                <input type="hidden" id="editSectionId" />

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="editSectionType" class="form-label">
                                Section Type <span class="text-danger">*</span>
                            </label>
                            <select class="form-select" id="editSectionType" name="SectionType" required>
                                <option value="">-- Select Section Type --</option>
                                <option value="1">About Us</option>
                                <option value="2">Services</option>
                                <option value="3">Contact Us</option>
                                <option value="4">Home</option>
                            </select>
                            <div class="invalid-feedback">
                                Section type is required.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="mb-3">
                            <label for="editTitle" class="form-label">
                                Title <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control" id="editTitle" name="Title"
                                   maxlength="200" required placeholder="Enter section title" />
                            <div class="invalid-feedback">
                                Title is required and must not exceed 200 characters.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="mb-3">
                            <label for="editContent" class="form-label">
                                Content <span class="text-danger">*</span>
                            </label>
                            <textarea class="form-control" id="editContent" name="Content"
                                      rows="6" required placeholder="Enter section content"></textarea>
                            <div class="invalid-feedback">
                                Content is required.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" id="btnSave">
                        <i class="bi bi-check-lg"></i> Save Changes
                    </button>
                    <a href="/MainPageSection" class="btn btn-secondary">Cancel</a>
                </div>
            </form>

            <!-- Saving Spinner (hidden) -->
            <div id="savingSpinner" class="text-center my-3" style="display:none;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Saving...</span>
                </div>
                <p class="mt-2 text-muted">Saving changes...</p>
            </div>
        </div>
    </div>

    <!-- Alert Container -->
    <div id="alertContainer" class="mt-3"></div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var currentUserRole = window.currentUserRole || '';
            var isAdmin = (currentUserRole === 'Admin');

            // Check permission
            if (!isAdmin) {
                $('#loadingSpinner').hide();
                $('#alertContainer').html(
                    '<div class="alert alert-danger">You do not have permission to edit sections.</div>'
                );
                return;
            }

            // Extract section ID from URL: /MainPageSection/Edit/{id}
            var pathParts = window.location.pathname.split('/');
            var sectionId = parseInt(pathParts[pathParts.length - 1]);

            if (!sectionId) {
                $('#loadingSpinner').hide();
                $('#errorAlert').text('Invalid section ID.').show();
                return;
            }

            // Load section data
            $.ajax({
                url: '/MainPageSection/GetById/' + sectionId,
                type: 'GET',
                success: function (section) {
                    $('#loadingSpinner').hide();

                    if (!section) {
                        $('#notFoundAlert').show();
                        return;
                    }

                    $('#editSectionId').val(section.sectionId || section.sectionID || '');
                    $('#editSectionType').val(section.sectionType || '');
                    $('#editTitle').val(section.title || '');
                    $('#editContent').val(section.content || '');

                    $('#editCard').show();
                },
                error: function (xhr) {
                    $('#loadingSpinner').hide();
                    if (xhr.status === 404) {
                        $('#notFoundAlert').show();
                    } else if (xhr.status === 403) {
                        $('#permissionDenied').show();
                    } else {
                        var msg = xhr.responseText || 'Failed to load section.';
                        $('#errorAlert').text(msg).show();
                    }
                }
            });

            // Submit form
            $('#editForm').on('submit', function (e) {
                e.preventDefault();

                var form = this;
                if (!form.checkValidity()) {
                    form.classList.add('was-validated');
                    return;
                }

                var dto = {
                    sectionId: parseInt($('#editSectionId').val()),
                    sectionType: parseInt($('#editSectionType').val()),
                    title: $('#editTitle').val().trim(),
                    content: $('#editContent').val().trim()
                };

                $('#btnSave').prop('disabled', true);
                $('#savingSpinner').show();
                $('#alertContainer').empty();

                $.ajax({
                    url: '/MainPageSection/Edit',
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify(dto),
                    success: function (response) {
                        $('#savingSpinner').hide();
                        $('#alertContainer').html(
                            '<div class="alert alert-success">Section updated successfully! Redirecting...</div>'
                        );
                        setTimeout(function () {
                            window.location.href = '/MainPageSection';
                        }, 1000);
                    },
                    error: function (xhr) {
                        $('#savingSpinner').hide();
                        $('#btnSave').prop('disabled', false);

                        var msg = 'Failed to update section.';
                        if (xhr.responseJSON) {
                            if (xhr.responseJSON.title) {
                                msg = xhr.responseJSON.title;
                            } else if (xhr.responseJSON.errors) {
                                var errors = xhr.responseJSON.errors;
                                var errorList = [];
                                $.each(errors, function (key, arr) {
                                    $.each(arr, function (i, err) {
                                        errorList.push(err);
                                    });
                                });
                                msg = errorList.join('<br/>');
                            }
                        } else if (xhr.responseText) {
                            msg = xhr.responseText;
                        }

                        $('#alertContainer').html(
                            '<div class="alert alert-danger">' + msg + '</div>'
                        );
                    }
                });
            });
        });
    </script>
}
