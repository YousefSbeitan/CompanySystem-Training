@{
    Layout = "_Layout";
    ViewData["Title"] = "Create Main Page Section";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <a href="/MainPageSection" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to Main Page Sections
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-layout-text-window-reverse me-2"></i>Create New Main Page Section</h4>
                </div>
                <div class="card-body">
                    <form id="sectionForm" novalidate>
                        <div class="mb-3">
                            <label for="sectionType" class="form-label">Section Type <span class="text-danger">*</span></label>
                            <select class="form-select" id="sectionType" name="sectionType" required>
                                <option value="">— Select Section Type —</option>
                                <option value="1">About Us</option>
                                <option value="2">Services</option>
                                <option value="3">Contact Us</option>
                                <option value="4">Home</option>
                            </select>
                            <div class="invalid-feedback" id="sectionTypeError">Please select a section type.</div>
                        </div>

                        <div class="mb-3">
                            <label for="title" class="form-label">Title <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="title" name="title"
                                   required maxlength="200"
                                   placeholder="Enter section title" />
                            <div class="invalid-feedback" id="titleError">Title is required and must not exceed 200 characters.</div>
                        </div>

                        <div class="mb-3">
                            <label for="content" class="form-label">Content <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="content" name="content" rows="6"
                                      required placeholder="Enter section content"></textarea>
                            <div class="invalid-feedback" id="contentError">Content is required.</div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a href="/MainPageSection" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary" id="submitBtn">
                                <i class="bi bi-check-circle me-1"></i>Create Section
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            var permissions = window.currentUserPermissions || [];

            function hasPerm(perm) {
                return permissions.indexOf(perm) !== -1;
            }

            if (!hasPerm('MainPageSections.Create')) {
                document.body.innerHTML =
                    '<div class="container-fluid py-5 text-center text-danger">' +
                    '<i class="bi bi-shield-exclamation fs-1 d-block mb-3"></i>' +
                    '<h3>Access Denied</h3>' +
                    '<p>You do not have permission to create main page sections.</p>' +
                    '<a href="/MainPageSection" class="btn btn-outline-secondary mt-3">Back to Main Page Sections</a>' +
                    '</div>';
                return;
            }

            var form = document.getElementById('sectionForm');
            var submitBtn = document.getElementById('submitBtn');
            var sectionTypeSelect = document.getElementById('sectionType');
            var titleInput = document.getElementById('title');
            var contentInput = document.getElementById('content');

            // ── Real-time validation ─────────────────────────────────
            sectionTypeSelect.addEventListener('change', function () {
                if (this.value) {
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                } else {
                    this.classList.remove('is-valid');
                    this.classList.add('is-invalid');
                }
            });

            titleInput.addEventListener('input', function () {
                var val = this.value.trim();
                if (val.length > 0 && val.length <= 200) {
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                } else {
                    this.classList.remove('is-valid');
                    if (val.length > 0) {
                        this.classList.add('is-invalid');
                    } else {
                        this.classList.remove('is-invalid');
                    }
                }
            });

            contentInput.addEventListener('input', function () {
                var val = this.value.trim();
                if (val.length > 0) {
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                } else {
                    this.classList.remove('is-valid');
                    this.classList.add('is-invalid');
                }
            });

            // ── Form Submit ──────────────────────────────────────────
            form.addEventListener('submit', function (e) {
                e.preventDefault();

                // Validate
                var sectionType = sectionTypeSelect.value;
                var title = titleInput.value.trim();
                var content = contentInput.value.trim();
                var isValid = true;

                if (!sectionType) {
                    sectionTypeSelect.classList.add('is-invalid');
                    isValid = false;
                } else {
                    sectionTypeSelect.classList.remove('is-invalid');
                    sectionTypeSelect.classList.add('is-valid');
                }

                if (!title || title.length === 0 || title.length > 200) {
                    titleInput.classList.add('is-invalid');
                    isValid = false;
                } else {
                    titleInput.classList.remove('is-invalid');
                    titleInput.classList.add('is-valid');
                }

                if (!content || content.length === 0) {
                    contentInput.classList.add('is-invalid');
                    isValid = false;
                } else {
                    contentInput.classList.remove('is-invalid');
                    contentInput.classList.add('is-valid');
                }

                if (!isValid) return;

                // Disable button
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span>Creating...';

                var dto = {
                    sectionType: parseInt(sectionType, 10),
                    title: title,
                    content: content
                };

                $.ajax({
                    url: '/MainPageSection/Create',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(dto),
                    beforeSend: function () {
                        // button already disabled
                    },
                    success: function (response) {
                        if (typeof window.showToast === 'function') {
                            window.showToast('Main page section created successfully.', 'success');
                        } else {
                            alert('Main page section created successfully.');
                        }
                        window.location.href = '/MainPageSection';
                    },
                    error: function (xhr) {
                        var msg = 'Failed to create main page section.';
                        try {
                            var resp = JSON.parse(xhr.responseText);
                            if (typeof resp === 'string') {
                                msg = resp;
                            } else if (resp && resp.title) {
                                msg = resp.title;
                            } else if (resp && resp.message) {
                                msg = resp.message;
                            } else if (resp && resp.sectionType && resp.sectionType.length > 0) {
                                msg = resp.sectionType[0];
                            } else if (resp && resp.title && resp.title.length > 0) {
                                msg = resp.title[0];
                            } else if (resp && resp.content && resp.content.length > 0) {
                                msg = resp.content[0];
                            }
                        } catch (e) {
                            if (xhr.responseText) {
                                msg = xhr.responseText;
                            }
                        }

                        if (typeof window.showToast === 'function') {
                            window.showToast(msg, 'error');
                        } else {
                            alert(msg);
                        }

                        // Re-enable
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Create Section';
                    },
                    complete: function () {
                        // handled in error/success
                    }
                });
            });

        })();
    </script>
}
