@{
    Layout = "_Layout";
    ViewData["Title"] = "Create User";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <a href="/User" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to Users
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-person-plus-fill me-2"></i>Create New User</h4>
                </div>
                <div class="card-body">
                    <form id="userForm" novalidate>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="username" class="form-label">Username <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="username" name="username"
                                           required maxlength="100"
                                           placeholder="Enter username" />
                                    <div class="invalid-feedback" id="usernameError">Username is required and must not exceed 100 characters.</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="password" class="form-label">Password <span class="text-danger">*</span></label>
                                    <input type="password" class="form-control" id="password" name="password"
                                           required maxlength="255" autocomplete="new-password"
                                           placeholder="Enter password" />
                                    <div class="invalid-feedback" id="passwordError">Password is required and must not exceed 255 characters.</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="roleId" class="form-label">Role <span class="text-danger">*</span></label>
                                    <select class="form-select" id="roleId" name="roleId" required>
                                        <option value="">Loading roles...</option>
                                    </select>
                                    <div class="invalid-feedback" id="roleIdError">Role is required.</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="departmentId" class="form-label">Department <span class="text-danger">*</span></label>
                                    <select class="form-select" id="departmentId" name="departmentId" required>
                                        <option value="">Loading departments...</option>
                                    </select>
                                    <div class="invalid-feedback" id="departmentIdError">Department is required.</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="phoneNumber" class="form-label">Phone Number <span class="text-danger">*</span></label>
                                    <input type="tel" class="form-control" id="phoneNumber" name="phoneNumber"
                                           required maxlength="20" inputmode="tel"
                                           placeholder="e.g. +1 555 123 4567" />
                                    <div class="invalid-feedback" id="phoneNumberError">A valid phone number is required (max 20 characters).</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="startDate" class="form-label">Start Date <span class="text-danger">*</span></label>
                                    <input type="date" class="form-control" id="startDate" name="startDate" required />
                                    <div class="invalid-feedback" id="startDateError">Start date is required.</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="salary" class="form-label">Salary</label>
                                    <input type="number" class="form-control" id="salary" name="salary"
                                           min="0" max="1000000000" step="0.01"
                                           placeholder="0.00" />
                                    <div class="invalid-feedback" id="salaryError">Salary must be greater than or equal to zero.</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3 pt-2">
                                    <div class="form-check form-switch mt-2">
                                        <input class="form-check-input" type="checkbox" id="isActive" name="isActive" checked />
                                        <label class="form-check-label" for="isActive">Is Active</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-3">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="isLeader" name="isLeader" />
                                        <label class="form-check-label" for="isLeader">Is Leader</label>
                                    </div>
                                    <div class="form-text">
                                        Check to make this user the leader (manager) of the selected department.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a href="/User" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary" id="submitBtn">
                                <i class="bi bi-check-circle me-1"></i>Create User
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            var permissions = window.currentUserPermissions || [];

            function hasPerm(perm) {
                return permissions.indexOf(perm) !== -1;
            }

            if (!hasPerm('Users.Create')) {
                document.body.innerHTML =
                    '<div class="container-fluid py-5 text-center text-danger">' +
                    '<i class="bi bi-shield-exclamation fs-1 d-block mb-3"></i>' +
                    '<h3>Access Denied</h3>' +
                    '<p>You do not have permission to create users.</p>' +
                    '<a href="/User" class="btn btn-outline-secondary mt-3">Back to Users</a>' +
                    '</div>';
                return;
            }

            var form = document.getElementById('userForm');
            var submitBtn = document.getElementById('submitBtn');
            var usernameInput = document.getElementById('username');
            var passwordInput = document.getElementById('password');
            var roleSelect = document.getElementById('roleId');
            var departmentSelect = document.getElementById('departmentId');
            var phoneInput = document.getElementById('phoneNumber');
            var startDateInput = document.getElementById('startDate');
            var salaryInput = document.getElementById('salary');
            var isLeaderCheck = document.getElementById('isLeader');
            var isActiveCheck = document.getElementById('isActive');

            // ── Load Roles (FK dropdown: /Role/GetAll) ───────────────
            function loadRoles() {
                roleSelect.innerHTML = '<option value="">Loading roles...</option>';

                $.ajax({
                    url: '/Role/GetAll',
                    type: 'GET',
                    data: { pageNumber: 1, pageSize: 1000, search: '' },
                    beforeSend: function () {
                        // select shows loading option
                    },
                    success: function (response) {
                        var roles = [];
                        if (response && response.data && Array.isArray(response.data)) {
                            roles = response.data;
                        } else if (Array.isArray(response)) {
                            roles = response;
                        } else if (response && response.items && Array.isArray(response.items)) {
                            roles = response.items;
                        } else if (response && response.results && Array.isArray(response.results)) {
                            roles = response.results;
                        }

                        var html = '<option value="">— Select Role —</option>';
                        roles.forEach(function (role) {
                            var value = escapeHtml(role.roleId !== null && role.roleId !== undefined ? role.roleId : '');
                            var label = escapeHtml(role.roleName || ('Role ' + role.roleId));
                            html += '<option value="' + value + '">' + label + '</option>';
                        });

                        roleSelect.innerHTML = html;
                    },
                    error: function () {
                        roleSelect.innerHTML = '<option value="">— Select Role —</option>';
                    },
                    complete: function () {
                        // handled
                    }
                });
            }

            // ── Load Departments (FK dropdown: /Department/GetAll) ────
            function loadDepartments() {
                departmentSelect.innerHTML = '<option value="">Loading departments...</option>';

                $.ajax({
                    url: '/Department/GetAll',
                    type: 'GET',
                    data: { pageNumber: 1, pageSize: 1000, search: '' },
                    beforeSend: function () {
                        // select shows loading option
                    },
                    success: function (response) {
                        var departments = [];
                        if (response && response.data && Array.isArray(response.data)) {
                            departments = response.data;
                        } else if (Array.isArray(response)) {
                            departments = response;
                        } else if (response && response.items && Array.isArray(response.items)) {
                            departments = response.items;
                        } else if (response && response.results && Array.isArray(response.results)) {
                            departments = response.results;
                        }

                        var html = '<option value="">— Select Department —</option>';
                        departments.forEach(function (dept) {
                            var value = escapeHtml(dept.departmentId !== null && dept.departmentId !== undefined ? dept.departmentId : '');
                            var label = escapeHtml(dept.departmentName || ('Department ' + dept.departmentId));
                            html += '<option value="' + value + '">' + label + '</option>';
                        });

                        departmentSelect.innerHTML = html;
                    },
                    error: function () {
                        departmentSelect.innerHTML = '<option value="">— Select Department —</option>';
                    },
                    complete: function () {
                        // handled
                    }
                });
            }

            // ── Real-time validation ─────────────────────────────────
            usernameInput.addEventListener('input', function () {
                var val = this.value.trim();
                if (val.length > 0 && val.length <= 100) {
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                } else {
                    this.classList.remove('is-valid');
                    if (val.length > 0) {
                        this.classList.add('is-invalid');
                    } else {
                        this.classList.remove('is-invalid');
                    }
                }
            });

            passwordInput.addEventListener('input', function () {
                var val = this.value;
                if (val.length > 0 && val.length <= 255) {
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                } else {
                    this.classList.remove('is-valid');
                    if (val.length > 0) {
                        this.classList.add('is-invalid');
                    } else {
                        this.classList.remove('is-invalid');
                    }
                }
            });

            roleSelect.addEventListener('change', function () {
                if (this.value) {
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                } else {
                    this.classList.remove('is-valid');
                    this.classList.add('is-invalid');
                }
            });

            departmentSelect.addEventListener('change', function () {
                if (this.value) {
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                } else {
                    this.classList.remove('is-valid');
                    this.classList.add('is-invalid');
                }
            });

            phoneInput.addEventListener('input', function () {
                var val = this.value.trim();
                if (isValidPhone(val)) {
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                } else {
                    this.classList.remove('is-valid');
                    if (val.length > 0) {
                        this.classList.add('is-invalid');
                    } else {
                        this.classList.remove('is-invalid');
                    }
                }
            });

            startDateInput.addEventListener('change', function () {
                if (this.value) {
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                } else {
                    this.classList.remove('is-valid');
                    this.classList.add('is-invalid');
                }
            });

            salaryInput.addEventListener('input', function () {
                var val = this.value.trim();
                var num = parseFloat(val);
                if (val === '' || (!isNaN(num) && num >= 0 && num <= 1000000000)) {
                    this.classList.remove('is-invalid');
                    if (val !== '') {
                        this.classList.add('is-valid');
                    }
                } else {
                    this.classList.remove('is-valid');
                    this.classList.add('is-invalid');
                }
            });

            function isValidPhone(val) {
                if (!val || val.length < 7 || val.length > 20) return false;
                return /^[0-9+\-().\s]+$/.test(val);
            }

            // ── Form Submit ──────────────────────────────────────────
            form.addEventListener('submit', function (e) {
                e.preventDefault();

                var username = usernameInput.value.trim();
                var password = passwordInput.value;
                var roleId = roleSelect.value;
                var departmentId = departmentSelect.value;
                var phoneNumber = phoneInput.value.trim();
                var startDate = startDateInput.value;
                var salary = salaryInput.value.trim();

                var isValid = true;

                if (!username || username.length === 0 || username.length > 100) {
                    usernameInput.classList.add('is-invalid');
                    isValid = false;
                } else {
                    usernameInput.classList.remove('is-invalid');
                    usernameInput.classList.add('is-valid');
                }

                if (!password || password.length === 0 || password.length > 255) {
                    passwordInput.classList.add('is-invalid');
                    isValid = false;
                } else {
                    passwordInput.classList.remove('is-invalid');
                    passwordInput.classList.add('is-valid');
                }

                if (!roleId) {
                    roleSelect.classList.add('is-invalid');
                    isValid = false;
                } else {
                    roleSelect.classList.remove('is-invalid');
                    roleSelect.classList.add('is-valid');
                }

                if (!departmentId) {
                    departmentSelect.classList.add('is-invalid');
                    isValid = false;
                } else {
                    departmentSelect.classList.remove('is-invalid');
                    departmentSelect.classList.add('is-valid');
                }

                if (!isValidPhone(phoneNumber)) {
                    phoneInput.classList.add('is-invalid');
                    isValid = false;
                } else {
                    phoneInput.classList.remove('is-invalid');
                    phoneInput.classList.add('is-valid');
                }

                if (!startDate) {
                    startDateInput.classList.add('is-invalid');
                    isValid = false;
                } else {
                    startDateInput.classList.remove('is-invalid');
                    startDateInput.classList.add('is-valid');
                }

                if (salary !== '' && (isNaN(parseFloat(salary)) || parseFloat(salary) < 0 || parseFloat(salary) > 1000000000)) {
                    salaryInput.classList.add('is-invalid');
                    isValid = false;
                } else {
                    salaryInput.classList.remove('is-invalid');
                    if (salary !== '') {
                        salaryInput.classList.add('is-valid');
                    }
                }

                if (!isValid) return;

                // Disable button
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span>Creating...';

                var dto = {
                    username: username,
                    password: password,
                    roleId: parseInt(roleId, 10),
                    departmentId: departmentId ? parseInt(departmentId, 10) : null,
                    isLeader: isLeaderCheck.checked,
                    phoneNumber: phoneNumber,
                    startDate: startDate,
                    salary: salary === '' ? 0 : parseFloat(salary),
                    isActive: isActiveCheck.checked
                };

                $.ajax({
                    url: '/User/Create',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(dto),
                    beforeSend: function () {
                        // button already disabled
                    },
                    success: function (response) {
                        if (typeof window.showToast === 'function') {
                            window.showToast('User created successfully.', 'success');
                        } else {
                            alert('User created successfully.');
                        }
                        window.location.href = '/User';
                    },
                    error: function (xhr) {
                        var msg = 'Failed to create user.';
                        try {
                            var resp = JSON.parse(xhr.responseText);
                            if (typeof resp === 'string') {
                                msg = resp;
                            } else if (resp && resp.title) {
                                msg = resp.title;
                            } else if (resp && resp.message) {
                                msg = resp.message;
                            } else if (typeof resp === 'object') {
                                for (var key in resp) {
                                    if (resp.hasOwnProperty(key) && Array.isArray(resp[key]) && resp[key].length > 0) {
                                        msg = resp[key][0];
                                        break;
                                    }
                                }
                            }
                        } catch (e) {
                            if (xhr.responseText) {
                                msg = xhr.responseText;
                            }
                        }

                        if (typeof window.showToast === 'function') {
                            window.showToast(msg, 'error');
                        } else {
                            alert(msg);
                        }

                        // Re-enable
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Create User';
                    },
                    complete: function () {
                        // handled in error/success
                    }
                });
            });

            // ── Helpers ──────────────────────────────────────────────
            function escapeHtml(str) {
                if (!str) return '';
                var div = document.createElement('div');
                div.appendChild(document.createTextNode(str));
                return div.innerHTML;
            }

            // ── Initialize ──────────────────────────────────────────
            $(document).ready(function () {
                loadRoles();
                loadDepartments();
            });

        })();
    </script>
}
