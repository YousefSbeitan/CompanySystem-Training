@{
    ViewData["Title"] = "Create User";
}

<div class="container-fluid">
    <h1 class="h3 mb-3">Create User</h1>

    <div class="card">
        <div class="card-body">
            <form id="createForm" novalidate>
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="createUsername" class="form-label">
                                Username <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control" id="createUsername" name="Username"
                                   maxlength="100" required placeholder="Enter username" />
                            <div class="invalid-feedback">
                                Username is required and must not exceed 100 characters.
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="createPassword" class="form-label">
                                Password <span class="text-danger">*</span>
                            </label>
                            <input type="password"
                                   class="form-control"
                                   id="createPassword"
                                   name="Password"
                                   maxlength="255"
                                   required
                                   placeholder="Enter password" />
                            <div class="invalid-feedback">
                                Password is required and must not exceed 255 characters.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="createRoleId" class="form-label">
                                Role <span class="text-danger">*</span>
                            </label>
                            <select class="form-select" id="createRoleId" name="RoleId" required>
                                <option value="">-- Select Role --</option>
                            </select>
                            <div class="invalid-feedback">
                                Role is required.
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="createDepartmentId" class="form-label">Department</label>
                            <select class="form-select" id="createDepartmentId" name="DepartmentId">
                                <option value="">-- No Department --</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="createPhoneNumber" class="form-label">
                                Phone Number <span class="text-danger">*</span>
                            </label>
                            <input type="tel" class="form-control" id="createPhoneNumber" name="PhoneNumber"
                                   maxlength="20" required placeholder="Enter phone number" />
                            <div class="invalid-feedback">
                                A valid phone number is required (max 20 characters).
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="createStartDate" class="form-label">
                                Start Date <span class="text-danger">*</span>
                            </label>
                            <input type="date" class="form-control" id="createStartDate" name="StartDate" required />
                            <div class="invalid-feedback">
                                Start date is required.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="createSalary" class="form-label">
                                Salary <span class="text-danger">*</span>
                            </label>
                            <input type="number" class="form-control" id="createSalary" name="Salary"
                                   step="0.01" min="0" max="1000000000" required placeholder="0.00" />
                            <div class="invalid-feedback">
                                Salary must be a positive number.
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <div class="form-check mt-4">
                                <input type="checkbox" class="form-check-input" id="createIsLeader" name="IsLeader" />
                                <label class="form-check-label" for="createIsLeader">Is Leader</label>
                            </div>
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="createIsActive" name="IsActive" checked />
                                <label class="form-check-label" for="createIsActive">Is Active</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" id="btnSave">
                        <i class="bi bi-check-lg"></i> Save
                    </button>
                    <a href="/User" class="btn btn-secondary">Cancel</a>
                </div>
            </form>

            <!-- Loading Spinner (hidden) -->
            <div id="loadingSpinner" class="text-center my-3" style="display:none;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Saving...</span>
                </div>
                <p class="mt-2 text-muted">Saving user...</p>
            </div>
        </div>
    </div>

    <!-- Alert Container -->
    <div id="alertContainer" class="mt-3"></div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var currentRole = window.currentUserRole;

            var canCreate =
                currentRole === 'Admin' ||
                currentRole === 'HR';

            if (!canCreate) {
                $('#alertContainer').html(
                    '<div class="alert alert-danger">You do not have permission to create users.</div>'
                );
                $('#btnSave').prop('disabled', true);
                return;
            }

            // ── Load Roles Dropdown ─────────────────────────────────
            function loadRoles() {
                return $.ajax({
                    url: '/Role/GetAll',
                    type: 'GET',
                    data: { pageSize: 100 }
                });
            }

            // ── Load Departments Dropdown ───────────────────────────
            function loadDepartments() {
                return $.ajax({
                    url: '/Department/GetAll',
                    type: 'GET',
                    data: { pageSize: 100 }
                });
            }

            // ── Populate Dropdowns ──────────────────────────────────
            function populateSelect(selectId, items, valueField, textField, defaultText) {
                var select = $(selectId);
                select.empty();
                select.append('<option value="">' + (defaultText || '-- Select --') + '</option>');
                $.each(items, function (idx, item) {
                    var value = item[valueField];
                    var text = item[textField];
                    select.append('<option value="' + value + '">' + escapeHtml(text) + '</option>');
                });
            }

            function escapeHtml(str) {
                if (!str) return '';
                return $('<span>').text(str).html();
            }

            // Load both dropdowns in parallel
            var rolePromise = loadRoles();
            var deptPromise = loadDepartments();

            $.when(rolePromise, deptPromise).done(function (roleResponse, deptResponse) {
                // Process roles
                var roles = roleResponse[0].data || roleResponse[0].items || roleResponse[0].results || roleResponse[0] || [];
                if (Array.isArray(roles)) {
                    populateSelect('#createRoleId', roles, 'roleId', 'roleName', '-- Select Role --');
                }

                // Process departments
                var depts = deptResponse[0].data || deptResponse[0].items || deptResponse[0].results || deptResponse[0] || [];
                if (Array.isArray(depts)) {
                    populateSelect('#createDepartmentId', depts, 'departmentId', 'departmentName', '-- No Department --');
                }
            }).fail(function () {
                $('#alertContainer').html(
                    '<div class="alert alert-danger">Failed to load dropdown data. Please try again.</div>'
                );
            });

            // ── Submit Form ─────────────────────────────────────────
            $('#createForm').on('submit', function (e) {
                e.preventDefault();

                var form = this;
                if (!form.checkValidity()) {
                    form.classList.add('was-validated');
                    return;
                }

                var dto = {
                        username: $('#createUsername').val().trim(),
                        password: $('#createPassword').val(),
                        roleId: parseInt($('#createRoleId').val()),
                        departmentId: $('#createDepartmentId').val()
                        ? parseInt($('#createDepartmentId').val())
                        : null,
                        isLeader: $('#createIsLeader').is(':checked'),
                        phoneNumber: $('#createPhoneNumber').val().trim(),
                        startDate: $('#createStartDate').val(),
                        salary: parseFloat($('#createSalary').val()) || 0,
                        isActive: $('#createIsActive').is(':checked')
                        };

                $('#btnSave').prop('disabled', true);
                $('#loadingSpinner').show();
                $('#alertContainer').empty();

                $.ajax({
                    url: '/User/Create',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(dto),
                    success: function (response) {
                        $('#loadingSpinner').hide();
                        $('#alertContainer').html(
                            '<div class="alert alert-success">User created successfully! Redirecting...</div>'
                        );
                        setTimeout(function () {
                            window.location.href = '/User';
                        }, 1000);
                    },
                    error: function (xhr) {
                        $('#loadingSpinner').hide();
                        $('#btnSave').prop('disabled', false);

                        var msg = 'Failed to create user.';
                        if (xhr.responseJSON) {
                            if (xhr.responseJSON.title) {
                                msg = xhr.responseJSON.title;
                            } else if (xhr.responseJSON.errors) {
                                var errors = xhr.responseJSON.errors;
                                var errorList = [];
                                $.each(errors, function (key, arr) {
                                    $.each(arr, function (i, err) {
                                        errorList.push(err);
                                    });
                                });
                                msg = errorList.join('<br/>');
                            }
                        } else if (xhr.responseText) {
                            msg = xhr.responseText;
                        }

                        $('#alertContainer').html(
                            '<div class="alert alert-danger">' + msg + '</div>'
                        );
                    }
                });
            });
        });
    </script>
}
