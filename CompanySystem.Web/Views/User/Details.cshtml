@{
    ViewData["Title"] = "User Details";
}

<div class="container">
    <h1>User Details</h1>

    <div id="loading-spinner" class="text-center my-4">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>

    <div id="error-alert" class="alert alert-danger d-none" role="alert"></div>

    <div id="user-details" class="d-none">
        <div class="card">
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-sm-3 fw-bold">User ID</div>
                    <div class="col-sm-9" id="detail-userId"></div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-3 fw-bold">Username</div>
                    <div class="col-sm-9" id="detail-username"></div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-3 fw-bold">Role</div>
                    <div class="col-sm-9" id="detail-roleId"></div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-3 fw-bold">Leader</div>
                    <div class="col-sm-9" id="detail-leaderId"></div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-3 fw-bold">Department</div>
                    <div class="col-sm-9" id="detail-departmentId"></div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-3 fw-bold">Phone Number</div>
                    <div class="col-sm-9" id="detail-phoneNumber"></div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-3 fw-bold">Start Date</div>
                    <div class="col-sm-9" id="detail-startDate"></div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-3 fw-bold">Salary</div>
                    <div class="col-sm-9" id="detail-salary"></div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-3 fw-bold">Is Active</div>
                    <div class="col-sm-9" id="detail-isActive"></div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-3 fw-bold">Is Leader</div>
                    <div class="col-sm-9" id="detail-isLeader"></div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-3 fw-bold">Created By</div>
                    <div class="col-sm-9" id="detail-createdBy"></div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-3 fw-bold">Created Date</div>
                    <div class="col-sm-9" id="detail-createdDate"></div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-3 fw-bold">Updated By</div>
                    <div class="col-sm-9" id="detail-updatedBy"></div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-3 fw-bold">Updated Date</div>
                    <div class="col-sm-9" id="detail-updatedDate"></div>
                </div>
            </div>
        </div>

        <div class="mt-3">
            <a id="btn-edit" href="#" class="btn btn-warning">Edit</a>
            <a href="/User" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var id = window.location.pathname.split('/').pop();
            if (!id) {
                $('#loading-spinner').html('<div class="alert alert-danger">Invalid user ID.</div>');
                return;
            }

            $('#btn-edit').attr('href', '/User/Edit/' + encodeURIComponent(id));

            $.getJSON('/User/GetById/' + encodeURIComponent(id))
                .done(function (user) {
                    $('#detail-userId').text(user.userId || '-');
                    $('#detail-username').text(user.username || '-');
                    $('#detail-roleId').text(user.roleId != null ? user.roleId : '-');
                    $('#detail-leaderId').text(user.leaderId || '-');
                    $('#detail-departmentId').text(user.departmentId != null ? user.departmentId : '-');
                    $('#detail-phoneNumber').text(user.phoneNumber || '-');
                    $('#detail-startDate').text(formatDate(user.startDate));
                    $('#detail-salary').text(formatCurrency(user.salary));
                    $('#detail-isActive').text(user.isActive ? 'Yes' : 'No');
                    $('#detail-isLeader').text(user.isLeader ? 'Yes' : 'No');
                    $('#detail-createdBy').text(user.createdBy || '-');
                    $('#detail-createdDate').text(formatDate(user.createdDate));
                    $('#detail-updatedBy').text(user.updatedBy || '-');
                    $('#detail-updatedDate').text(formatDate(user.updatedDate));

                    $('#loading-spinner').addClass('d-none');
                    $('#user-details').removeClass('d-none');
                })
                .fail(function (xhr) {
                    $('#loading-spinner').html('<div class="alert alert-danger">Error loading user: ' + (xhr.responseJSON || xhr.responseText || 'Unknown error') + '</div>');
                });
        });

        function formatDate(dateStr) {
            if (!dateStr) return '-';
            var d = new Date(dateStr);
            if (isNaN(d.getTime())) return dateStr;
            return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
        }

        function formatCurrency(val) {
            if (val == null) return '-';
            return '$' + parseFloat(val).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
    </script>
}
