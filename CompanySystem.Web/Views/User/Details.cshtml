@{
    ViewData["Title"] = "User Details";
}

<div class="container-fluid">
    <h1 class="h3 mb-3">User Details</h1>

    <!-- Loading Spinner -->
    <div id="loadingSpinner" class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2 text-muted">Loading user details...</p>
    </div>

    <!-- Error -->
    <div id="errorAlert" class="alert alert-danger" style="display:none;"></div>

    <!-- Detail Card -->
    <div id="detailCard" class="card" style="display:none;">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-bold">User Information</span>
            <span class="badge bg-secondary" id="detailUserId"></span>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">User ID</dt>
                <dd class="col-sm-9" id="detailUserIdDisplay"></dd>

                <dt class="col-sm-3">Username</dt>
                <dd class="col-sm-9" id="detailUsername"></dd>

                <dt class="col-sm-3">Role</dt>
                <dd class="col-sm-9" id="detailRoleId"></dd>

                <dt class="col-sm-3">Leader</dt>
                <dd class="col-sm-9" id="detailLeaderId"></dd>

                <dt class="col-sm-3">Department</dt>
                <dd class="col-sm-9" id="detailDepartmentId"></dd>

                <dt class="col-sm-3">Phone Number</dt>
                <dd class="col-sm-9" id="detailPhoneNumber"></dd>

                <dt class="col-sm-3">Start Date</dt>
                <dd class="col-sm-9" id="detailStartDate"></dd>

                <dt class="col-sm-3">Salary</dt>
                <dd class="col-sm-9" id="detailSalary"></dd>

                <dt class="col-sm-3">Is Leader</dt>
                <dd class="col-sm-9" id="detailIsLeader"></dd>

                <dt class="col-sm-3">Is Active</dt>
                <dd class="col-sm-9" id="detailIsActive"></dd>

                <dt class="col-sm-3">Created By</dt>
                <dd class="col-sm-9" id="detailCreatedBy"></dd>

                <dt class="col-sm-3">Created Date</dt>
                <dd class="col-sm-9" id="detailCreatedDate"></dd>

                <dt class="col-sm-3">Updated By</dt>
                <dd class="col-sm-9" id="detailUpdatedBy"></dd>

                <dt class="col-sm-3">Updated Date</dt>
                <dd class="col-sm-9" id="detailUpdatedDate"></dd>
            </dl>
        </div>
        <div class="card-footer">
            <a href="/User" class="btn btn-secondary">Back to List</a>
            <button class="btn btn-warning admin-only" id="btnEditFromDetails" style="display:none;">
                <i class="bi bi-pencil"></i> Edit
            </button>
        </div>
    </div>

    <!-- Not Found -->
    <div id="notFoundAlert" class="alert alert-warning" style="display:none;">
        User not found.
    </div>

    <!-- Permission Denied -->
    <div id="permissionDeniedAlert" class="alert alert-danger" style="display:none;">
        You do not have permission to view this user's details.
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var isAdmin = (window.currentUserRole === 'Admin');
            if (isAdmin) {
                $('.admin-only').show();
            }

            // Extract user ID from URL: /User/Details/{id}
            var pathParts = window.location.pathname.split('/');
            var userId = decodeURIComponent(pathParts[pathParts.length - 1]);

            if (!userId) {
                $('#loadingSpinner').hide();
                $('#errorAlert').text('Invalid user ID.').show();
                return;
            }

            $.ajax({
                url: '/User/GetById/' + encodeURIComponent(userId),
                type: 'GET',
                success: function (user) {
                    $('#loadingSpinner').hide();

                    if (!user) {
                        $('#notFoundAlert').show();
                        return;
                    }

                    $('#detailUserId').text('#' + escapeHtml(user.userId || ''));
                    $('#detailUserIdDisplay').text(escapeHtml(user.userId || ''));
                    $('#detailUsername').text(escapeHtml(user.username || ''));
                    $('#detailRoleId').text(user.roleId != null ? user.roleId : '-');
                    $('#detailLeaderId').text(escapeHtml(user.leaderId || '-'));
                    $('#detailDepartmentId').text(user.departmentId != null ? user.departmentId : '-');
                    $('#detailPhoneNumber').text(escapeHtml(user.phoneNumber || '-'));
                    $('#detailStartDate').text(user.startDate ? new Date(user.startDate).toLocaleDateString() : '-');
                    $('#detailSalary').text(user.salary != null ? parseFloat(user.salary).toFixed(2) : '-');
                    $('#detailIsLeader').text(user.isLeader ? 'Yes' : 'No');
                    $('#detailIsActive').text(user.isActive ? 'Yes' : 'No');
                    $('#detailCreatedBy').text(escapeHtml(user.createdBy || '-'));
                    $('#detailCreatedDate').text(user.createdDate ? new Date(user.createdDate).toLocaleString() : '-');
                    $('#detailUpdatedBy').text(escapeHtml(user.updatedBy || '-'));
                    $('#detailUpdatedDate').text(user.updatedDate ? new Date(user.updatedDate).toLocaleString() : '-');

                    if (isAdmin) {
                        $('#btnEditFromDetails').data('id', user.userId).show();
                    }

                    $('#detailCard').show();
                },
                error: function (xhr) {
                    $('#loadingSpinner').hide();
                    if (xhr.status === 404) {
                        $('#notFoundAlert').show();
                    } else if (xhr.status === 403) {
                        $('#permissionDeniedAlert').show();
                    } else {
                        var msg = xhr.responseText || 'An error occurred while loading user details.';
                        $('#errorAlert').text(msg).show();
                    }
                }
            });

            // Edit button on details page
            $(document).on('click', '#btnEditFromDetails', function () {
                var id = $(this).data('id');
                window.location.href = '/User/Edit/' + encodeURIComponent(id);
            });

            function escapeHtml(str) {
                if (!str) return '';
                return $('<span>').text(str).html();
            }
        });
    </script>
}
