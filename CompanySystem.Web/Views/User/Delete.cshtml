@{
    Layout = "_Layout";
    ViewData["Title"] = "Delete User";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <a href="/User" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to Users
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="bi bi-trash-fill me-2"></i>Delete User</h4>
                </div>
                <div class="card-body">
                    <div id="loadingContainer" class="text-center py-5">
                        <div class="spinner-border text-danger" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2 text-muted">Loading user data...</p>
                    </div>

                    <div id="deleteContainer" class="d-none">
                        <div class="alert alert-warning d-flex align-items-center" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                            <div>
                                <strong>Warning:</strong> Are you sure you want to delete this user? This action cannot be undone.
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-bordered">
                                <tbody>
                                    <tr>
                                        <th class="bg-light" style="width:180px;">User ID</th>
                                        <td id="deleteUserId">—</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Username</th>
                                        <td id="deleteUsername"><strong>—</strong></td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Role</th>
                                        <td id="deleteRole">—</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Leader</th>
                                        <td id="deleteLeader">—</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Department</th>
                                        <td id="deleteDepartment">—</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Phone Number</th>
                                        <td id="deletePhone">—</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Start Date</th>
                                        <td id="deleteStartDate">—</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Salary</th>
                                        <td id="deleteSalary">—</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">Status</th>
                                        <td id="deleteStatus">—</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a href="/User" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-1"></i>Cancel
                            </a>
                            <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                                <i class="bi bi-trash-fill me-1"></i>Confirm Delete
                            </button>
                        </div>
                    </div>

                    <div id="errorContainer" class="d-none text-center py-5 text-danger">
                        <i class="bi bi-exclamation-triangle-fill fs-1 d-block mb-3"></i>
                        <h5>Failed to load user data</h5>
                        <p id="errorMessage" class="text-muted"></p>
                        <a href="/User" class="btn btn-outline-secondary mt-2">Back to Users</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            var permissions = window.currentUserPermissions || [];

            function hasPerm(perm) {
                return permissions.indexOf(perm) !== -1;
            }

            if (!hasPerm('Users.Delete')) {
                document.body.innerHTML =
                    '<div class="container-fluid py-5 text-center text-danger">' +
                    '<i class="bi bi-shield-exclamation fs-1 d-block mb-3"></i>' +
                    '<h3>Access Denied</h3>' +
                    '<p>You do not have permission to delete users.</p>' +
                    '<a href="/User" class="btn btn-outline-secondary mt-3">Back to Users</a>' +
                    '</div>';
                return;
            }

            // Get user ID from URL (string ID — do not parseInt)
            var pathParts = window.location.pathname.split('/');
            var userId = decodeURIComponent(pathParts[pathParts.length - 1] || '');

            var loadingContainer = document.getElementById('loadingContainer');
            var deleteContainer = document.getElementById('deleteContainer');
            var errorContainer = document.getElementById('errorContainer');
            var errorMessage = document.getElementById('errorMessage');
            var confirmBtn = document.getElementById('confirmDeleteBtn');

            // ── FK Lookup Maps (Role / Department / User) ────────────
            var roleMap = {};
            var deptMap = {};
            var userMap = {};

            function loadLookups(callback) {
                var pending = 3;

                function checkDone() {
                    pending--;
                    if (pending <= 0 && typeof callback === 'function') {
                        callback();
                    }
                }

                // Roles: GET /Role/GetAll
                $.ajax({
                    url: '/Role/GetAll',
                    type: 'GET',
                    data: { pageNumber: 1, pageSize: 1000, search: '' },
                    beforeSend: function () { },
                    success: function (response) {
                        var roles = [];
                        if (response && response.data && Array.isArray(response.data)) {
                            roles = response.data;
                        } else if (Array.isArray(response)) {
                            roles = response;
                        } else if (response && response.items && Array.isArray(response.items)) {
                            roles = response.items;
                        } else if (response && response.results && Array.isArray(response.results)) {
                            roles = response.results;
                        }
                        roles.forEach(function (role) {
                            if (role && role.roleId !== null && role.roleId !== undefined) {
                                roleMap[role.roleId] = role.roleName || ('Role ' + role.roleId);
                            }
                        });
                    },
                    error: function () {
                        // Lookup is best-effort; raw IDs shown as fallback
                    },
                    complete: function () {
                        checkDone();
                    }
                });

                // Departments: GET /Department/GetAll
                $.ajax({
                    url: '/Department/GetAll',
                    type: 'GET',
                    data: { pageNumber: 1, pageSize: 1000, search: '' },
                    beforeSend: function () { },
                    success: function (response) {
                        var departments = [];
                        if (response && response.data && Array.isArray(response.data)) {
                            departments = response.data;
                        } else if (Array.isArray(response)) {
                            departments = response;
                        } else if (response && response.items && Array.isArray(response.items)) {
                            departments = response.items;
                        } else if (response && response.results && Array.isArray(response.results)) {
                            departments = response.results;
                        }
                        departments.forEach(function (dept) {
                            if (dept && dept.departmentId !== null && dept.departmentId !== undefined) {
                                deptMap[dept.departmentId] = dept.departmentName || ('Department ' + dept.departmentId);
                            }
                        });
                    },
                    error: function () {
                        // Lookup is best-effort; raw IDs shown as fallback
                    },
                    complete: function () {
                        checkDone();
                    }
                });

                // Users (leaders): GET /User/GetAll
                $.ajax({
                    url: '/User/GetAll',
                    type: 'GET',
                    data: { pageNumber: 1, pageSize: 1000, search: '' },
                    beforeSend: function () { },
                    success: function (response) {
                        var users = [];
                        if (response && response.data && Array.isArray(response.data)) {
                            users = response.data;
                        } else if (Array.isArray(response)) {
                            users = response;
                        } else if (response && response.items && Array.isArray(response.items)) {
                            users = response.items;
                        } else if (response && response.results && Array.isArray(response.results)) {
                            users = response.results;
                        }
                        users.forEach(function (user) {
                            if (user && user.userId) {
                                userMap[user.userId] = user.username || user.userId;
                            }
                        });
                    },
                    error: function () {
                        // Lookup is best-effort; raw IDs shown as fallback
                    },
                    complete: function () {
                        checkDone();
                    }
                });
            }

            // ── Load User Data ───────────────────────────────────────
            function loadUser() {
                if (!userId) {
                    showError('Invalid user ID.');
                    return;
                }

                $.ajax({
                    url: '/User/GetById/' + userId,
                    type: 'GET',
                    beforeSend: function () {
                        loadingContainer.classList.remove('d-none');
                        deleteContainer.classList.add('d-none');
                        errorContainer.classList.add('d-none');
                        confirmBtn.disabled = false;
                        confirmBtn.innerHTML = '<i class="bi bi-trash-fill me-1"></i>Confirm Delete';
                    },
                    success: function (response) {
                        loadingContainer.classList.add('d-none');

                        var user = response;
                        if (response && response.data) {
                            user = response.data;
                        }

                        if (!user || !user.userId) {
                            showError('User not found.');
                            return;
                        }

                        document.getElementById('deleteUserId').textContent = user.userId || '—';
                        document.getElementById('deleteUsername').textContent = user.username || '—';

                        var roleName = (user.roleId !== null && user.roleId !== undefined && roleMap[user.roleId])
                            ? roleMap[user.roleId]
                            : (user.roleId ? String(user.roleId) : '—');
                        document.getElementById('deleteRole').textContent = roleName;

                        var leaderName = (user.leaderId && userMap[user.leaderId])
                            ? userMap[user.leaderId]
                            : (user.leaderId ? user.leaderId : '—');
                        document.getElementById('deleteLeader').textContent = leaderName;

                        var deptName = (user.departmentId !== null && user.departmentId !== undefined && deptMap[user.departmentId])
                            ? deptMap[user.departmentId]
                            : (user.departmentId ? String(user.departmentId) : '—');
                        document.getElementById('deleteDepartment').textContent = deptName;

                        document.getElementById('deletePhone').textContent = user.phoneNumber || '—';
                        document.getElementById('deleteStartDate').textContent = user.startDate ? formatDateOnly(user.startDate) : '—';
                        document.getElementById('deleteSalary').textContent = formatCurrency(user.salary);

                        var statusHtml = '';
                        if (user.isActive) {
                            statusHtml += '<span class="badge bg-success">Active</span>';
                        } else {
                            statusHtml += '<span class="badge bg-secondary">Inactive</span>';
                        }
                        if (user.isLeader) {
                            statusHtml += ' <span class="badge bg-info text-white">Leader</span>';
                        }
                        document.getElementById('deleteStatus').innerHTML = statusHtml;

                        deleteContainer.classList.remove('d-none');
                    },
                    error: function (xhr) {
                        loadingContainer.classList.add('d-none');
                        errorContainer.classList.remove('d-none');
                        var msg = 'Failed to load user data.';
                        if (xhr.status === 403) {
                            msg = 'You do not have permission to access this user.';
                        } else {
                            try {
                                msg = JSON.parse(xhr.responseText) || msg;
                            } catch (e) {
                                msg = xhr.responseText || msg;
                            }
                        }
                        errorMessage.textContent = msg;

                        if (typeof window.showToast === 'function') {
                            window.showToast(msg, 'error');
                        }
                    },
                    complete: function () {
                        // handled
                    }
                });
            }

            function showError(msg) {
                loadingContainer.classList.add('d-none');
                errorContainer.classList.remove('d-none');
                errorMessage.textContent = msg;
            }

            function formatDateOnly(dateStr) {
                if (!dateStr) return '—';
                try {
                    var d = new Date(dateStr);
                    if (isNaN(d.getTime())) return dateStr;
                    return d.toLocaleDateString();
                } catch (e) {
                    return dateStr;
                }
            }

            function formatCurrency(val) {
                if (val === null || val === undefined || val === '') return '—';
                var n = parseFloat(val);
                if (isNaN(n)) return val;
                return n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            // ── Confirm Delete ───────────────────────────────────────
            confirmBtn.addEventListener('click', function () {
                if (!confirm('Are you sure you want to delete this user? This action cannot be undone.')) {
                    return;
                }

                confirmBtn.disabled = true;
                confirmBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span>Deleting...';

                $.ajax({
                    url: '/User/Delete/' + userId,
                    type: 'DELETE',
                    beforeSend: function () {
                        // button disabled
                    },
                    success: function (response) {
                        var msg = 'User deleted successfully.';
                        if (response && response.message) {
                            msg = response.message;
                        }

                        if (typeof window.showToast === 'function') {
                            window.showToast(msg, 'success');
                        } else {
                            alert(msg);
                        }
                        window.location.href = '/User';
                    },
                    error: function (xhr) {
                        var msg = 'Failed to delete user.';
                        if (xhr.status === 403) {
                            msg = 'You do not have permission to delete this user.';
                        } else {
                            try {
                                var resp = JSON.parse(xhr.responseText);
                                if (typeof resp === 'string') {
                                    msg = resp;
                                } else if (resp && resp.title) {
                                    msg = resp.title;
                                } else if (resp && resp.message) {
                                    msg = resp.message;
                                }
                            } catch (e) {
                                if (xhr.responseText) {
                                    msg = xhr.responseText;
                                }
                            }
                        }

                        if (typeof window.showToast === 'function') {
                            window.showToast(msg, 'error');
                        } else {
                            alert(msg);
                        }

                        confirmBtn.disabled = false;
                        confirmBtn.innerHTML = '<i class="bi bi-trash-fill me-1"></i>Confirm Delete';
                    },
                    complete: function () {
                        // handled
                    }
                });
            });

            // ── Initialize ──────────────────────────────────────────
            $(document).ready(function () {
                loadLookups(loadUser);
            });

        })();
    </script>
}
