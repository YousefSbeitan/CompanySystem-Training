@{
    ViewData["Title"] = "Delete User";
}

<div class="container-fluid">
    <h1 class="h3 mb-3">Delete User</h1>

    <!-- Loading Spinner -->
    <div id="loadingSpinner" class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2 text-muted">Loading user data...</p>
    </div>

    <!-- Error -->
    <div id="errorAlert" class="alert alert-danger" style="display:none;"></div>
    <div id="notFoundAlert" class="alert alert-warning" style="display:none;">User not found.</div>

    <!-- Delete Confirmation Card -->
    <div class="card border-danger" id="deleteCard" style="display:none;">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Confirm Deletion</h5>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <strong>Warning:</strong> This action cannot be undone. Are you sure you want to delete this user?
            </div>

            <dl class="row">
                <dt class="col-sm-3">User ID</dt>
                <dd class="col-sm-9" id="deleteUserId"></dd>

                <dt class="col-sm-3">Username</dt>
                <dd class="col-sm-9" id="deleteUsername"></dd>

                <dt class="col-sm-3">Role</dt>
                <dd class="col-sm-9" id="deleteRoleId"></dd>

                <dt class="col-sm-3">Phone Number</dt>
                <dd class="col-sm-9" id="deletePhoneNumber"></dd>

                <dt class="col-sm-3">Start Date</dt>
                <dd class="col-sm-9" id="deleteStartDate"></dd>

                <dt class="col-sm-3">Salary</dt>
                <dd class="col-sm-9" id="deleteSalary"></dd>

                <dt class="col-sm-3">Is Active</dt>
                <dd class="col-sm-9" id="deleteIsActive"></dd>

                <dt class="col-sm-3">Created By</dt>
                <dd class="col-sm-9" id="deleteCreatedBy"></dd>

                <dt class="col-sm-3">Created Date</dt>
                <dd class="col-sm-9" id="deleteCreatedDate"></dd>
            </dl>

            <div class="d-flex gap-2">
                <button class="btn btn-danger" id="btnConfirmDelete">
                    <i class="bi bi-trash"></i> Delete
                </button>
                <a href="/User" class="btn btn-secondary">Cancel</a>
            </div>
        </div>
    </div>

    <!-- Deleting Spinner -->
    <div id="deletingSpinner" class="text-center my-3" style="display:none;">
        <div class="spinner-border text-danger" role="status">
            <span class="visually-hidden">Deleting...</span>
        </div>
        <p class="mt-2 text-muted">Deleting user...</p>
    </div>

    <!-- Alert Container -->
    <div id="alertContainer" class="mt-3"></div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var permissions = window.currentUserPermissions || [];
            var userRole = window.currentUserRole || '';

            function hasPermission(perm) {
                if (permissions.length > 0) return permissions.indexOf(perm) !== -1;
                return userRole === 'Admin';
            }

            if (!hasPermission('Users.Delete')) {
                $('#loadingSpinner').hide();
                $('#alertContainer').html(
                    '<div class="alert alert-danger">You do not have permission to delete users.</div>'
                );
                return;
            }

            // Extract user ID from URL: /User/Delete/{id}
            var pathParts = window.location.pathname.split('/');
            var userId = decodeURIComponent(pathParts[pathParts.length - 1]);

            if (!userId) {
                $('#loadingSpinner').hide();
                $('#errorAlert').text('Invalid user ID.').show();
                return;
            }

            // Load user data
            $.ajax({
                url: '/User/GetById/' + encodeURIComponent(userId),
                type: 'GET',
                success: function (user) {
                    $('#loadingSpinner').hide();

                    if (!user) {
                        $('#notFoundAlert').show();
                        return;
                    }

                    $('#deleteUserId').text(escapeHtml(user.userId || ''));
                    $('#deleteUsername').text(escapeHtml(user.username || ''));
                    $('#deleteRoleId').text(user.roleId != null ? user.roleId : '-');
                    $('#deletePhoneNumber').text(escapeHtml(user.phoneNumber || '-'));
                    $('#deleteStartDate').text(user.startDate ? new Date(user.startDate).toLocaleDateString() : '-');
                    $('#deleteSalary').text(user.salary != null ? parseFloat(user.salary).toFixed(2) : '-');
                    $('#deleteIsActive').text(user.isActive ? 'Yes' : 'No');
                    $('#deleteCreatedBy').text(escapeHtml(user.createdBy || '-'));
                    $('#deleteCreatedDate').text(user.createdDate ? new Date(user.createdDate).toLocaleString() : '-');

                    $('#deleteCard').show();
                },
                error: function (xhr) {
                    $('#loadingSpinner').hide();
                    if (xhr.status === 404) {
                        $('#notFoundAlert').show();
                    } else {
                        var msg = xhr.responseText || 'Failed to load user.';
                        $('#errorAlert').text(msg).show();
                    }
                }
            });

            // Confirm delete
            $('#btnConfirmDelete').on('click', function () {
                var id = $('#deleteUserId').text();

                if (!id) {
                    $('#alertContainer').html(
                        '<div class="alert alert-danger">Invalid user ID. Cannot delete.</div>'
                    );
                    return;
                }

                $('#btnConfirmDelete').prop('disabled', true);
                $('#deletingSpinner').show();
                $('#alertContainer').empty();

                $.ajax({
                    url: '/User/Delete/' + encodeURIComponent(id),
                    type: 'DELETE',
                    success: function (response) {
                        $('#deletingSpinner').hide();
                        var message = (response && response.message) ? response.message : 'User deleted successfully!';
                        $('#alertContainer').html(
                            '<div class="alert alert-success">' + message + ' Redirecting...</div>'
                        );
                        setTimeout(function () {
                            window.location.href = '/User';
                        }, 1000);
                    },
                    error: function (xhr) {
                        $('#deletingSpinner').hide();
                        $('#btnConfirmDelete').prop('disabled', false);

                        var msg = 'Failed to delete user.';
                        if (xhr.responseJSON) {
                            if (xhr.responseJSON.title) {
                                msg = xhr.responseJSON.title;
                            } else if (xhr.responseJSON.message) {
                                msg = xhr.responseJSON.message;
                            }
                        } else if (xhr.responseText) {
                            msg = xhr.responseText;
                        }

                        $('#alertContainer').html(
                            '<div class="alert alert-danger">' + msg + '</div>'
                        );
                    }
                });
            });

            function escapeHtml(str) {
                if (!str) return '';
                return $('<span>').text(str).html();
            }
        });
    </script>
}
