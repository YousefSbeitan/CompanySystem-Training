@{
    ViewData["Title"] = "Users";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">Users</h1>
        <a href="/User/Create" class="btn btn-primary">+ Create User</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>User ID</th>
                    <th>Username</th>
                    <th>Role</th>
                    <th>Department</th>
                    <th>Phone Number</th>
                    <th>Start Date</th>
                    <th>Salary</th>
                    <th>Active</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="user-table-body">
                <tr>
                    <td colspan="9" class="text-center text-muted">Loading...</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            loadUsers();
        });

        function loadUsers() {
            $.getJSON('/User/GetAll')
                .done(function (users) {
                    var tbody = $('#user-table-body');
                    tbody.empty();

                    if (!users || users.length === 0) {
                        tbody.append('<tr><td colspan="9" class="text-center text-muted">No users found.</td></tr>');
                        return;
                    }

                    $.each(users, function (i, user) {
                        var row = '<tr>' +
                            '<td>' + escapeHtml(user.userId) + '</td>' +
                            '<td>' + escapeHtml(user.username) + '</td>' +
                            '<td>' + escapeHtml(user.roleId) + '</td>' +
                            '<td>' + (user.departmentId ? escapeHtml(user.departmentId) : '<span class="text-muted">-</span>') + '</td>' +
                            '<td>' + escapeHtml(user.phoneNumber) + '</td>' +
                            '<td>' + formatDate(user.startDate) + '</td>' +
                            '<td>' + formatCurrency(user.salary) + '</td>' +
                            '<td>' + (user.isActive ? '<span class="badge bg-success">Yes</span>' : '<span class="badge bg-secondary">No</span>') + '</td>' +
                            '<td>' +
                            '<a href="/User/Details/' + encodeURIComponent(user.userId) + '" class="btn btn-sm btn-info me-1" title="Details">👁</a>' +
                            '<a href="/User/Edit/' + encodeURIComponent(user.userId) + '" class="btn btn-sm btn-warning me-1" title="Edit">✏️</a>' +
                            '<a href="/User/Delete/' + encodeURIComponent(user.userId) + '" class="btn btn-sm btn-danger" title="Delete">🗑</a>' +
                            '</td>' +
                            '</tr>';
                        tbody.append(row);
                    });
                })
                .fail(function (xhr) {
                    $('#user-table-body').html('<tr><td colspan="9" class="text-center text-danger">Error loading users: ' + (xhr.responseJSON || xhr.responseText || 'Unknown error') + '</td></tr>');
                });
        }

        function escapeHtml(str) {
            if (!str) return '';
            return $('<span>').text(str).html();
        }

        function formatDate(dateStr) {
            if (!dateStr) return '-';
            var d = new Date(dateStr);
            if (isNaN(d.getTime())) return dateStr;
            return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
        }

        function formatCurrency(val) {
            if (val == null) return '-';
            return '$' + parseFloat(val).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
    </script>
}
