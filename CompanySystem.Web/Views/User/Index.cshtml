@{
    ViewData["Title"] = "User Management";
}

<div class="crud-container">
    <div class="crud-header">
        <h1><i class="bi bi-people-fill me-2"></i>User Management</h1>
        <button class="btn btn-primary admin-only" id="btnCreate" style="display:none;">
            <i class="bi bi-plus-lg"></i> Create User
        </button>
    </div>

    <!-- Search & Filter -->
    <div class="search-filter-row">
        <div class="search-group">
            <div class="input-group">
                <input type="text" class="form-control" id="inputSearch" placeholder="Search by username, phone..." />
                <button class="btn btn-outline-secondary" type="button" id="btnSearch">
                    <i class="bi bi-search"></i> Search
                </button>
                <button class="btn btn-outline-secondary" type="button" id="btnClear">
                    <i class="bi bi-x-circle"></i> Clear
                </button>
            </div>
        </div>
        <div class="page-size-group">
            <select class="form-select" id="selectPageSize">
                <option value="5">5 per page</option>
                <option value="10" selected>10 per page</option>
                <option value="20">20 per page</option>
                <option value="50">50 per page</option>
            </select>
        </div>
    </div>

    <!-- Alerts -->
    <div id="errorAlert" class="alert alert-danger crud-alert" style="display:none;"></div>

    <!-- Loading Spinner -->
    <div class="page-loading" id="loadingSpinner" style="display:none;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p>Loading users...</p>
    </div>

    <!-- Table -->
    <div class="crud-table">
        <div class="table-responsive-custom">
            <table class="table table-hover table-striped" id="usersTable" style="display:none;">
                <thead>
                    <tr>
                        <th data-sort="UserId" class="sortable" style="cursor:pointer; width:200px;">
                            User ID <span class="sort-icon"></span>
                        </th>
                        <th data-sort="Username" class="sortable" style="cursor:pointer;">
                            Username <span class="sort-icon"></span>
                        </th>
                        <th data-sort="RoleId" class="sortable" style="cursor:pointer;">
                            Role <span class="sort-icon"></span>
                        </th>
                        <th data-sort="PhoneNumber" class="sortable" style="cursor:pointer;">
                            Phone <span class="sort-icon"></span>
                        </th>
                        <th data-sort="StartDate" class="sortable" style="cursor:pointer;">
                            Start Date <span class="sort-icon"></span>
                        </th>
                        <th data-sort="Salary" class="sortable" style="cursor:pointer;">
                            Salary <span class="sort-icon"></span>
                        </th>
                        <th data-sort="IsActive" class="sortable" style="cursor:pointer;">
                            Active <span class="sort-icon"></span>
                        </th>
                        <th data-sort="CreatedDate" class="sortable" style="cursor:pointer;">
                            Created Date <span class="sort-icon"></span>
                        </th>
                        <th style="width:200px;">Actions</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    <nav id="paginationNav" class="mt-3" style="display:none;">
        <ul class="pagination justify-content-center" id="paginationUl">
        </ul>
    </nav>

    <!-- No Data -->
    <div class="empty-state" id="noData" style="display:none;">
        <i class="bi bi-people empty-icon"></i>
        <h4>No Users Found</h4>
        <p>There are no users in the system yet.</p>
        <button class="btn btn-primary admin-only" id="btnCreateEmpty" style="display:none;">
            <i class="bi bi-plus-lg"></i> Create User
        </button>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // ── State ────────────────────────────────────────────────
            var currentPage = 1;
            var currentPageSize = 10;
            var currentSearch = '';
            var currentSortBy = 'UserId';
            var currentIsDescending = false;
            var permissions = window.currentUserPermissions || [];
            var userRole = window.currentUserRole || '';

            function hasPermission(perm) {
                if (permissions.length > 0) return permissions.indexOf(perm) !== -1;
                return userRole === 'Admin' || userRole === 'HR';
            }

            // ── Initial Permission Visibility ───────────────────────
            if (hasPermission('Users.Create')) {
                $('.admin-only').show();
            }

            function showToast(msg, type) {
                if (window.showToast) {
                    window.showToast(msg, type);
                } else if (window.auth && window.auth.showNotification) {
                    window.auth.showNotification(msg, type === 'success' ? 'success' : 'error');
                }
            }

            // ── Load Data ───────────────────────────────────────────
            function loadUsers() {
                $('#loadingSpinner').show();
                $('#usersTable').hide();
                $('#paginationNav').hide();
                $('#noData').hide();
                $('#errorAlert').hide();

                $.ajax({
                    url: '/User/GetAll',
                    type: 'GET',
                    data: {
                        pageNumber: currentPage,
                        pageSize: currentPageSize,
                        search: currentSearch,
                        sortBy: currentSortBy,
                        isDescending: currentIsDescending
                    },
                    success: function (response) {
                        $('#loadingSpinner').hide();

                        var data = response.data || response.items || response.results || response || [];
                        var totalPages = response.totalPages || 0;
                        var pageNumber = response.pageNumber || currentPage;

                        if (Array.isArray(data) && data.length > 0) {
                            renderTable(data);
                            renderPagination(totalPages, pageNumber);
                            $('#usersTable').show();
                            $('#paginationNav').show();
                        } else {
                            $('#noData').show();
                        }
                    },
                    error: function (xhr) {
                        $('#loadingSpinner').hide();
                        var msg = xhr.responseText || 'An error occurred while loading users.';
                        if (xhr.status === 403) {
                            msg = 'You do not have permission to view the user list.';
                        }
                        $('#errorAlert').text(msg).show();
                    }
                });
            }

            // ── Render Table ────────────────────────────────────────
            function renderTable(users) {
                var html = '';
                $.each(users, function (idx, user) {
                    var startDate = user.startDate
                        ? new Date(user.startDate).toLocaleDateString()
                        : '-';
                    var createdDate = user.createdDate
                        ? new Date(user.createdDate).toLocaleDateString()
                        : '-';
                    var salary = user.salary != null
                        ? parseFloat(user.salary).toFixed(2)
                        : '-';
                    var isActive = user.isActive
                        ? '<span class="badge bg-success">Yes</span>'
                        : '<span class="badge bg-secondary">No</span>';

                    html += '<tr>';
                    html += '<td><code>' + escapeHtml(user.userId || '') + '</code></td>';
                    html += '<td><strong>' + escapeHtml(user.username || '') + '</strong></td>';
                    html += '<td>' + escapeHtml(user.roleId != null ? user.roleId.toString() : '-') + '</td>';
                    html += '<td>' + escapeHtml(user.phoneNumber || '-') + '</td>';
                    html += '<td>' + startDate + '</td>';
                    html += '<td>' + salary + '</td>';
                    html += '<td>' + isActive + '</td>';
                    html += '<td>' + createdDate + '</td>';
                    html += '<td><div class="action-btns">';
                    html += '<button class="btn btn-sm btn-info btn-details" data-id="' + escapeHtml(user.userId) + '" title="Details"><i class="bi bi-eye"></i></button>';
                    if (hasPermission('Users.Edit')) {
                        html += '<button class="btn btn-sm btn-warning btn-edit" data-id="' + escapeHtml(user.userId) + '" title="Edit"><i class="bi bi-pencil"></i></button>';
                    }
                    if (hasPermission('Users.Delete')) {
                        html += '<button class="btn btn-sm btn-danger btn-delete" data-id="' + escapeHtml(user.userId) + '" title="Delete"><i class="bi bi-trash"></i></button>';
                    }
                    html += '</div></td>';
                    html += '</tr>';
                });
                $('#tableBody').html(html);
            }

            // ── Render Pagination ───────────────────────────────────
            function renderPagination(totalPages, pageNumber) {
                var ul = $('#paginationUl');
                ul.empty();

                if (totalPages <= 1) {
                    $('#paginationNav').hide();
                    return;
                }
                $('#paginationNav').show();

                ul.append('<li class="page-item' + (pageNumber <= 1 ? ' disabled' : '') + '"><a class="page-link" href="#" data-page="' + (pageNumber - 1) + '"><i class="bi bi-chevron-left"></i></a></li>');

                for (var i = 1; i <= totalPages; i++) {
                    ul.append('<li class="page-item' + (i === pageNumber ? ' active' : '') + '"><a class="page-link" href="#" data-page="' + i + '">' + i + '</a></li>');
                }

                ul.append('<li class="page-item' + (pageNumber >= totalPages ? ' disabled' : '') + '"><a class="page-link" href="#" data-page="' + (pageNumber + 1) + '"><i class="bi bi-chevron-right"></i></a></li>');
            }

            // ── Helpers ─────────────────────────────────────────────
            function escapeHtml(str) {
                if (!str) return '';
                return $('<span>').text(str).html();
            }

            function updateSortIcon() {
                $('.sortable .sort-icon').text('');
                $('.sortable').each(function () {
                    var col = $(this).data('sort');
                    if (col === currentSortBy) {
                        $(this).find('.sort-icon').text(currentIsDescending ? ' ▲' : ' ▼');
                    }
                });
            }

            // ── Sort Click ──────────────────────────────────────────
            $(document).on('click', '.sortable', function () {
                var col = $(this).data('sort');
                if (col === currentSortBy) {
                    currentIsDescending = !currentIsDescending;
                } else {
                    currentSortBy = col;
                    currentIsDescending = false;
                }
                currentPage = 1;
                updateSortIcon();
                loadUsers();
            });

            // ── Pagination Click ────────────────────────────────────
            $(document).on('click', '.page-link', function (e) {
                e.preventDefault();
                var page = parseInt($(this).data('page'));
                if (page && page > 0) {
                    currentPage = page;
                    loadUsers();
                }
            });

            // ── Search ──────────────────────────────────────────────
            $('#btnSearch').on('click', function () {
                currentSearch = $('#inputSearch').val().trim();
                currentPage = 1;
                loadUsers();
            });

            $('#inputSearch').on('keypress', function (e) {
                if (e.which === 13) {
                    $('#btnSearch').click();
                }
            });

            $('#btnClear').on('click', function () {
                $('#inputSearch').val('');
                currentSearch = '';
                currentPage = 1;
                loadUsers();
            });

            // ── Page Size ───────────────────────────────────────────
            $('#selectPageSize').on('change', function () {
                currentPageSize = parseInt($(this).val());
                currentPage = 1;
                loadUsers();
            });

            // ── Create ──────────────────────────────────────────────
            $('#btnCreate, #btnCreateEmpty').on('click', function () {
                window.location.href = '/User/Create';
            });

            // ── Details ─────────────────────────────────────────────
            $(document).on('click', '.btn-details', function () {
                var id = $(this).data('id');
                window.location.href = '/User/Details/' + encodeURIComponent(id);
            });

            // ── Edit ────────────────────────────────────────────────
            $(document).on('click', '.btn-edit', function () {
                var id = $(this).data('id');
                window.location.href = '/User/Edit/' + encodeURIComponent(id);
            });

            // ── Delete ──────────────────────────────────────────────
            $(document).on('click', '.btn-delete', function () {
                var id = $(this).data('id');
                window.location.href = '/User/Delete/' + encodeURIComponent(id);
            });

            // ── Initial Load ────────────────────────────────────────
            updateSortIcon();
            loadUsers();
        });
    </script>
}

