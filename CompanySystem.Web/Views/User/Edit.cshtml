@{
    ViewData["Title"] = "Edit User";
}

<div class="container-fluid">
    <h1 class="h3 mb-3">Edit User</h1>

    <!-- Loading Spinner -->
    <div id="loadingSpinner" class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2 text-muted">Loading user data...</p>
    </div>

    <!-- Error -->
    <div id="errorAlert" class="alert alert-danger" style="display:none;"></div>
    <div id="notFoundAlert" class="alert alert-warning" style="display:none;">User not found.</div>

    <!-- Edit Form -->
    <div class="card" id="editCard" style="display:none;">
        <div class="card-body">
            <form id="editForm" novalidate>
                <input type="hidden" id="editUserId" />

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="editUsername" class="form-label">
                                Username <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control" id="editUsername" name="Username"
                                   maxlength="100" required placeholder="Enter username" />
                            <div class="invalid-feedback">
                                Username is required and must not exceed 100 characters.
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="editRoleId" class="form-label">
                                Role <span class="text-danger">*</span>
                            </label>
                            <select class="form-select" id="editRoleId" name="RoleId" required>
                                <option value="">-- Select Role --</option>
                            </select>
                            <div class="invalid-feedback">
                                Role is required.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="editLeaderId" class="form-label">Leader</label>
                            <select class="form-select" id="editLeaderId" name="LeaderId">
                                <option value="">-- No Leader --</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="editDepartmentId" class="form-label">Department</label>
                            <select class="form-select" id="editDepartmentId" name="DepartmentId">
                                <option value="">-- No Department --</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="editPhoneNumber" class="form-label">
                                Phone Number <span class="text-danger">*</span>
                            </label>
                            <input type="tel" class="form-control" id="editPhoneNumber" name="PhoneNumber"
                                   maxlength="20" required placeholder="Enter phone number" />
                            <div class="invalid-feedback">
                                A valid phone number is required (max 20 characters).
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="editStartDate" class="form-label">
                                Start Date <span class="text-danger">*</span>
                            </label>
                            <input type="date" class="form-control" id="editStartDate" name="StartDate" required />
                            <div class="invalid-feedback">
                                Start date is required.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="editSalary" class="form-label">
                                Salary <span class="text-danger">*</span>
                            </label>
                            <input type="number" class="form-control" id="editSalary" name="Salary"
                                   step="0.01" min="0" max="1000000000" required placeholder="0.00" />
                            <div class="invalid-feedback">
                                Salary must be a positive number.
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <div class="form-check mt-4">
                                <input type="checkbox" class="form-check-input" id="editIsLeader" name="IsLeader" />
                                <label class="form-check-label" for="editIsLeader">Is Leader</label>
                            </div>
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="editIsActive" name="IsActive" />
                                <label class="form-check-label" for="editIsActive">Is Active</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary admin-only" id="btnSave" style="display:none;">
                        <i class="bi bi-check-lg"></i> Save Changes
                    </button>
                    <a href="/User" class="btn btn-secondary">Cancel</a>
                </div>
            </form>

            <!-- Saving Spinner (hidden) -->
            <div id="savingSpinner" class="text-center my-3" style="display:none;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Saving...</span>
                </div>
                <p class="mt-2 text-muted">Saving changes...</p>
            </div>
        </div>
    </div>

    <!-- Alert Container -->
    <div id="alertContainer" class="mt-3"></div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var permissions = window.currentUserPermissions || [];
            var userRole = window.currentUserRole || '';

            function hasPermission(perm) {
                if (permissions.length > 0) return permissions.indexOf(perm) !== -1;
                return userRole === 'Admin';
            }

            // ── Permission Visibility ──────────────────────────────
            if (hasPermission('Users.Edit')) {
                $('.admin-only').show();
            } else {
                $('#alertContainer').html(
                    '<div class="alert alert-warning">You can view this page, but only Administrators can save changes.</div>'
                );
            }

            // Extract user ID from URL: /User/Edit/{id}
            var pathParts = window.location.pathname.split('/');
            var userId = decodeURIComponent(pathParts[pathParts.length - 1]);

            if (!userId) {
                $('#loadingSpinner').hide();
                $('#errorAlert').text('Invalid user ID.').show();
                return;
            }

            // ── Load Dropdown Data ──────────────────────────────────
            var rolesLoaded = false;
            var departmentsLoaded = false;
            var usersLoaded = false;
            var userData = null;

            function loadRoles() {
                return $.ajax({
                    url: '/Role/GetAll',
                    type: 'GET',
                    data: { pageSize: 100 }
                });
            }

            function loadDepartments() {
                return $.ajax({
                    url: '/Department/GetAll',
                    type: 'GET',
                    data: { pageSize: 100 }
                });
            }

            function loadUsers() {
                return $.ajax({
                    url: '/User/GetAll',
                    type: 'GET',
                    data: { pageSize: 100 }
                });
            }

            function escapeHtml(str) {
                if (!str) return '';
                return $('<span>').text(str).html();
            }

            function populateSelect(selectId, items, valueField, textField, defaultText) {
                var select = $(selectId);
                select.empty();
                select.append('<option value="">' + (defaultText || '-- Select --') + '</option>');
                $.each(items, function (idx, item) {
                    var value = item[valueField];
                    var text = item[textField];
                    select.append('<option value="' + value + '">' + escapeHtml(text) + '</option>');
                });
            }

            // Load user data
            $.ajax({
                url: '/User/GetById/' + encodeURIComponent(userId),
                type: 'GET',
                success: function (user) {
                    userData = user;
                    if (!user) {
                        $('#loadingSpinner').hide();
                        $('#notFoundAlert').show();
                        return;
                    }

                    // Populate basic fields
                    $('#editUserId').val(user.userId || '');
                    $('#editUsername').val(user.username || '');
                    $('#editPhoneNumber').val(user.phoneNumber || '');
                    $('#editStartDate').val(user.startDate ? user.startDate.substring(0, 10) : '');
                    $('#editSalary').val(user.salary != null ? user.salary : '');
                    if (user.isLeader) $('#editIsLeader').prop('checked', true);
                    if (user.isActive) $('#editIsActive').prop('checked', true);

                    // Load dropdowns in parallel
                    $.when(loadRoles(), loadDepartments(), loadUsers()).done(function (roleResp, deptResp, userResp) {
                        // Roles
                        var roles = roleResp[0].data || roleResp[0].items || roleResp[0].results || roleResp[0] || [];
                        if (Array.isArray(roles)) {
                            populateSelect('#editRoleId', roles, 'roleId', 'roleName', '-- Select Role --');
                            if (user.roleId != null) {
                                $('#editRoleId').val(user.roleId);
                            }
                        }

                        // Departments
                        var depts = deptResp[0].data || deptResp[0].items || deptResp[0].results || deptResp[0] || [];
                        if (Array.isArray(depts)) {
                            populateSelect('#editDepartmentId', depts, 'departmentId', 'departmentName', '-- No Department --');
                            if (user.departmentId != null) {
                                $('#editDepartmentId').val(user.departmentId);
                            }
                        }

                        // Users (for Leader dropdown)
                        var users = userResp[0].data || userResp[0].items || userResp[0].results || userResp[0] || [];
                        if (Array.isArray(users)) {
                            populateSelect('#editLeaderId', users, 'userId', 'username', '-- No Leader --');
                            if (user.leaderId) {
                                $('#editLeaderId').val(user.leaderId);
                            }
                        }

                        $('#loadingSpinner').hide();
                        $('#editCard').show();
                    }).fail(function () {
                        $('#loadingSpinner').hide();
                        $('#editCard').show();
                        $('#alertContainer').html(
                            '<div class="alert alert-warning">Some dropdown data failed to load. You can still edit fields.</div>'
                        );
                    });
                },
                error: function (xhr) {
                    $('#loadingSpinner').hide();
                    if (xhr.status === 404) {
                        $('#notFoundAlert').show();
                    } else {
                        var msg = xhr.responseText || 'Failed to load user.';
                        $('#errorAlert').text(msg).show();
                    }
                }
            });

            // ── Submit Form ─────────────────────────────────────────
            $('#editForm').on('submit', function (e) {
                e.preventDefault();

                if (!hasPermission('Users.Edit')) {
                    $('#alertContainer').html(
                        '<div class="alert alert-danger">Only administrators can save changes.</div>'
                    );
                    return;
                }

                var form = this;
                if (!form.checkValidity()) {
                    form.classList.add('was-validated');
                    return;
                }

                var dto = {
                    userId: $('#editUserId').val(),
                    username: $('#editUsername').val().trim(),
                    roleId: parseInt($('#editRoleId').val()),
                    leaderId: $('#editLeaderId').val() || null,
                    departmentId: $('#editDepartmentId').val()
                        ? parseInt($('#editDepartmentId').val())
                        : null,
                    isLeader: $('#editIsLeader').is(':checked'),
                    phoneNumber: $('#editPhoneNumber').val().trim(),
                    startDate: $('#editStartDate').val(),
                    salary: parseFloat($('#editSalary').val()) || 0,
                    isActive: $('#editIsActive').is(':checked')
                };

                $('#btnSave').prop('disabled', true);
                $('#savingSpinner').show();
                $('#alertContainer').empty();

                $.ajax({
                    url: '/User/Edit',
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify(dto),
                    success: function (response) {
                        $('#savingSpinner').hide();
                        $('#alertContainer').html(
                            '<div class="alert alert-success">User updated successfully! Redirecting...</div>'
                        );
                        setTimeout(function () {
                            window.location.href = '/User';
                        }, 1000);
                    },
                    error: function (xhr) {
                        $('#savingSpinner').hide();
                        $('#btnSave').prop('disabled', false);

                        var msg = 'Failed to update user.';
                        if (xhr.responseJSON) {
                            if (xhr.responseJSON.title) {
                                msg = xhr.responseJSON.title;
                            } else if (xhr.responseJSON.errors) {
                                var errors = xhr.responseJSON.errors;
                                var errorList = [];
                                $.each(errors, function (key, arr) {
                                    $.each(arr, function (i, err) {
                                        errorList.push(err);
                                    });
                                });
                                msg = errorList.join('<br/>');
                            }
                        } else if (xhr.responseText) {
                            msg = xhr.responseText;
                        }

                        $('#alertContainer').html(
                            '<div class="alert alert-danger">' + msg + '</div>'
                        );
                    }
                });
            });
        });
    </script>
}
