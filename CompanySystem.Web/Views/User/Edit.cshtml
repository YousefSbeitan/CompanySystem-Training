@{
    ViewData["Title"] = "Edit User";
}

<div class="container">
    <h1>Edit User</h1>

    <div id="loading-spinner" class="text-center my-4">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>

    <div id="error-alert" class="alert alert-danger d-none" role="alert"></div>

    <form id="edit-user-form" class="d-none">
        <input type="hidden" id="userId" name="userId" />

        <div class="row">
            <div class="col-md-6 mb-3">
                <label for="username" class="form-label">Username</label>
                <input type="text" id="username" name="username" class="form-control" required maxlength="100" />
                <div class="invalid-feedback">Username is required.</div>
            </div>

            <div class="col-md-6 mb-3">
                <label for="roleId" class="form-label">Role</label>
                <select id="roleId" name="roleId" class="form-select" required>
                    <option value="">-- Select Role --</option>
                </select>
                <div class="invalid-feedback">Role is required.</div>
            </div>

            <div class="col-md-6 mb-3">
                <label for="leaderId" class="form-label">Leader</label>
                <select id="leaderId" name="leaderId" class="form-select">
                    <option value="">-- No Leader --</option>
                </select>
            </div>

            <div class="col-md-6 mb-3">
                <label for="departmentId" class="form-label">Department</label>
                <select id="departmentId" name="departmentId" class="form-select">
                    <option value="">-- No Department --</option>
                </select>
            </div>

            <div class="col-md-6 mb-3">
                <label for="phoneNumber" class="form-label">Phone Number</label>
                <input type="tel" id="phoneNumber" name="phoneNumber" class="form-control" required maxlength="20" />
                <div class="invalid-feedback">A valid phone number is required.</div>
            </div>

            <div class="col-md-6 mb-3">
                <label for="startDate" class="form-label">Start Date</label>
                <input type="date" id="startDate" name="startDate" class="form-control" required />
                <div class="invalid-feedback">Start date is required.</div>
            </div>

            <div class="col-md-6 mb-3">
                <label for="salary" class="form-label">Salary</label>
                <input type="number" id="salary" name="salary" class="form-control" step="0.01" min="0" max="1000000000" />
                <div class="invalid-feedback">Salary must be greater than or equal to zero.</div>
            </div>

            <div class="col-md-6 mb-3">
                <div class="form-check mt-4">
                    <input type="checkbox" id="isLeader" name="isLeader" class="form-check-input" value="true" />
                    <label for="isLeader" class="form-check-label">Is Leader</label>
                </div>
                <div class="form-check">
                    <input type="checkbox" id="isActive" name="isActive" class="form-check-input" value="true" />
                    <label for="isActive" class="form-check-label">Is Active</label>
                </div>
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a href="/User" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var id = window.location.pathname.split('/').pop();
            if (!id) {
                $('#loading-spinner').html('<div class="alert alert-danger">Invalid user ID.</div>');
                return;
            }
            loadUser(id);
            loadRoles();
            loadDepartments();
            loadLeaders();
        });

        function loadUser(id) {
            $.getJSON('/User/GetById/' + encodeURIComponent(id))
                .done(function (user) {
                    $('#userId').val(user.userId);
                    $('#username').val(user.username);
                    $('#phoneNumber').val(user.phoneNumber);
                    $('#startDate').val(user.startDate ? user.startDate.substring(0, 10) : '');
                    $('#salary').val(user.salary);
                    $('#isLeader').prop('checked', user.isLeader);
                    $('#isActive').prop('checked', user.isActive);

                    if (user.roleId) $('#roleId').val(user.roleId);
                    if (user.departmentId) $('#departmentId').val(user.departmentId);
                    if (user.leaderId) $('#leaderId').val(user.leaderId);

                    $('#loading-spinner').addClass('d-none');
                    $('#edit-user-form').removeClass('d-none');
                })
                .fail(function (xhr) {
                    $('#loading-spinner').html('<div class="alert alert-danger">Error loading user: ' + (xhr.responseJSON || xhr.responseText || 'Unknown error') + '</div>');
                });
        }

        function loadRoles() {
            $.getJSON('/Role/GetAll')
                .done(function (roles) {
                    var select = $('#roleId');
                    select.find('option:not(:first)').remove();
                    $.each(roles, function (i, role) {
                        select.append('<option value="' + role.roleId + '">' + escapeHtml(role.roleName) + '</option>');
                    });
                })
                .fail(function () {
                    showError('Failed to load roles.');
                });
        }

        function loadDepartments() {
            $.getJSON('/Department/GetAll')
                .done(function (departments) {
                    var select = $('#departmentId');
                    select.find('option:not(:first)').remove();
                    $.each(departments, function (i, dept) {
                        select.append('<option value="' + dept.departmentId + '">' + escapeHtml(dept.departmentName) + '</option>');
                    });
                })
                .fail(function () {
                    showError('Failed to load departments.');
                });
        }

        function loadLeaders() {
            $.getJSON('/User/GetAll')
                .done(function (users) {
                    var select = $('#leaderId');
                    select.find('option:not(:first)').remove();
                    $.each(users, function (i, user) {
                        select.append('<option value="' + escapeHtml(user.userId) + '">' + escapeHtml(user.username) + '</option>');
                    });
                })
                .fail(function () {
                    showError('Failed to load users.');
                });
        }

        function escapeHtml(str) {
            if (!str) return '';
            return $('<span>').text(str).html();
        }

        function showError(msg) {
            var alert = $('#error-alert');
            alert.removeClass('d-none').html(msg);
        }

        $('#edit-user-form').submit(function (e) {
            e.preventDefault();

            var form = $(this);
            form.find('.is-invalid').removeClass('is-invalid');

            var data = {
                userId: $('#userId').val(),
                username: $('#username').val().trim(),
                roleId: parseInt($('#roleId').val()) || 0,
                leaderId: $('#leaderId').val() || null,
                departmentId: $('#departmentId').val() ? parseInt($('#departmentId').val()) : null,
                isLeader: $('#isLeader').is(':checked'),
                phoneNumber: $('#phoneNumber').val().trim(),
                startDate: $('#startDate').val(),
                salary: parseFloat($('#salary').val()) || 0,
                isActive: $('#isActive').is(':checked')
            };

            if (!data.username) { $('#username').addClass('is-invalid'); return; }
            if (!data.roleId) { $('#roleId').addClass('is-invalid'); return; }
            if (!data.phoneNumber) { $('#phoneNumber').addClass('is-invalid'); return; }
            if (!data.startDate) { $('#startDate').addClass('is-invalid'); return; }

            $('#error-alert').addClass('d-none');

            $.ajax({
                type: 'PUT',
                url: '/User/Edit',
                contentType: 'application/json',
                data: JSON.stringify(data)
            })
                .done(function () {
                    window.location.href = '/User';
                })
                .fail(function (xhr) {
                    var msg = 'An error occurred while updating the user.';
                    try {
                        var resp = JSON.parse(xhr.responseText);
                        if (resp.title) msg = resp.title;
                        else if (resp.message) msg = resp.message;
                        else if (typeof resp === 'string') msg = resp;
                        else if (resp.errors) {
                            var errs = [];
                            $.each(resp.errors, function (key, arr) { errs.push(arr.join(', ')); });
                            msg = errs.join('<br/>');
                        }
                    } catch (e) {
                        msg = xhr.responseText || msg;
                    }
                    showError(msg);
                });
        });
    </script>
}
