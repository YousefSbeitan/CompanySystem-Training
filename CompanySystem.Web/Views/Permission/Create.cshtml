@{
    ViewData["Title"] = "Assign Permissions";
}

<div class="container-fluid">
    <h1 class="h3 mb-3">Assign Permissions to User</h1>

    <div class="card">
        <div class="card-body">
            <form id="createForm" novalidate>
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="createUserId" class="form-label">
                                User <span class="text-danger">*</span>
                            </label>
                            <select class="form-select" id="createUserId" name="UserId" required>
                                <option value="">-- Select User --</option>
                            </select>
                            <div class="invalid-feedback">
                                Please select a user.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label class="form-label">
                                Permissions <span class="text-danger">*</span>
                            </label>
                            <div id="permissionsContainer" class="border rounded p-3" style="max-height: 400px; overflow-y: auto;">
                                <div class="text-center text-muted py-3">
                                    <i class="bi bi-arrow-up-circle me-1"></i> Select a user above to load available permissions.
                                </div>
                            </div>
                            <div class="invalid-feedback">
                                Please select at least one permission.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" id="btnSave">
                        <i class="bi bi-check-lg"></i> Assign Permissions
                    </button>
                    <a href="/Permission" class="btn btn-secondary">Cancel</a>
                </div>
            </form>

            <!-- Loading Spinner (hidden) -->
            <div id="loadingSpinner" class="text-center my-3" style="display:none;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Saving...</span>
                </div>
                <p class="mt-2 text-muted">Assigning permissions...</p>
            </div>
        </div>
    </div>

    <!-- Alert Container -->
    <div id="alertContainer" class="mt-3"></div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var permissions = window.currentUserPermissions || [];
            var userRole = window.currentUserRole || '';

            function hasPermission(perm) {
                if (permissions.length > 0) return permissions.includes(perm);
                return (userRole === 'Admin');
            }

            if (!hasPermission("Permissions.Create")) {
                $('#alertContainer').html(
                    '<div class="alert alert-danger">You do not have permission to assign permissions.</div>'
                );
                $('#btnSave').prop('disabled', true);
                return;
            }

            // Load users for dropdown
            $.ajax({
                url: '/User/GetAll',
                type: 'GET',
                data: { pageSize: 1000 },
                success: function (response) {
                    var users = response.data || response.items || response.results || response || [];
                    var select = $('#createUserId');
                    select.empty().append('<option value="">-- Select User --</option>');
                    if (Array.isArray(users)) {
                        $.each(users, function (idx, user) {
                            select.append('<option value="' + escapeHtml(user.userId || user.id) + '">' +
                                escapeHtml(user.username || user.userName || user.email || user.userId || user.id) + '</option>');
                        });
                    }
                },
                error: function () {
                    var select = $('#createUserId');
                    select.empty().append('<option value="">-- Error loading users --</option>');
                }
            });

            // Load all permissions for checkboxes
            var allPermissions = [];
            $.ajax({
                url: '/Permission/GetAll',
                type: 'GET',
                data: { pageSize: 1000 },
                success: function (response) {
                    allPermissions = response.data || response.items || response.results || response || [];
                }
            });

            // When user is selected, show permissions
            $('#createUserId').on('change', function () {
                var userId = $(this).val();
                if (!userId) {
                    $('#permissionsContainer').html(
                        '<div class="text-center text-muted py-3"><i class="bi bi-arrow-up-circle me-1"></i> Select a user above to load available permissions.</div>'
                    );
                    return;
                }

                // Load user's current permissions
                $.ajax({
                    url: '/Permission/GetUserPermissions/' + encodeURIComponent(userId),
                    type: 'GET',
                    success: function (userPerms) {
                        var userPermIds = [];
                        if (Array.isArray(userPerms)) {
                            userPermIds = userPerms.map(function (p) { return p.permissionId; });
                        }

                        // Build checkboxes
                        var html = '<div class="form-check mb-1"><input class="form-check-input" type="checkbox" id="permAll" value="all"> <label class="form-check-label fw-bold" for="permAll">Select All</label></div><hr class="my-2"/>';
                        if (allPermissions.length === 0) {
                            html = '<div class="text-center text-muted py-3">No permissions available.</div>';
                        } else {
                            $.each(allPermissions, function (idx, perm) {
                                var checked = userPermIds.indexOf(perm.permissionId) >= 0 ? 'checked' : '';
                                html += '<div class="form-check mb-1">';
                                html += '<input class="form-check-input permission-checkbox" type="checkbox" id="perm_' + perm.permissionId + '" value="' + perm.permissionId + '" ' + checked + '>';
                                html += '<label class="form-check-label" for="perm_' + perm.permissionId + '">' + escapeHtml(perm.permissionName) + '</label>';
                                if (perm.description) {
                                    html += '<small class="text-muted d-block ms-4">' + escapeHtml(perm.description) + '</small>';
                                }
                                html += '</div>';
                            });
                        }
                        $('#permissionsContainer').html(html);

                        // Select All / Deselect All
                        $('#permAll').on('change', function () {
                            var isChecked = $(this).is(':checked');
                            $('.permission-checkbox').prop('checked', isChecked);
                        });
                    },
                    error: function () {
                        // Show unselected checkboxes
                        var html = '<div class="form-check mb-1"><input class="form-check-input" type="checkbox" id="permAll" value="all"> <label class="form-check-label fw-bold" for="permAll">Select All</label></div><hr class="my-2"/>';
                        if (allPermissions.length === 0) {
                            html = '<div class="text-center text-muted py-3">No permissions available.</div>';
                        } else {
                            $.each(allPermissions, function (idx, perm) {
                                html += '<div class="form-check mb-1">';
                                html += '<input class="form-check-input permission-checkbox" type="checkbox" id="perm_' + perm.permissionId + '" value="' + perm.permissionId + '">';
                                html += '<label class="form-check-label" for="perm_' + perm.permissionId + '">' + escapeHtml(perm.permissionName) + '</label>';
                                if (perm.description) {
                                    html += '<small class="text-muted d-block ms-4">' + escapeHtml(perm.description) + '</small>';
                                }
                                html += '</div>';
                            });
                        }
                        $('#permissionsContainer').html(html);

                        $('#permAll').on('change', function () {
                            var isChecked = $(this).is(':checked');
                            $('.permission-checkbox').prop('checked', isChecked);
                        });
                    }
                });
            });

            // Submit form
            $('#createForm').on('submit', function (e) {
                e.preventDefault();

                var form = this;
                if (!form.checkValidity()) {
                    form.classList.add('was-validated');
                    return;
                }

                var userId = $('#createUserId').val();
                var selectedPermIds = [];
                $('.permission-checkbox:checked').each(function () {
                    selectedPermIds.push(parseInt($(this).val()));
                });

                if (selectedPermIds.length === 0) {
                    $('#alertContainer').html(
                        '<div class="alert alert-danger">Please select at least one permission.</div>'
                    );
                    return;
                }

                var dto = {
                    userId: userId,
                    permissionIds: selectedPermIds
                };

                $('#btnSave').prop('disabled', true);
                $('#loadingSpinner').show();
                $('#alertContainer').empty();

                $.ajax({
                    url: '/Permission/Assign',
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify(dto),
                    success: function (response) {
                        $('#loadingSpinner').hide();
                        var message = (response && response.message) ? response.message : 'Permissions assigned successfully!';
                        $('#alertContainer').html(
                            '<div class="alert alert-success">' + message + ' Redirecting...</div>'
                        );
                        setTimeout(function () {
                            window.location.href = '/Permission';
                        }, 1000);
                    },
                    error: function (xhr) {
                        $('#loadingSpinner').hide();
                        $('#btnSave').prop('disabled', false);

                        var msg = 'Failed to assign permissions.';
                        if (xhr.responseJSON) {
                            if (xhr.responseJSON.title) {
                                msg = xhr.responseJSON.title;
                            } else if (xhr.responseJSON.errors) {
                                var errors = xhr.responseJSON.errors;
                                var errorList = [];
                                $.each(errors, function (key, arr) {
                                    $.each(arr, function (i, err) {
                                        errorList.push(err);
                                    });
                                });
                                msg = errorList.join('<br/>');
                            }
                        } else if (xhr.responseText) {
                            msg = xhr.responseText;
                        }

                        $('#alertContainer').html(
                            '<div class="alert alert-danger">' + msg + '</div>'
                        );
                    }
                });
            });

            function escapeHtml(str) {
                if (!str) return '';
                return $('<span>').text(str).html();
            }
        });
    </script>
}