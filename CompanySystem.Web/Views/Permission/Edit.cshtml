@{
    ViewData["Title"] = "Edit Permissions";
}

<div class="container-fluid">
    <h1 class="h3 mb-3">Edit User Permissions</h1>

    <!-- Loading Spinner -->
    <div id="loadingSpinner" class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2 text-muted">Loading permission data...</p>
    </div>

    <!-- Error -->
    <div id="errorAlert" class="alert alert-danger" style="display:none;"></div>
    <div id="notFoundAlert" class="alert alert-warning" style="display:none;">Permission not found.</div>

    <!-- Edit Form -->
    <div class="card" id="editCard" style="display:none;">
        <div class="card-body">
            <form id="editForm" novalidate>
                <input type="hidden" id="editPermissionId" />

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="editPermissionName" class="form-label">
                                Permission Name
                            </label>
                            <input type="text" class="form-control" id="editPermissionName" name="PermissionName"
                                   readonly placeholder="Permission name" />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="editDescription" class="form-label">Description</label>
                            <textarea class="form-control" id="editDescription" name="Description" rows="3" readonly></textarea>
                        </div>
                    </div>
                </div>

                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-1"></i>
                    Permission definitions are system-managed. To assign permissions to users,
                    <a href="/Permission/Create" class="alert-link">go to the Assign Permissions page</a>.
                </div>

                <div class="d-flex gap-2">
                    <a href="/Permission" class="btn btn-secondary">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var permissions = window.currentUserPermissions || [];
            var userRole = window.currentUserRole || '';

            function hasPermission(perm) {
                if (permissions.length > 0) return permissions.includes(perm);
                return (userRole === 'Admin');
            }

            if (!hasPermission("Permissions.Edit")) {
                $('#loadingSpinner').hide();
                $('#alertContainer').html(
                    '<div class="alert alert-danger">You do not have permission to edit permissions.</div>'
                );
                return;
            }

            // Extract permission ID from URL: /Permission/Edit/{id}
            var pathParts = window.location.pathname.split('/');
            var permissionId = parseInt(pathParts[pathParts.length - 1]);

            if (!permissionId) {
                $('#loadingSpinner').hide();
                $('#errorAlert').text('Invalid permission ID.').show();
                return;
            }

            // Load permission data
            $.ajax({
                url: '/Permission/GetById/' + permissionId,
                type: 'GET',
                success: function (perm) {
                    $('#loadingSpinner').hide();

                    if (!perm) {
                        $('#notFoundAlert').show();
                        return;
                    }

                    $('#editPermissionId').val(perm.permissionId || '');
                    $('#editPermissionName').val(perm.permissionName || '');
                    $('#editDescription').val(perm.description || '');

                    $('#editCard').show();
                },
                error: function (xhr) {
                    $('#loadingSpinner').hide();
                    if (xhr.status === 404) {
                        $('#notFoundAlert').show();
                    } else {
                        var msg = xhr.responseText || 'Failed to load permission.';
                        $('#errorAlert').text(msg).show();
                    }
                }
            });
        });
    </script>
}