@{
    ViewData["Title"] = "Permission Details";
}

<div class="container-fluid">
    <h1 class="h3 mb-3">Permission Details</h1>

    <!-- Loading Spinner -->
    <div id="loadingSpinner" class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2 text-muted">Loading permission details...</p>
    </div>

    <!-- Error -->
    <div id="errorAlert" class="alert alert-danger" style="display:none;"></div>

    <!-- Detail Card -->
    <div id="detailCard" class="card" style="display:none;">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-bold">Permission Information</span>
            <span class="badge bg-secondary" id="detailPermissionId"></span>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Permission ID</dt>
                <dd class="col-sm-9" id="detailPermissionIdDisplay"></dd>

                <dt class="col-sm-3">Permission Name</dt>
                <dd class="col-sm-9" id="detailPermissionName"></dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9" id="detailDescription"></dd>

                <dt class="col-sm-3">Created By</dt>
                <dd class="col-sm-9" id="detailCreatedBy"></dd>

                <dt class="col-sm-3">Created Date</dt>
                <dd class="col-sm-9" id="detailCreatedDate"></dd>

                <dt class="col-sm-3">Updated By</dt>
                <dd class="col-sm-9" id="detailUpdatedBy"></dd>

                <dt class="col-sm-3">Updated Date</dt>
                <dd class="col-sm-9" id="detailUpdatedDate"></dd>
            </dl>
        </div>
        <div class="card-footer">
            <a href="/Permission" class="btn btn-secondary">Back to List</a>
            <button class="btn btn-warning permissions-edit" id="btnEditFromDetails" style="display:none;">
                <i class="bi bi-pencil"></i> Edit
            </button>
        </div>
    </div>

    <!-- Not Found -->
    <div id="notFoundAlert" class="alert alert-warning" style="display:none;">
        Permission not found.
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var permissions = window.currentUserPermissions || [];
            var userRole = window.currentUserRole || '';

            function hasPermission(perm) {
                if (permissions.length > 0) return permissions.includes(perm);
                return (userRole === 'Admin');
            }

            if (hasPermission("Permissions.Edit")) {
                $('.permissions-edit').show();
            }

            // Extract permission ID from URL: /Permission/Details/{id}
            var pathParts = window.location.pathname.split('/');
            var permissionId = parseInt(pathParts[pathParts.length - 1]);

            if (!permissionId) {
                $('#loadingSpinner').hide();
                $('#errorAlert').text('Invalid permission ID.').show();
                return;
            }

            $.ajax({
                url: '/Permission/GetById/' + permissionId,
                type: 'GET',
                success: function (perm) {
                    $('#loadingSpinner').hide();

                    if (!perm) {
                        $('#notFoundAlert').show();
                        return;
                    }

                    $('#detailPermissionId').text('#' + (perm.permissionId || ''));
                    $('#detailPermissionIdDisplay').text(perm.permissionId || '');
                    $('#detailPermissionName').text(perm.permissionName || '');
                    $('#detailDescription').text(perm.description || '-');
                    $('#detailCreatedBy').text(perm.createdBy || '-');
                    $('#detailCreatedDate').text(perm.createdDate ? new Date(perm.createdDate).toLocaleString() : '-');
                    $('#detailUpdatedBy').text(perm.updatedBy || '-');
                    $('#detailUpdatedDate').text(perm.updatedDate ? new Date(perm.updatedDate).toLocaleString() : '-');

                    if (hasPermission("Permissions.Edit")) {
                        $('#btnEditFromDetails').data('id', perm.permissionId).show();
                    }

                    $('#detailCard').show();
                },
                error: function (xhr) {
                    $('#loadingSpinner').hide();
                    if (xhr.status === 404) {
                        $('#notFoundAlert').show();
                    } else {
                        var msg = xhr.responseText || 'An error occurred while loading permission details.';
                        $('#errorAlert').text(msg).show();
                    }
                }
            });

            // Edit button on details page
            $(document).on('click', '#btnEditFromDetails', function () {
                var id = $(this).data('id');
                window.location.href = '/Permission/Edit/' + id;
            });
        });
    </script>
}