@{
    Layout = "_Layout";
    ViewData["Title"] = "Delete Permission";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <a href="/Permission" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to Permissions
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white">
                    <h4 class="mb-0"><i class="bi bi-shield-lock me-2"></i>Delete Permission</h4>
                </div>
                <div class="card-body text-center py-5">
                    <i class="bi bi-lock-fill fs-1 text-secondary d-block mb-3"></i>
                    <h5 class="mb-2">Permissions are system-managed</h5>
                    <p class="text-muted mb-4">
                        Permissions are seeded reference data and cannot be deleted individually.
                        They are assigned to users via the Assign Permissions screen.
                    </p>
                    <div class="d-flex justify-content-center gap-2">
                        <a href="/Permission" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Back to Permissions
                        </a>
                        <a href="/Permission/Assign" class="btn btn-primary">
                            <i class="bi bi-person-check me-1"></i>Assign Permissions
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
