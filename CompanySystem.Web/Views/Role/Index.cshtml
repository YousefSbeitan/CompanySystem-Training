@{
    ViewData["Title"] = "Role Management";
}

<div class="crud-container">
    <div class="crud-header">
        <h1><i class="bi bi-shield-fill-check me-2"></i>Role Management</h1>
        <button class="btn btn-primary admin-only" id="btnCreate" style="display:none;">
            <i class="bi bi-plus-lg"></i> Create Role
        </button>
    </div>

    <!-- Search & Filter -->
    <div class="search-filter-row">
        <div class="search-group">
            <div class="input-group">
                <input type="text" class="form-control" id="inputSearch" placeholder="Search by role name..." />
                <button class="btn btn-outline-secondary" type="button" id="btnSearch">
                    <i class="bi bi-search"></i> Search
                </button>
                <button class="btn btn-outline-secondary" type="button" id="btnClear">
                    <i class="bi bi-x-circle"></i> Clear
                </button>
            </div>
        </div>
        <div class="page-size-group">
            <select class="form-select" id="selectPageSize">
                <option value="5">5 per page</option>
                <option value="10" selected>10 per page</option>
                <option value="20">20 per page</option>
                <option value="50">50 per page</option>
            </select>
        </div>
    </div>

    <!-- Alerts -->
    <div id="errorAlert" class="alert alert-danger crud-alert" style="display:none;"></div>

    <!-- Loading Spinner -->
    <div class="page-loading" id="loadingSpinner" style="display:none;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p>Loading roles...</p>
    </div>

    <!-- Table -->
    <div class="crud-table">
        <div class="table-responsive-custom">
            <table class="table table-hover table-striped" id="rolesTable" style="display:none;">
                <thead>
                    <tr>
                        <th data-sort="RoleId" class="sortable" style="cursor:pointer; width:80px;">
                            ID <span class="sort-icon"></span>
                        </th>
                        <th data-sort="RoleName" class="sortable" style="cursor:pointer;">
                            Role Name <span class="sort-icon"></span>
                        </th>
                        <th data-sort="CreatedBy" class="sortable" style="cursor:pointer;">
                            Created By <span class="sort-icon"></span>
                        </th>
                        <th data-sort="CreatedDate" class="sortable" style="cursor:pointer;">
                            Created Date <span class="sort-icon"></span>
                        </th>
                        <th style="width:200px;">Actions</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    <nav id="paginationNav" class="mt-3" style="display:none;">
        <ul class="pagination justify-content-center" id="paginationUl">
        </ul>
    </nav>

    <!-- No Data -->
    <div class="empty-state" id="noData" style="display:none;">
        <i class="bi bi-shield empty-icon"></i>
        <h4>No Roles Found</h4>
        <p>There are no roles configured yet.</p>
        <button class="btn btn-primary admin-only" id="btnCreateEmpty" style="display:none;">
            <i class="bi bi-plus-lg"></i> Create Role
        </button>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="createModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createModalLabel"><i class="bi bi-plus-circle me-1"></i>Create Role</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="createForm" novalidate>
                    <div class="mb-3">
                        <label for="createRoleName" class="form-label">Role Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="createRoleName" name="RoleName" maxlength="100" required />
                        <div class="invalid-feedback">Role name is required (max 100 characters).</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSaveCreate">
                    <i class="bi bi-check-lg"></i> Save
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editModalLabel"><i class="bi bi-pencil-square me-1"></i>Edit Role</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editForm" novalidate>
                    <input type="hidden" id="editRoleId" />
                    <div class="mb-3">
                        <label for="editRoleName" class="form-label">Role Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="editRoleName" name="RoleName" maxlength="100" required />
                        <div class="invalid-feedback">Role name is required (max 100 characters).</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSaveEdit">
                    <i class="bi bi-check-lg"></i> Save Changes
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel"><i class="bi bi-exclamation-triangle me-1"></i>Delete Role</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning mb-3">
                    <i class="bi bi-exclamation-circle me-1"></i>
                    <strong>Warning:</strong> This action cannot be undone.
                </div>
                <p class="fw-bold">Are you sure you want to delete this role?</p>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Role ID</dt>
                    <dd class="col-sm-8" id="deleteRoleId"></dd>
                    <dt class="col-sm-4">Role Name</dt>
                    <dd class="col-sm-8" id="deleteRoleName"></dd>
                </dl>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="btnConfirmDelete">
                    <i class="bi bi-trash"></i> Delete
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // ── State ────────────────────────────────────────────────
            var currentPage = 1;
            var currentPageSize = 10;
            var currentSearch = '';
            var currentSortBy = 'RoleId';
            var currentIsDescending = false;
            var permissions = window.currentUserPermissions || [];
            var userRole = window.currentUserRole || '';
            var isAdmin = (userRole === 'Admin');

            function hasPermission(perm) {
                if (permissions.length > 0) return permissions.includes(perm);
                return isAdmin; // fallback: Admin has all permissions
            }

            if (hasPermission("Roles.Create")) {
                $('.admin-only').show();
            }

            function showToast(msg, type) {
                if (window.showToast) {
                    window.showToast(msg, type);
                } else if (window.auth && window.auth.showNotification) {
                    window.auth.showNotification(msg, type === 'success' ? 'success' : 'error');
                }
            }

            function loadRoles() {
                $('#loadingSpinner').show();
                $('#rolesTable').hide();
                $('#paginationNav').hide();
                $('#noData').hide();
                $('#errorAlert').hide();

                $.ajax({
                    url: '/Role/GetAll',
                    type: 'GET',
                    data: {
                        pageNumber: currentPage,
                        pageSize: currentPageSize,
                        search: currentSearch,
                        sortBy: currentSortBy,
                        isDescending: currentIsDescending
                    },
                    success: function (response) {
                        $('#loadingSpinner').hide();

                        var data = response.data || response.items || response.results || response || [];
                        var totalPages = response.totalPages || 0;
                        var pageNumber = response.pageNumber || currentPage;

                        if (Array.isArray(data) && data.length > 0) {
                            renderTable(data);
                            renderPagination(totalPages, pageNumber);
                            $('#rolesTable').show();
                            $('#paginationNav').show();
                        } else {
                            $('#noData').show();
                        }
                    },
                    error: function (xhr) {
                        $('#loadingSpinner').hide();
                        var msg = xhr.responseText || 'An error occurred while loading roles.';
                        $('#errorAlert').text(msg).show();
                    }
                });
            }

            function renderTable(roles) {
                var html = '';
                $.each(roles, function (idx, role) {
                    var createdDate = role.createdDate
                        ? new Date(role.createdDate).toLocaleDateString()
                        : '-';
                    html += '<tr>';
                    html += '<td>' + escapeHtml(role.roleId) + '</td>';
                    html += '<td><strong>' + escapeHtml(role.roleName || '') + '</strong></td>';
                    html += '<td>' + escapeHtml(role.createdBy || '-') + '</td>';
                    html += '<td>' + createdDate + '</td>';
                    html += '<td><div class="action-btns">';
                    if (hasPermission("Roles.View")) {
                        html += '<button class="btn btn-sm btn-info btn-details" data-id="' + escapeHtml(role.roleId) + '" title="Details"><i class="bi bi-eye"></i></button>';
                    }
                    if (hasPermission("Roles.Edit")) {
                        html += '<button class="btn btn-sm btn-warning btn-edit" data-id="' + escapeHtml(role.roleId) + '" title="Edit"><i class="bi bi-pencil"></i></button>';
                    }
                    if (hasPermission("Roles.Delete")) {
                        html += '<button class="btn btn-sm btn-danger btn-delete" data-id="' + escapeHtml(role.roleId) + '" title="Delete"><i class="bi bi-trash"></i></button>';
                    }
                    html += '</div></td>';
                    html += '</tr>';
                });
                $('#tableBody').html(html);
            }

            function renderPagination(totalPages, pageNumber) {
                var ul = $('#paginationUl');
                ul.empty();

                if (totalPages <= 1) {
                    $('#paginationNav').hide();
                    return;
                }
                $('#paginationNav').show();

                ul.append('<li class="page-item' + (pageNumber <= 1 ? ' disabled' : '') + '"><a class="page-link" href="#" data-page="' + (pageNumber - 1) + '"><i class="bi bi-chevron-left"></i></a></li>');

                for (var i = 1; i <= totalPages; i++) {
                    ul.append('<li class="page-item' + (i === pageNumber ? ' active' : '') + '"><a class="page-link" href="#" data-page="' + i + '">' + i + '</a></li>');
                }

                ul.append('<li class="page-item' + (pageNumber >= totalPages ? ' disabled' : '') + '"><a class="page-link" href="#" data-page="' + (pageNumber + 1) + '"><i class="bi bi-chevron-right"></i></a></li>');
            }

            function escapeHtml(str) {
                if (!str) return '';
                return $('<span>').text(str).html();
            }

            function updateSortIcon() {
                $('.sortable .sort-icon').text('');
                $('.sortable').each(function () {
                    var col = $(this).data('sort');
                    if (col === currentSortBy) {
                        $(this).find('.sort-icon').text(currentIsDescending ? ' ▲' : ' ▼');
                    }
                });
            }

            $(document).on('click', '.sortable', function () {
                var col = $(this).data('sort');
                if (col === currentSortBy) {
                    currentIsDescending = !currentIsDescending;
                } else {
                    currentSortBy = col;
                    currentIsDescending = false;
                }
                currentPage = 1;
                updateSortIcon();
                loadRoles();
            });

            $(document).on('click', '.page-link', function (e) {
                e.preventDefault();
                var page = parseInt($(this).data('page'));
                if (page && page > 0) {
                    currentPage = page;
                    loadRoles();
                }
            });

            $('#btnSearch').on('click', function () {
                currentSearch = $('#inputSearch').val().trim();
                currentPage = 1;
                loadRoles();
            });

            $('#inputSearch').on('keypress', function (e) {
                if (e.which === 13) {
                    $('#btnSearch').click();
                }
            });

            $('#btnClear').on('click', function () {
                $('#inputSearch').val('');
                currentSearch = '';
                currentPage = 1;
                loadRoles();
            });

            $('#selectPageSize').on('change', function () {
                currentPageSize = parseInt($(this).val());
                currentPage = 1;
                loadRoles();
            });

            $('#btnCreate, #btnCreateEmpty').on('click', function () {
                $('#createRoleName').val('');
                $('#createForm').removeClass('was-validated');
                $('#createModal').modal('show');
            });

            $('#btnSaveCreate').on('click', function () {
                var form = $('#createForm')[0];
                if (!form.checkValidity()) {
                    form.classList.add('was-validated');
                    return;
                }

                var dto = {
                    roleName: $('#createRoleName').val().trim()
                };

                $(this).prop('disabled', true);
                $.ajax({
                    url: '/Role/Create',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(dto),
                    success: function () {
                        $('#createModal').modal('hide');
                        loadRoles();
                        showToast('Role created successfully.', 'success');
                    },
                    error: function (xhr) {
                        var msg = 'Failed to create role.';
                        if (xhr.responseJSON && xhr.responseJSON.title) {
                            msg = xhr.responseJSON.title;
                        }
                        showToast(msg, 'error');
                    },
                    complete: function () {
                        $('#btnSaveCreate').prop('disabled', false);
                    }
                });
            });

            $(document).on('click', '.btn-details', function () {
                var id = $(this).data('id');
                window.location.href = '/Role/Details/' + encodeURIComponent(id);
            });

            $(document).on('click', '.btn-edit', function () {
                var id = $(this).data('id');
                $('#editRoleId').val('');
                $('#editRoleName').val('');
                $('#editForm').removeClass('was-validated');

                $.ajax({
                    url: '/Role/GetById/' + encodeURIComponent(id),
                    type: 'GET',
                    success: function (role) {
                        $('#editRoleId').val(role.roleId || role.roleID || '');
                        $('#editRoleName').val(role.roleName || '');
                        $('#editModal').modal('show');
                    },
                    error: function (xhr) {
                        var msg = 'Failed to load role details.';
                        showToast(msg, 'error');
                    }
                });
            });

            $('#btnSaveEdit').on('click', function () {
                var form = $('#editForm')[0];
                if (!form.checkValidity()) {
                    form.classList.add('was-validated');
                    return;
                }

                var dto = {
                    roleId: parseInt($('#editRoleId').val()),
                    roleName: $('#editRoleName').val().trim()
                };

                $(this).prop('disabled', true);
                $.ajax({
                    url: '/Role/Edit',
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify(dto),
                    success: function () {
                        $('#editModal').modal('hide');
                        loadRoles();
                        showToast('Role updated successfully.', 'success');
                    },
                    error: function (xhr) {
                        var msg = 'Failed to update role.';
                        if (xhr.responseJSON && xhr.responseJSON.title) {
                            msg = xhr.responseJSON.title;
                        }
                        showToast(msg, 'error');
                    },
                    complete: function () {
                        $('#btnSaveEdit').prop('disabled', false);
                    }
                });
            });

            $(document).on('click', '.btn-delete', function () {
                var id = $(this).data('id');
                $('#deleteRoleId').text('');
                $('#deleteRoleName').text('');

                $.ajax({
                    url: '/Role/GetById/' + encodeURIComponent(id),
                    type: 'GET',
                    success: function (role) {
                        $('#deleteRoleId').text(role.roleId || role.roleID || '');
                        $('#deleteRoleName').text(role.roleName || '');
                        $('#deleteModal').modal('show');
                    },
                    error: function (xhr) {
                        var msg = 'Failed to load role details.';
                        showToast(msg, 'error');
                    }
                });
            });

            $('#btnConfirmDelete').on('click', function () {
                var id = parseInt($('#deleteRoleId').text());

                $(this).prop('disabled', true);
                $.ajax({
                    url: '/Role/Delete/' + id,
                    type: 'DELETE',
                    success: function () {
                        $('#deleteModal').modal('hide');
                        loadRoles();
                        showToast('Role deleted successfully.', 'success');
                    },
                    error: function (xhr) {
                        var msg = 'Failed to delete role.';
                        showToast(msg, 'error');
                    },
                    complete: function () {
                        $('#btnConfirmDelete').prop('disabled', false);
                    }
                });
            });

            updateSortIcon();
            loadRoles();
        });
    </script>
}

