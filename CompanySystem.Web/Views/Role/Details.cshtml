@{
    ViewData["Title"] = "Role Details";
}

<div class="container-fluid">
    <h1 class="h3 mb-3">Role Details</h1>

    <!-- Loading Spinner -->
    <div id="loadingSpinner" class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2 text-muted">Loading role details...</p>
    </div>

    <!-- Error -->
    <div id="errorAlert" class="alert alert-danger" style="display:none;"></div>

    <!-- Detail Card -->
    <div id="detailCard" class="card" style="display:none;">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-bold">Role Information</span>
            <span class="badge bg-secondary" id="detailRoleId"></span>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Role ID</dt>
                <dd class="col-sm-9" id="detailRoleIdDisplay"></dd>

                <dt class="col-sm-3">Role Name</dt>
                <dd class="col-sm-9" id="detailRoleName"></dd>

                <dt class="col-sm-3">Created By</dt>
                <dd class="col-sm-9" id="detailCreatedBy"></dd>

                <dt class="col-sm-3">Created Date</dt>
                <dd class="col-sm-9" id="detailCreatedDate"></dd>

                <dt class="col-sm-3">Updated By</dt>
                <dd class="col-sm-9" id="detailUpdatedBy"></dd>

                <dt class="col-sm-3">Updated Date</dt>
                <dd class="col-sm-9" id="detailUpdatedDate"></dd>
            </dl>
        </div>
        <div class="card-footer">
            <a href="/Role" class="btn btn-secondary">Back to List</a>
            <button class="btn btn-warning admin-only" id="btnEditFromDetails" style="display:none;">
                <i class="bi bi-pencil"></i> Edit
            </button>
        </div>
    </div>

    <!-- Not Found -->
    <div id="notFoundAlert" class="alert alert-warning" style="display:none;">
        Role not found.
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var isAdmin = (window.currentUserRole === 'Admin');
            if (isAdmin) {
                $('.admin-only').show();
            }

            // Extract role ID from URL: /Role/Details/{id}
            var pathParts = window.location.pathname.split('/');
            var roleId = parseInt(pathParts[pathParts.length - 1]);

            if (!roleId) {
                $('#loadingSpinner').hide();
                $('#errorAlert').text('Invalid role ID.').show();
                return;
            }

            $.ajax({
                url: '/Role/GetById/' + roleId,
                type: 'GET',
                success: function (role) {
                    $('#loadingSpinner').hide();

                    if (!role) {
                        $('#notFoundAlert').show();
                        return;
                    }

                    $('#detailRoleId').text('#' + (role.roleId || role.roleID || ''));
                    $('#detailRoleIdDisplay').text(role.roleId || role.roleID || '');
                    $('#detailRoleName').text(role.roleName || '');
                    $('#detailCreatedBy').text(role.createdBy || '-');
                    $('#detailCreatedDate').text(role.createdDate ? new Date(role.createdDate).toLocaleString() : '-');
                    $('#detailUpdatedBy').text(role.updatedBy || '-');
                    $('#detailUpdatedDate').text(role.updatedDate ? new Date(role.updatedDate).toLocaleString() : '-');

                    if (isAdmin) {
                        $('#btnEditFromDetails').data('id', role.roleId || role.roleID).show();
                    }

                    $('#detailCard').show();
                },
                error: function (xhr) {
                    $('#loadingSpinner').hide();
                    if (xhr.status === 404) {
                        $('#notFoundAlert').show();
                    } else {
                        var msg = xhr.responseText || 'An error occurred while loading role details.';
                        $('#errorAlert').text(msg).show();
                    }
                }
            });

            // Edit button on details page
            $(document).on('click', '#btnEditFromDetails', function () {
                var id = $(this).data('id');
                window.location.href = '/Role/Edit/' + id;
            });
        });
    </script>
}
