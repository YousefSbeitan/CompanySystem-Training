@{
    Layout = "_Layout";
    ViewData["Title"] = "Role Details";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <a href="/Role" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to Roles
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0"><i class="bi bi-eye-fill me-2"></i>Role Details</h4>
                </div>
                <div class="card-body">
                    <div id="loadingContainer" class="text-center py-5">
                        <div class="spinner-border text-info" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2 text-muted">Loading role details...</p>
                    </div>

                    <div id="detailsContainer" class="d-none">
                        <div class="row mb-3">
                            <div class="col-md-4 fw-bold text-muted">Role ID</div>
                            <div class="col-md-8" id="detailRoleId">—</div>
                        </div>
                        <hr />
                        <div class="row mb-3">
                            <div class="col-md-4 fw-bold text-muted">Role Name</div>
                            <div class="col-md-8" id="detailRoleName">—</div>
                        </div>
                        <hr />
                        <div class="row mb-3">
                            <div class="col-md-4 fw-bold text-muted">Created By</div>
                            <div class="col-md-8" id="detailCreatedBy">—</div>
                        </div>
                        <hr />
                        <div class="row mb-3">
                            <div class="col-md-4 fw-bold text-muted">Created Date</div>
                            <div class="col-md-8" id="detailCreatedDate">—</div>
                        </div>
                        <hr />
                        <div class="row mb-3">
                            <div class="col-md-4 fw-bold text-muted">Updated By</div>
                            <div class="col-md-8" id="detailUpdatedBy">—</div>
                        </div>
                        <hr />
                        <div class="row mb-3">
                            <div class="col-md-4 fw-bold text-muted">Updated Date</div>
                            <div class="col-md-8" id="detailUpdatedDate">—</div>
                        </div>
                    </div>

                    <div id="errorContainer" class="d-none text-center py-5 text-danger">
                        <i class="bi bi-exclamation-triangle-fill fs-1 d-block mb-3"></i>
                        <h5>Failed to load role details</h5>
                        <p id="errorMessage" class="text-muted"></p>
                        <a href="/Role" class="btn btn-outline-secondary mt-2">Back to Roles</a>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <a href="/Role" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Back
                    </a>
                    <div>
                        <a href="/Role/Edit/@ViewContext.RouteData.Values["id"]" class="btn btn-warning d-none" id="editFromDetailsBtn">
                            <i class="bi bi-pencil-fill me-1"></i>Edit
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            var permissions = window.currentUserPermissions || [];

            function hasPerm(perm) {
                return permissions.indexOf(perm) !== -1;
            }

            if (!hasPerm('Roles.View')) {
                document.body.innerHTML =
                    '<div class="container-fluid py-5 text-center text-danger">' +
                    '<i class="bi bi-shield-exclamation fs-1 d-block mb-3"></i>' +
                    '<h3>Access Denied</h3>' +
                    '<p>You do not have permission to view role details.</p>' +
                    '<a href="/Role" class="btn btn-outline-secondary mt-3">Back to Roles</a>' +
                    '</div>';
                return;
            }

            // Show Edit button if permitted
            if (hasPerm('Roles.Edit')) {
                var editBtn = document.getElementById('editFromDetailsBtn');
                if (editBtn) {
                    editBtn.classList.remove('d-none');
                }
            }

            // Get role ID from URL
            var pathParts = window.location.pathname.split('/');
            var roleId = parseInt(pathParts[pathParts.length - 1]) || 0;

            var loadingContainer = document.getElementById('loadingContainer');
            var detailsContainer = document.getElementById('detailsContainer');
            var errorContainer = document.getElementById('errorContainer');
            var errorMessage = document.getElementById('errorMessage');

            // ── Load Role Details ────────────────────────────────────
            function loadDetails() {
                if (!roleId || roleId === 0) {
                    showError('Invalid role ID.');
                    return;
                }

                $.ajax({
                    url: '/Role/GetById/' + roleId,
                    type: 'GET',
                    beforeSend: function () {
                        loadingContainer.classList.remove('d-none');
                        detailsContainer.classList.add('d-none');
                        errorContainer.classList.add('d-none');
                    },
                    success: function (response) {
                        loadingContainer.classList.add('d-none');

                        var role = response;
                        if (response && response.data) {
                            role = response.data;
                        }

                        if (!role) {
                            showError('Role not found.');
                            return;
                        }

                        document.getElementById('detailRoleId').textContent = role.roleId || '—';
                        document.getElementById('detailRoleName').textContent = role.roleName || '—';
                        document.getElementById('detailCreatedBy').textContent = role.createdBy || '—';
                        document.getElementById('detailCreatedDate').textContent = role.createdDate ? formatDate(role.createdDate) : '—';
                        document.getElementById('detailUpdatedBy').textContent = role.updatedBy || '—';
                        document.getElementById('detailUpdatedDate').textContent = role.updatedDate ? formatDate(role.updatedDate) : '—';

                        detailsContainer.classList.remove('d-none');
                    },
                    error: function (xhr) {
                        loadingContainer.classList.add('d-none');
                        errorContainer.classList.remove('d-none');
                        var msg = 'Failed to load role details.';
                        try {
                            msg = JSON.parse(xhr.responseText) || msg;
                        } catch (e) {
                            msg = xhr.responseText || msg;
                        }
                        errorMessage.textContent = msg;

                        if (typeof window.showToast === 'function') {
                            window.showToast(msg, 'error');
                        }
                    },
                    complete: function () {
                        // handled
                    }
                });
            }

            function showError(msg) {
                loadingContainer.classList.add('d-none');
                errorContainer.classList.remove('d-none');
                errorMessage.textContent = msg;
            }

            function formatDate(dateStr) {
                if (!dateStr) return '—';
                try {
                    var d = new Date(dateStr);
                    if (isNaN(d.getTime())) return dateStr;
                    return d.toLocaleDateString() + ' ' + d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                } catch (e) {
                    return dateStr;
                }
            }

            // ── Initialize ──────────────────────────────────────────
            $(document).ready(function () {
                loadDetails();
            });

        })();
    </script>
}
