@{
    ViewData["Title"] = "Edit Role";
}

<div class="container-fluid">
    <h1 class="h3 mb-3">Edit Role</h1>

    <!-- Loading Spinner -->
    <div id="loadingSpinner" class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2 text-muted">Loading role data...</p>
    </div>

    <!-- Error -->
    <div id="errorAlert" class="alert alert-danger" style="display:none;"></div>
    <div id="notFoundAlert" class="alert alert-warning" style="display:none;">Role not found.</div>

    <!-- Edit Form -->
    <div class="card" id="editCard" style="display:none;">
        <div class="card-body">
            <form id="editForm" novalidate>
                <input type="hidden" id="editRoleId" />

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="editRoleName" class="form-label">
                                Role Name <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control" id="editRoleName" name="RoleName"
                                   maxlength="100" required placeholder="Enter role name" />
                            <div class="invalid-feedback">
                                Role name is required and must not exceed 100 characters.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" id="btnSave">
                        <i class="bi bi-check-lg"></i> Save Changes
                    </button>
                    <a href="/Role" class="btn btn-secondary">Cancel</a>
                </div>
            </form>

            <!-- Saving Spinner (hidden) -->
            <div id="savingSpinner" class="text-center my-3" style="display:none;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Saving...</span>
                </div>
                <p class="mt-2 text-muted">Saving changes...</p>
            </div>
        </div>
    </div>

    <!-- Alert Container -->
    <div id="alertContainer" class="mt-3"></div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var isAdmin = (window.currentUserRole === 'Admin');
            if (!isAdmin) {
                $('#loadingSpinner').hide();
                $('#alertContainer').html(
                    '<div class="alert alert-danger">You do not have permission to edit roles.</div>'
                );
                return;
            }

            // Extract role ID from URL: /Role/Edit/{id}
            var pathParts = window.location.pathname.split('/');
            var roleId = parseInt(pathParts[pathParts.length - 1]);

            if (!roleId) {
                $('#loadingSpinner').hide();
                $('#errorAlert').text('Invalid role ID.').show();
                return;
            }

            // Load role data
            $.ajax({
                url: '/Role/GetById/' + roleId,
                type: 'GET',
                success: function (role) {
                    $('#loadingSpinner').hide();

                    if (!role) {
                        $('#notFoundAlert').show();
                        return;
                    }

                    $('#editRoleId').val(role.roleId || role.roleID || '');
                    $('#editRoleName').val(role.roleName || '');
                    $('#editCard').show();
                },
                error: function (xhr) {
                    $('#loadingSpinner').hide();
                    if (xhr.status === 404) {
                        $('#notFoundAlert').show();
                    } else {
                        var msg = xhr.responseText || 'Failed to load role.';
                        $('#errorAlert').text(msg).show();
                    }
                }
            });

            // Submit form
            $('#editForm').on('submit', function (e) {
                e.preventDefault();

                var form = this;
                if (!form.checkValidity()) {
                    form.classList.add('was-validated');
                    return;
                }

                var dto = {
                    roleId: parseInt($('#editRoleId').val()),
                    roleName: $('#editRoleName').val().trim()
                };

                $('#btnSave').prop('disabled', true);
                $('#savingSpinner').show();
                $('#alertContainer').empty();

                $.ajax({
                    url: '/Role/Edit',
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify(dto),
                    success: function (response) {
                        $('#savingSpinner').hide();
                        $('#alertContainer').html(
                            '<div class="alert alert-success">Role updated successfully! Redirecting...</div>'
                        );
                        setTimeout(function () {
                            window.location.href = '/Role';
                        }, 1000);
                    },
                    error: function (xhr) {
                        $('#savingSpinner').hide();
                        $('#btnSave').prop('disabled', false);

                        var msg = 'Failed to update role.';
                        if (xhr.responseJSON) {
                            if (xhr.responseJSON.title) {
                                msg = xhr.responseJSON.title;
                            } else if (xhr.responseJSON.errors) {
                                var errors = xhr.responseJSON.errors;
                                var errorList = [];
                                $.each(errors, function (key, arr) {
                                    $.each(arr, function (i, err) {
                                        errorList.push(err);
                                    });
                                });
                                msg = errorList.join('<br/>');
                            }
                        } else if (xhr.responseText) {
                            msg = xhr.responseText;
                        }

                        $('#alertContainer').html(
                            '<div class="alert alert-danger">' + msg + '</div>'
                        );
                    }
                });
            });
        });
    </script>
}
