@{
    Layout = "_Layout";
    ViewData["Title"] = "Edit Role";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <a href="/Role" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to Roles
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Edit Role</h4>
                </div>
                <div class="card-body">
                    <div id="loadingContainer" class="text-center py-5">
                        <div class="spinner-border text-warning" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2 text-muted">Loading role data...</p>
                    </div>

                    <form id="roleForm" class="d-none" novalidate>
                        <input type="hidden" id="roleId" name="roleId" value="0" />

                        <div class="mb-3">
                            <label for="roleName" class="form-label">Role Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="roleName" name="roleName"
                                   required maxlength="100"
                                   placeholder="Enter role name" />
                            <div class="invalid-feedback" id="roleNameError">Role name is required and must not exceed 100 characters.</div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a href="/Role" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-warning" id="submitBtn">
                                <i class="bi bi-check-circle me-1"></i>Save Changes
                            </button>
                        </div>
                    </form>

                    <div id="errorContainer" class="d-none text-center py-5 text-danger">
                        <i class="bi bi-exclamation-triangle-fill fs-1 d-block mb-3"></i>
                        <h5>Failed to load role</h5>
                        <p id="errorMessage" class="text-muted"></p>
                        <a href="/Role" class="btn btn-outline-secondary mt-2">Back to Roles</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            var permissions = window.currentUserPermissions || [];

            function hasPerm(perm) {
                return permissions.indexOf(perm) !== -1;
            }

            if (!hasPerm('Roles.Edit')) {
                document.body.innerHTML =
                    '<div class="container-fluid py-5 text-center text-danger">' +
                    '<i class="bi bi-shield-exclamation fs-1 d-block mb-3"></i>' +
                    '<h3>Access Denied</h3>' +
                    '<p>You do not have permission to edit roles.</p>' +
                    '<a href="/Role" class="btn btn-outline-secondary mt-3">Back to Roles</a>' +
                    '</div>';
                return;
            }

            // Get role ID from URL
            var pathParts = window.location.pathname.split('/');
            var roleId = parseInt(pathParts[pathParts.length - 1]) || 0;

            var form = document.getElementById('roleForm');
            var submitBtn = document.getElementById('submitBtn');
            var roleNameInput = document.getElementById('roleName');
            var roleNameError = document.getElementById('roleNameError');
            var loadingContainer = document.getElementById('loadingContainer');
            var errorContainer = document.getElementById('errorContainer');
            var errorMessage = document.getElementById('errorMessage');

            // ── Real-time validation ─────────────────────────────────
            roleNameInput.addEventListener('input', function () {
                var val = this.value.trim();
                if (val.length > 0 && val.length <= 100) {
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                } else {
                    this.classList.remove('is-valid');
                    if (val.length > 0) {
                        this.classList.add('is-invalid');
                    } else {
                        this.classList.remove('is-invalid');
                    }
                }
            });

            // ── Load Role Data ───────────────────────────────────────
            function loadRole() {
                if (!roleId || roleId === 0) {
                    showError('Invalid role ID.');
                    return;
                }

                $.ajax({
                    url: '/Role/GetById/' + roleId,
                    type: 'GET',
                    beforeSend: function () {
                        loadingContainer.classList.remove('d-none');
                        form.classList.add('d-none');
                        errorContainer.classList.add('d-none');
                    },
                    success: function (response) {
                        loadingContainer.classList.add('d-none');
                        form.classList.remove('d-none');

                        var role = response;
                        // If response has $id or is wrapped
                        if (response && response.data) {
                            role = response.data;
                        }

                        document.getElementById('roleId').value = role.roleId || roleId;
                        roleNameInput.value = role.roleName || '';
                        roleNameInput.classList.add('is-valid');
                    },
                    error: function (xhr) {
                        loadingContainer.classList.add('d-none');
                        errorContainer.classList.remove('d-none');
                        var msg = 'Failed to load role data.';
                        try {
                            msg = JSON.parse(xhr.responseText) || msg;
                        } catch (e) {
                            msg = xhr.responseText || msg;
                        }
                        errorMessage.textContent = msg;

                        if (typeof window.showToast === 'function') {
                            window.showToast(msg, 'error');
                        }
                    },
                    complete: function () {
                        // handled
                    }
                });
            }

            function showError(msg) {
                loadingContainer.classList.add('d-none');
                errorContainer.classList.remove('d-none');
                errorMessage.textContent = msg;
            }

            // ── Form Submit ──────────────────────────────────────────
            form.addEventListener('submit', function (e) {
                e.preventDefault();

                var roleName = roleNameInput.value.trim();
                var isValid = true;

                if (!roleName || roleName.length === 0 || roleName.length > 100) {
                    roleNameInput.classList.add('is-invalid');
                    isValid = false;
                } else {
                    roleNameInput.classList.remove('is-invalid');
                    roleNameInput.classList.add('is-valid');
                }

                if (!isValid) return;

                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span>Saving...';

                var dto = {
                    roleId: roleId,
                    roleName: roleName
                };

                $.ajax({
                    url: '/Role/Edit',
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify(dto),
                    beforeSend: function () {
                        // button disabled
                    },
                    success: function (response) {
                        if (typeof window.showToast === 'function') {
                            window.showToast('Role updated successfully.', 'success');
                        } else {
                            alert('Role updated successfully.');
                        }
                        window.location.href = '/Role';
                    },
                    error: function (xhr) {
                        var msg = 'Failed to update role.';
                        try {
                            var resp = JSON.parse(xhr.responseText);
                            if (typeof resp === 'string') {
                                msg = resp;
                            } else if (resp && resp.title) {
                                msg = resp.title;
                            } else if (resp && resp.message) {
                                msg = resp.message;
                            } else if (resp && resp.roleName && resp.roleName.length > 0) {
                                msg = resp.roleName[0];
                            }
                        } catch (e) {
                            if (xhr.responseText) {
                                msg = xhr.responseText;
                            }
                        }

                        if (typeof window.showToast === 'function') {
                            window.showToast(msg, 'error');
                        } else {
                            alert(msg);
                        }

                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Save Changes';
                    },
                    complete: function () {
                        // handled
                    }
                });
            });

            // ── Initialize ──────────────────────────────────────────
            $(document).ready(function () {
                loadRole();
            });

        })();
    </script>
}
