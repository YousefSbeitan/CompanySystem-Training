@{
    ViewData["Title"] = "Delete Role";
}

<div class="container-fluid">
    <h1 class="h3 mb-3">Delete Role</h1>

    <!-- Loading Spinner -->
    <div id="loadingSpinner" class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2 text-muted">Loading role data...</p>
    </div>

    <!-- Error -->
    <div id="errorAlert" class="alert alert-danger" style="display:none;"></div>
    <div id="notFoundAlert" class="alert alert-warning" style="display:none;">Role not found.</div>

    <!-- Delete Confirmation Card -->
    <div class="card border-danger" id="deleteCard" style="display:none;">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Confirm Deletion</h5>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <strong>Warning:</strong> This action cannot be undone. Are you sure you want to delete this role?
            </div>

            <dl class="row">
                <dt class="col-sm-3">Role ID</dt>
                <dd class="col-sm-9" id="deleteRoleId"></dd>

                <dt class="col-sm-3">Role Name</dt>
                <dd class="col-sm-9" id="deleteRoleName"></dd>

                <dt class="col-sm-3">Created By</dt>
                <dd class="col-sm-9" id="deleteCreatedBy"></dd>

                <dt class="col-sm-3">Created Date</dt>
                <dd class="col-sm-9" id="deleteCreatedDate"></dd>
            </dl>

            <div class="d-flex gap-2">
                <button class="btn btn-danger" id="btnConfirmDelete">
                    <i class="bi bi-trash"></i> Delete
                </button>
                <a href="/Role" class="btn btn-secondary">Cancel</a>
            </div>
        </div>
    </div>

    <!-- Deleting Spinner -->
    <div id="deletingSpinner" class="text-center my-3" style="display:none;">
        <div class="spinner-border text-danger" role="status">
            <span class="visually-hidden">Deleting...</span>
        </div>
        <p class="mt-2 text-muted">Deleting role...</p>
    </div>

    <!-- Alert Container -->
    <div id="alertContainer" class="mt-3"></div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var permissions = window.currentUserPermissions || [];
            var userRole = window.currentUserRole || '';

            function hasPermission(perm) {
                if (permissions.length > 0) return permissions.includes(perm);
                return (userRole === 'Admin');
            }

            if (!hasPermission("Roles.Delete")) {
                $('#loadingSpinner').hide();
                $('#alertContainer').html(
                    '<div class="alert alert-danger">You do not have permission to delete roles.</div>'
                );
                return;
            }

            // Extract role ID from URL: /Role/Delete/{id}
            var pathParts = window.location.pathname.split('/');
            var roleId = parseInt(pathParts[pathParts.length - 1]);

            if (!roleId) {
                $('#loadingSpinner').hide();
                $('#errorAlert').text('Invalid role ID.').show();
                return;
            }

            // Load role data
            $.ajax({
                url: '/Role/GetById/' + roleId,
                type: 'GET',
                success: function (role) {
                    $('#loadingSpinner').hide();

                    if (!role) {
                        $('#notFoundAlert').show();
                        return;
                    }

                    $('#deleteRoleId').text(role.roleId || role.roleID || '');
                    $('#deleteRoleName').text(role.roleName || '');
                    $('#deleteCreatedBy').text(role.createdBy || '-');
                    $('#deleteCreatedDate').text(role.createdDate ? new Date(role.createdDate).toLocaleString() : '-');

                    $('#deleteCard').show();
                },
                error: function (xhr) {
                    $('#loadingSpinner').hide();
                    if (xhr.status === 404) {
                        $('#notFoundAlert').show();
                    } else {
                        var msg = xhr.responseText || 'Failed to load role.';
                        $('#errorAlert').text(msg).show();
                    }
                }
            });

            // Confirm delete
            $('#btnConfirmDelete').on('click', function () {
                var id = parseInt($('#deleteRoleId').text());

                if (!id) {
                    $('#alertContainer').html(
                        '<div class="alert alert-danger">Invalid role ID. Cannot delete.</div>'
                    );
                    return;
                }

                $('#btnConfirmDelete').prop('disabled', true);
                $('#deletingSpinner').show();
                $('#alertContainer').empty();

                $.ajax({
                    url: '/Role/Delete/' + id,
                    type: 'DELETE',
                    success: function (response) {
                        $('#deletingSpinner').hide();
                        var message = (response && response.message) ? response.message : 'Role deleted successfully!';
                        $('#alertContainer').html(
                            '<div class="alert alert-success">' + message + ' Redirecting...</div>'
                        );
                        setTimeout(function () {
                            window.location.href = '/Role';
                        }, 1000);
                    },
                    error: function (xhr) {
                        $('#deletingSpinner').hide();
                        $('#btnConfirmDelete').prop('disabled', false);

                        var msg = 'Failed to delete role.';
                        if (xhr.responseJSON) {
                            if (xhr.responseJSON.title) {
                                msg = xhr.responseJSON.title;
                            } else if (xhr.responseJSON.message) {
                                msg = xhr.responseJSON.message;
                            }
                        } else if (xhr.responseText) {
                            msg = xhr.responseText;
                        }

                        $('#alertContainer').html(
                            '<div class="alert alert-danger">' + msg + '</div>'
                        );
                    }
                });
            });
        });
    </script>
}
