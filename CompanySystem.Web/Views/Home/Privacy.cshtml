@{
    ViewData["Title"] = "Privacy";
}

<div class="container-fluid py-4">
    <h1 class="h3 mb-4">
        <i class="bi bi-shield-lock me-2"></i>Privacy Policy
    </h1>
    <div class="card card-dashboard">
        <div class="card-body">
            <p class="mb-3">
                CompanySystem is intended for internal company use. System data is managed by authorized
                administrators, managers and HR personnel based on assigned permissions.
            </p>
            <p class="mb-0">
                Access to employee information is restricted to users holding the appropriate permissions
                granted through the Roles &amp; Permissions system.
            </p>
        </div>
    </div>
</div>