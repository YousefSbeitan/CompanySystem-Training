@{
    ViewData["Title"] = "Home";
}

<div class="container-fluid py-5">
    <div class="row justify-content-center text-center">
        <div class="col-lg-8">
            <div class="mb-4">
                <span class="display-1 text-primary">
                    <i class="bi bi-building"></i>
                </span>
            </div>
            <h1 class="display-4 fw-bold mb-3">CompanySystem</h1>
            <p class="lead text-muted mb-4">
                Manage users, departments, roles, permissions and notes from one professional platform.
            </p>
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a href="/Auth/Login" class="btn btn-primary btn-lg">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Login
                </a>
                <a href="/Home/Dashboard" class="btn btn-outline-primary btn-lg">
                    <i class="bi bi-speedometer2 me-1"></i>Open Dashboard
                </a>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-5">
        <div class="col-md-4">
            <div class="card card-dashboard h-100">
                <div class="card-body text-center py-4">
                    <div class="mb-3 text-primary fs-1"><i class="bi bi-people-fill"></i></div>
                    <h5 class="fw-bold">Users</h5>
                    <p class="text-muted mb-0">Manage system users, employees and their assignments.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-dashboard h-100">
                <div class="card-body text-center py-4">
                    <div class="mb-3 text-success fs-1"><i class="bi bi-building-fill"></i></div>
                    <h5 class="fw-bold">Departments</h5>
                    <p class="text-muted mb-0">Organize the company structure by departments.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-dashboard h-100">
                <div class="card-body text-center py-4">
                    <div class="mb-3 text-warning fs-1"><i class="bi bi-shield-fill-check"></i></div>
                    <h5 class="fw-bold">Roles &amp; Permissions</h5>
                    <p class="text-muted mb-0">Control access with roles and fine-grained permissions.</p>
                </div>
            </div>
        </div>
    </div>
</div>
