@{
    ViewData["Title"] = "Dashboard";
}

<!-- Welcome Section -->
<div class="welcome-section" id="welcomeSection">
    <h1><i class="bi bi-speedometer2 me-2"></i>Dashboard</h1>
    <p class="welcome-subtitle" id="welcomeSubtitle">Loading your dashboard...</p>
</div>

<!-- User Profile Card -->
<div id="userProfileContainer">
    <div class="user-profile-card" id="userProfileCard">
        <div class="row align-items-center">
            <div class="col-auto">
                <div class="user-avatar-large" id="dashboardAvatar">
                    <i class="bi bi-person-fill"></i>
                </div>
            </div>
            <div class="col">
                <h3 id="dashboardUserName">Loading...</h3>
                <div class="user-meta">
                    <span class="badge bg-white text-dark" id="dashboardUserRole">Loading...</span>
                    <span class="badge bg-white text-dark" id="dashboardUserId">Loading...</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Dashboard Content Container - populated by JS based on role -->
<div id="dashboardContent"></div>

<script>
    // Basic bootstrap - dashboard.js handles the rest
</script>
