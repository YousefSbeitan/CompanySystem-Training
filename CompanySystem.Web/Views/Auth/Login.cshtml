@{
    ViewData["Title"] = "Login";
    ViewData["IsAuthPage"] = true;
}

<div class="asal-login-wrapper">
    <div class="asal-login-card">
        <!-- Brand -->
        <div class="asal-login-brand">
            <div class="asal-login-logo">
                <svg viewBox="0 0 24 24" width="40" height="40" fill="#ffffff">
                    <path d="M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z"/>
                </svg>
            </div>
            <h1 class="asal-login-company">ASAL Technologies</h1>
            <p class="asal-login-subtitle">Company Management System</p>
        </div>

        <!-- Welcome Text -->
        <div class="asal-login-welcome">
            <h2 class="welcome-title">Welcome Back</h2>
            <p class="welcome-desc">Sign in to your account to continue</p>
        </div>

        <!-- Error Alert -->
        <div id="loginError" class="alert alert-danger d-none" role="alert">
            <i class="bi bi-exclamation-circle me-1"></i>
            <span id="loginErrorText"></span>
        </div>

        <!-- Success Alert -->
        <div id="loginSuccess" class="alert alert-success d-none" role="alert">
            <i class="bi bi-check-circle me-1"></i>
            <span id="loginSuccessText"></span>
        </div>

        <!-- Form -->
        <form id="loginForm" class="asal-login-form" autocomplete="off" novalidate>
            <div class="form-group mb-3">
                <label for="username" class="form-label">Username</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <input type="text" class="form-control" id="username" name="username"
                           placeholder="Enter your username" required autofocus autocomplete="username" />
                    <div class="invalid-feedback">Please enter your username.</div>
                </div>
            </div>

            <div class="form-group mb-4">
                <label for="password" class="form-label">Password</label>
                <div class="input-group password-toggle-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input type="password" class="form-control" id="password" name="password"
                           placeholder="Enter your password" required autocomplete="current-password" />
                    <button type="button" class="btn btn-outline-secondary password-toggle-btn" id="passwordToggle" tabindex="-1" aria-label="Toggle password visibility" title="Show password">
                        <i class="bi bi-eye" id="passwordToggleIcon"></i>
                    </button>
                    <div class="invalid-feedback">Please enter your password.</div>
                </div>
            </div>

            <div class="d-grid mt-4">
                <button type="submit" class="btn btn-primary btn-lg asal-login-btn" id="loginBtn">
                    <span id="loginBtnText">Sign In</span>
                    <span id="loginBtnSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                </button>
            </div>

            <div class="text-center mt-3">
                <small class="text-muted">ASAL Technologies &mdash; Enterprise Management Platform</small>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).off('click', '#passwordToggle');

$(document).on('click', '#passwordToggle', function (e) {
    e.preventDefault();

    var passwordInput = $('#password');
    var icon = $('#passwordToggleIcon');

    var isPassword = passwordInput.attr('type') === 'password';

    passwordInput.attr('type', isPassword ? 'text' : 'password');

    icon.toggleClass('bi-eye bi-eye-slash');

    $(this)
        .attr('title', isPassword ? 'Hide password' : 'Show password')
        .attr('aria-label', isPassword ? 'Hide password' : 'Show password');
});

            // ── Form Submit ──────────────────────────────────────────
            $('#loginForm').on('submit', function (e) {
                e.preventDefault();

                // Clear previous errors
                $('#loginError').addClass('d-none');
                $('#loginSuccess').addClass('d-none');
                $('.is-invalid').removeClass('is-invalid');

                // Client-side validation
                var username = $('#username').val().trim();
                var password = $('#password').val();

                var hasError = false;
                if (!username) {
                    $('#username').addClass('is-invalid');
                    hasError = true;
                }
                if (!password) {
                    $('#password').addClass('is-invalid');
                    hasError = true;
                }
                if (hasError) return;

                // Show spinner
                $('#loginBtnText').text('Signing in...');
                $('#loginBtnSpinner').removeClass('d-none');
                $('#loginBtn').prop('disabled', true);

                $.ajax({
                    url: '/api/Auth/Login',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        username: username,
                        password: password
                    }),
                    success: function (response) {
                        // Store tokens for AJAX calls
                        if (window.auth) {
                            window.auth.saveTokens(response.accessToken, response.refreshToken);
                            window.auth.refreshUserGlobals();
                        } else {
                            localStorage.setItem('accessToken', response.accessToken);
                            localStorage.setItem('refreshToken', response.refreshToken);
                        }

                        // Show success then redirect
                        $('#loginSuccess').removeClass('d-none')
                            .find('#loginSuccessText').text('Login successful! Redirecting...');

                        setTimeout(function () {
                            window.location.href = '/Home/Dashboard';
                        }, 300);
                    },
                    error: function (xhr) {
                        var errorMsg = 'Login failed. Please check your credentials and try again.';

                        if (xhr.responseJSON) {
                            if (typeof xhr.responseJSON === 'string') {
                                errorMsg = xhr.responseJSON;
                            } else if (xhr.responseJSON.message) {
                                errorMsg = xhr.responseJSON.message;
                            } else if (xhr.responseJSON.title) {
                                errorMsg = xhr.responseJSON.title;
                            } else if (xhr.responseJSON.errors) {
                                var errors = xhr.responseJSON.errors;
                                var msgs = [];
                                $.each(errors, function (key, val) {
                                    $.each(val, function (i, msg) {
                                        msgs.push(msg);
                                    });
                                });
                                if (msgs.length) errorMsg = msgs.join('<br/>');
                            }
                        }

                        $('#loginError').removeClass('d-none')
                            .find('#loginErrorText').html(errorMsg);
                    },
                    complete: function () {
                        $('#loginBtnText').text('Sign In');
                        $('#loginBtnSpinner').addClass('d-none');
                        $('#loginBtn').prop('disabled', false);
                    }
                });
            });

            // Clear validation on input
            $('#username, #password').on('input', function () {
                $(this).removeClass('is-invalid');
            });

            // Auto-focus username field
            if ($('#username').length) {
                $('#username').focus();
            }
        });
    </script>
}

