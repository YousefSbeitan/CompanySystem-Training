@{
    ViewData["Title"] = "Access Denied";
    ViewData["IsAuthPage"] = true;
}

<div class="asal-login-wrapper">
    <div class="asal-login-card">
        <div class="text-center">
            <div class="mb-4">
                <span class="display-1 text-danger">
                    <i class="bi bi-shield-exclamation"></i>
                </span>
            </div>

            <h1 class="asal-login-company text-danger mb-3">
                <i class="bi bi-lock-fill me-2"></i>Access Denied
            </h1>

            <div class="alert alert-danger text-start mb-4">
                <i class="bi bi-exclamation-triangle me-2"></i>
                You do not have permission to access this resource.
            </div>

            <p class="text-muted mb-4">
                Please contact your system administrator if you believe this is an error.
            </p>

            <div class="d-grid gap-2">
                <a href="/Home/Dashboard" class="btn btn-primary asal-login-btn">
                    <i class="bi bi-speedometer2 me-1"></i> Return to Dashboard
                </a>
                <a href="/Auth/Login" class="btn btn-outline-secondary mt-2">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Login
                </a>
            </div>
        </div>
    </div>
</div>

