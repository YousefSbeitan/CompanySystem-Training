@{
    ViewData["Title"] = "Access Denied";
    Layout = null; // Standalone page
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Access Denied - CompanySystem</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap-utilities.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/theme.css" />
    <style>
        .access-denied-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            padding: 20px;
        }
        .access-denied-card {
            width: 100%;
            max-width: 480px;
            border: none;
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            overflow: hidden;
            text-align: center;
        }
        .access-denied-header {
            background: linear-gradient(135deg, #7f1d1d, #991b1b);
            color: white;
            padding: 40px 32px 24px;
        }
        .access-denied-header .icon-lock {
            font-size: 3.5rem;
            margin-bottom: 12px;
        }
        .access-denied-header h1 {
            font-size: 1.75rem;
            font-weight: 700;
            margin: 0;
        }
        .access-denied-body {
            padding: 32px;
            background: #fff;
        }
        .access-denied-body .error-code {
            font-size: 4rem;
            font-weight: 800;
            color: #7f1d1d;
            opacity: 0.15;
            line-height: 1;
            margin-bottom: 8px;
        }
        .access-denied-body .description {
            font-size: 1rem;
            color: #475569;
            margin-bottom: 24px;
        }
        .access-denied-body .action-links {
            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: wrap;
        }
        .btn-back {
            padding: 10px 24px;
            border-radius: 8px;
            font-weight: 600;
            background: #f1f5f9;
            color: #334155;
            border: 1px solid #e2e8f0;
            text-decoration: none;
            transition: background 0.2s;
        }
        .btn-back:hover {
            background: #e2e8f0;
            color: #1e293b;
        }
        .btn-login {
            padding: 10px 24px;
            border-radius: 8px;
            font-weight: 600;
            background: linear-gradient(135deg, #0f3460, #1a1a2e);
            color: white;
            border: none;
            text-decoration: none;
            transition: opacity 0.2s;
        }
        .btn-login:hover {
            opacity: 0.9;
            color: white;
        }
        .access-denied-footer {
            padding: 16px 32px;
            background: #f9fafb;
            border-top: 1px solid #eaecf0;
            font-size: 0.8rem;
            color: #667085;
        }
    </style>
</head>
<body class="access-denied-page">
    <div class="access-denied-card">
        <div class="access-denied-header">
            <div class="icon-lock"><i class="bi bi-shield-lock-fill"></i></div>
            <h1>Access Denied</h1>
        </div>
        <div class="access-denied-body">
            <div class="error-code">403</div>
            <p class="description">
                <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>
                You do not have permission to access this resource.
            </p>
            <p class="description">
                Please contact your administrator if you believe this is a mistake.
            </p>
            <div class="action-links">
                <a href="/" class="btn-back">
                    <i class="bi bi-house-door me-1"></i>Go to Home
                </a>
                <a href="/Auth/Login" class="btn-login">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
                </a>
            </div>
        </div>
        <div class="access-denied-footer">
            &copy; 2026 CompanySystem. All rights reserved.
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        // Clear stale tokens if any
        (function () {
            if (window.auth && window.auth.removeTokens) {
                window.auth.removeTokens();
            }
        })();
    </script>
</body>
</html>
