@{
    ViewData["Title"] = "Register";
    ViewData["IsAuthPage"] = true;
}

<div class="asal-login-wrapper">
    <div class="asal-login-card asal-register-card">
        <!-- Brand -->
        <div class="asal-login-brand">
            <div class="asal-login-logo">
                <svg viewBox="0 0 24 24" width="40" height="40" fill="#ffffff">
                    <path d="M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z"/>
                </svg>
            </div>
            <h1 class="asal-login-company">ASAL Technologies</h1>
            <p class="asal-login-subtitle">Register New User</p>
        </div>

        <div id="registerError" class="alert alert-danger d-none" role="alert">
            <i class="bi bi-exclamation-circle me-1"></i>
            <span id="registerErrorText"></span>
        </div>
        <div id="registerSuccess" class="alert alert-success d-none" role="alert">
            <i class="bi bi-check-circle me-1"></i>
            <span id="registerSuccessText"></span>
        </div>

        <form id="registerForm" class="asal-login-form" autocomplete="off" novalidate>
            <div class="form-group mb-3">
                <label for="username" class="form-label">Username <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <input type="text" class="form-control" id="username" name="username"
                           placeholder="Enter username" required maxlength="100" autofocus autocomplete="off" />
                    <div class="invalid-feedback">Username is required (max 100 characters).</div>
                </div>
            </div>

            <div class="form-group mb-3">
                <label for="password" class="form-label">Password <span class="text-danger">*</span></label>
                <div class="input-group password-toggle-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input type="password" class="form-control" id="password" name="password"
                           placeholder="Enter password (min 6 characters)" required maxlength="100" autocomplete="new-password" />
                    <button type="button" class="btn btn-outline-secondary password-toggle-btn" id="passwordToggle" tabindex="-1" aria-label="Toggle password visibility" title="Show password">
                        <i class="bi bi-eye" id="passwordToggleIcon"></i>
                    </button>
                    <div class="invalid-feedback">Password must be between 6 and 100 characters.</div>
                </div>
            </div>

            <div class="form-group mb-3">
                <label for="confirmPassword" class="form-label">Confirm Password <span class="text-danger">*</span></label>
                <div class="input-group password-toggle-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input type="password" class="form-control" id="confirmPassword" name="confirmPassword"
                           placeholder="Confirm password" required autocomplete="new-password" />
                    <button type="button" class="btn btn-outline-secondary password-toggle-btn" id="confirmPasswordToggle" tabindex="-1" aria-label="Toggle password visibility" title="Show password">
                        <i class="bi bi-eye" id="confirmPasswordToggleIcon"></i>
                    </button>
                    <div class="invalid-feedback">Passwords do not match.</div>
                </div>
            </div>

            <div class="form-group mb-3">
                <label for="phoneNumber" class="form-label">Phone Number <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                    <input type="tel" class="form-control" id="phoneNumber" name="phoneNumber"
                           placeholder="Enter phone number" required maxlength="20" autocomplete="tel" />
                    <div class="invalid-feedback">A valid phone number is required.</div>
                </div>
            </div>

            <div class="form-group mb-3">
                <label for="departmentId" class="form-label">Department</label>
                <select class="form-select" id="departmentId" name="departmentId">
                    <option value="">-- Select Department (Optional) --</option>
                </select>
            </div>

            <div class="d-grid mt-4">
                <button type="submit" class="btn btn-primary btn-lg asal-login-btn" id="registerBtn">
                    <span id="registerBtnText">Register User</span>
                    <span id="registerBtnSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // ── Password toggle is handled globally by site.js via .password-toggle-btn class
            // ── Check Authorization ──────────────────────────────────
            // The controller is already [Authorize(Roles = "Admin")]
            // This client-side check adds extra protection
            var user = window.currentUser || { id: '', username: '', role: '' };
            var isLoggedIn = !!user.username;

            if (!isLoggedIn || user.role !== 'Admin') {
                // Show access denied and disable form
                var msg = !isLoggedIn
                    ? 'You must be logged in as an Administrator to register new users.'
                    : 'Only Administrators can register new users.';
                $('#registerError').removeClass('d-none')
                    .find('#registerErrorText').text(msg);
                $('#registerBtn').prop('disabled', true);
                $('#registerForm').find('input, select').prop('disabled', true);
                return;
            }

            // ── Load Departments ──────────────────────────────────────
            function loadDepartments() {
                $.ajax({
                    url: '/Department/GetAll',
                    type: 'GET',
                    data: { pageNumber: 1, pageSize: 100 },
                    success: function (response) {
                        var departments = response.data || response.items || response || [];
                        var $select = $('#departmentId');
                        $select.find('option:not(:first)').remove();

                        $.each(departments, function (i, dept) {
                            var id = dept.departmentId || dept.id;
                            var name = dept.departmentName || dept.name;
                            $select.append(
                                $('<option></option>').val(id).text(name)
                            );
                        });
                    },
                    error: function () {
                        console.warn('Could not load departments.');
                    }
                });
            }

            loadDepartments();

            // ── Form Submit ──────────────────────────────────────────
            $('#registerForm').on('submit', function (e) {
                e.preventDefault();

                // Clear previous messages
                $('#registerError').addClass('d-none');
                $('#registerSuccess').addClass('d-none');
                $('.is-invalid').removeClass('is-invalid');

                // Client-side validation
                var username = $('#username').val().trim();
                var password = $('#password').val();
                var confirmPassword = $('#confirmPassword').val();
                var phoneNumber = $('#phoneNumber').val().trim();
                var departmentId = $('#departmentId').val();

                var isValid = true;

                if (!username || username.length > 100) {
                    $('#username').addClass('is-invalid');
                    isValid = false;
                } else {
                    $('#username').removeClass('is-invalid');
                }

                if (!password || password.length < 6 || password.length > 100) {
                    $('#password').addClass('is-invalid');
                    isValid = false;
                } else {
                    $('#password').removeClass('is-invalid');
                }

                if (password !== confirmPassword) {
                    $('#confirmPassword').addClass('is-invalid');
                    isValid = false;
                } else {
                    $('#confirmPassword').removeClass('is-invalid');
                }

                if (!phoneNumber) {
                    $('#phoneNumber').addClass('is-invalid');
                    isValid = false;
                } else {
                    $('#phoneNumber').removeClass('is-invalid');
                }

                if (!isValid) return;

                // Show spinner
                $('#registerBtnText').text('Registering...');
                $('#registerBtnSpinner').removeClass('d-none');
                $('#registerBtn').prop('disabled', true);

                var requestData = {
                    username: username,
                    password: password,
                    phoneNumber: phoneNumber
                };

                // Only include departmentId if a valid value was selected
                if (departmentId && departmentId !== '') {
                    requestData.departmentId = parseInt(departmentId);
                }

                $.ajax({
                    url: '/api/Auth/Register',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(requestData),
                    success: function (response) {
                        var msg = 'User registered successfully. Redirecting to user list...';
                        if (response && response.message) {
                            msg = response.message;
                        }
                        $('#registerSuccess').removeClass('d-none')
                            .find('#registerSuccessText').text(msg);
                        $('#registerForm')[0].reset();

                        setTimeout(function () {
                            window.location.href = '/User';
                        }, 2000);
                    },
                    error: function (xhr) {
                        var errorMsg = 'Registration failed. Please try again.';

                        if (xhr.responseJSON) {
                            if (typeof xhr.responseJSON === 'string') {
                                errorMsg = xhr.responseJSON;
                            } else if (xhr.responseJSON.message) {
                                errorMsg = xhr.responseJSON.message;
                            } else if (xhr.responseJSON.title) {
                                errorMsg = xhr.responseJSON.title;
                            } else if (xhr.responseJSON.errors) {
                                var errors = xhr.responseJSON.errors;
                                var msgs = [];
                                $.each(errors, function (key, val) {
                                    $.each(val, function (i, msg) {
                                        msgs.push(msg);
                                    });
                                });
                                if (msgs.length) errorMsg = msgs.join('<br/>');
                            }
                        }

                        $('#registerError').removeClass('d-none')
                            .find('#registerErrorText').html(errorMsg);
                    },
                    complete: function () {
                        $('#registerBtnText').text('Register User');
                        $('#registerBtnSpinner').addClass('d-none');
                        $('#registerBtn').prop('disabled', false);
                    }
                });
            });

            // ── Clear validation on input ────────────────────────────
            $('#username, #password, #confirmPassword, #phoneNumber').on('input', function () {
                $(this).removeClass('is-invalid');
            });
        });
    </script>
}

