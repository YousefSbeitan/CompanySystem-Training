@{
    var isAuthPage = ViewData["IsAuthPage"] as bool? ?? false;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ASAL Technologies</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CompanySystem.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body class="@(isAuthPage ? "auth-page" : "")">
    @if (!isAuthPage)
    {
        <!-- Sidebar Overlay (mobile) -->
        <div class="sidebar-overlay" id="sidebarOverlay" aria-hidden="true"></div>

        <!-- Sidebar -->
        <aside class="main-sidebar" id="sidebar" aria-label="Main navigation">
            <div class="sidebar-brand">
                <a href="/Home/Dashboard" aria-label="Dashboard home">
                    <span class="sidebar-brand-icon">
                        <svg viewBox="0 0 24 24" width="28" height="28" fill="#00a8e8" aria-hidden="true">
                            <path d="M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z"/>
                        </svg>
                    </span>
                    <span class="sidebar-brand-text">ASAL Technologies</span>
                </a>
            </div>
            <hr class="sidebar-divider">
            <ul class="sidebar-nav" id="sidebarNav" role="menubar">
                <!-- Dynamically populated by dashboard.js -->
            </ul>
        </aside>

        <!-- Content Wrapper -->
        <div class="content-wrapper" id="contentWrapper">
            <!-- Top Navbar -->
            <nav class="top-navbar" aria-label="Top navigation">
                <div class="top-navbar-left">
                    <button class="sidebar-toggle-btn" id="sidebarToggle" aria-label="Toggle sidebar" title="Toggle sidebar">
                        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                            <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/>
                        </svg>
                    </button>
                    <a href="/Home/Dashboard" class="top-navbar-brand">
                        <i class="bi bi-hexagon-fill me-1" style="color: var(--asal-accent);"></i>CompanySystem
                    </a>
                </div>
                <div class="top-navbar-right" id="topNavRight">
                    <!-- Populated by dashboard.js based on auth state -->
                </div>
            </nav>

            <!-- Main Content -->
            <main class="main-content" id="mainContent" role="main">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="main-footer">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-6">
                            &copy; <span id="footerYear">2026</span> ASAL Technologies. All rights reserved.
                        </div>
                        <div class="col-md-6 text-md-end">
                            <a href="/Home/Privacy">Privacy Policy</a>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    }
    else
    {
        <!-- Auth pages: standalone layout without sidebar/navbar -->
        <div class="auth-page-wrapper">
            @RenderBody()
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/auth.js" asp-append-version="true"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (!isAuthPage)
    {
    <script>
        // ── Layout Navigation Initialization ──────────────────────────
        $(document).ready(function () {
            function updateNav() {
                var user = window.currentUser || { id: '', username: '', role: '' };
                var isLoggedIn = !!user.username;
                var role = user.role || '';
                var isAdmin = role === 'Admin';
                var isManager = role === 'Manager';

                // Toggle body classes
                document.body.classList.toggle('has-admin', isAdmin);
                document.body.classList.toggle('is-manager', isManager);

                // For non-dashboard pages, ensure sidebar nav is updated
                if (typeof buildSidebarNav === 'function') {
                    buildSidebarNav(role);
                }

                // Re-build user menu in navbar
                if (typeof buildUserMenu === 'function') {
                    buildUserMenu(user, isLoggedIn);
                }
            }

            // Initial update
            updateNav();

            // Re-run when auth state changes
            $(window).on('authStateChanged', function () {
                updateNav();
                if (typeof initDashboard === 'function') {
                    initDashboard();
                }
            });
        });
    </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

